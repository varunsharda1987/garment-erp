  greigeStock                     greige_stock[]               @relation("GreigeStockProcurement")

  @@index([orderedForStyleId])
  @@index([orderedForOrderId])
  @@index([supplierId])
  @@index([procurementType])
  @@index([status])
  @@index([purchaseDate])
}

/// Fabric Stock - Current inventory by fabric/width with weighted average costing
/// Tracks origin (which style/order caused the purchase) for excess stock management
/// Now also tracks embroidered fabric stock with embroideryId
model fabric_stock {
  id                           String                       @id @default(uuid())
  fabricId                     String
  finishedWidth                Decimal                      @map("finishedWidth") @db.Decimal(10, 2)
  quantityAvailable            Decimal                      @db.Decimal(10, 2)
  quantityReserved             Decimal                      @default(0) @db.Decimal(10, 2)
  quantityConsumed             Decimal                      @default(0) @db.Decimal(10, 2)
  unit                         String                       @default("meters")
  procurementId                String?
  originStyleId                String?
  originOrderId                String?
  status                       StockStatus                  @default(AVAILABLE)
  stockType                    StockEntryType               @default(EXCESS)
  plannedCad                   Decimal?                     @db.Decimal(10, 4)
  actualCad                    Decimal?                     @db.Decimal(10, 4)
  varianceReason               String?
  weightedAvgCost              Decimal                      @db.Decimal(10, 2)
  purchaseCost                 Decimal                      @db.Decimal(10, 2)
  qualityGrade                 String                       @default("A")
  defectMeters                 Decimal?                     @db.Decimal(10, 2)
  defectValue                  Decimal?                     @db.Decimal(10, 2)
  warehouseLocation            String?
  warehouseId                  String?
  rackNumber                   String?
  rollNumbers                  String?
  receivedDate                 DateTime
  lastConsumedDate             DateTime?
  agingAlertSent               Boolean                      @default(false)
  agingDays                    Int                          @default(0)
  createdById                  String
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  embroideryId                 String?
  cutableWidth                 Decimal                      @map("cutableWidth") @db.Decimal(10, 2)
  patternPartId                String?                      @map("pattern_part_id")
  fabricFinishType             FabricFinishType?
  needsEmbroidery              Boolean                      @default(false)
  cutting_batches              cutting_batches[]
  cuttingBatchFabrics          cutting_batch_fabrics[]
  embroideryResultOf           embroidery_send_out?         @relation("EmbroideryResultStock")
  embroiderySourceFor          embroidery_send_out[]        @relation("EmbroiderySourceStock")
  fabric_physical_tests        fabric_physical_tests[]
  createdBy                    users                        @relation("fabric_stock_createdBy", fields: [createdById], references: [id])
  embroidery                   embroidery_master?           @relation(fields: [embroideryId], references: [id])
  fabricMaster                 fabric_master                @relation(fields: [fabricId], references: [id])
  patternPart                  pattern_part_master?         @relation("fabric_stock_pattern_part", fields: [patternPartId], references: [id])
  originOrder                  orders?                      @relation("StockOriginOrder", fields: [originOrderId], references: [id])
  originStyle                  styles?                      @relation("StockOriginStyle", fields: [originStyleId], references: [id])
  procurement                  fabric_procurement?          @relation(fields: [procurementId], references: [id])
  warehouse                    warehouses?                  @relation("FabricStockWarehouse", fields: [warehouseId], references: [id])
  stockAllocations             fabric_stock_allocation[]
  stockTransactions            fabric_stock_transaction[]
  cadProductionRecords         fabric_width_cad[]           @relation("cad_fabric_stock")
  job_work_orders              job_work_orders[]
  qualityInspections           quality_inspection[]
  fabricCostingItemsAsStockLot style_costing_fabric_items[] @relation("fabric_costing_stock_lot")
  challanItems                 challan_items[]
  external_process_send_outs   external_process_send_outs[] @relation("ExternalProcessFabricStock")
  jwoComponentsStock           job_work_order_components[]  @relation("JWOComponentFabricStock")

  @@unique([fabricId, procurementId, finishedWidth, cutableWidth, qualityGrade, embroideryId])
  @@index([fabricId, finishedWidth, cutableWidth, status])
  @@index([originStyleId])
  @@index([originOrderId])
  @@index([warehouseId])
  @@index([status])
  @@index([agingDays])
  @@index([qualityGrade])
  @@index([stockType])
  @@index([embroideryId])
  @@index([patternPartId])
  @@index([fabricFinishType])
  @@index([needsEmbroidery, status])
  // Performance: composite index for procurement queries
  @@index([procurementId, status])
}

/// Fabric Processing - Tracks greige→finished lifecycle with mill-specific shrinkage patterns
/// Records variance from expected shrinkage for mill performance tracking
model fabric_processing {
  id                       String              @id @default(uuid())
  procurementId            String?
  processorId              String
  processingType           String
  batchNumber              String?
  processSpecifications    String?
  greigeId                 String
  greigeQuantitySent       Decimal             @db.Decimal(10, 2)
  greigeWidth              Decimal?            @db.Decimal(10, 2)
  expectedFinishedWidthMin Decimal?            @db.Decimal(10, 2)
  expectedFinishedWidthMax Decimal?            @db.Decimal(10, 2)
  expectedShrinkagePercent Decimal?            @db.Decimal(5, 2)
  actualFinishedWidth      Decimal?            @db.Decimal(10, 2)
  actualQuantityReceived   Decimal?            @db.Decimal(10, 2)
  actualShrinkagePercent   Decimal?            @db.Decimal(5, 2)
  processingLossMeters     Decimal?            @db.Decimal(10, 2)
  widthVarianceInches      Decimal?            @db.Decimal(10, 2)
  shrinkageVariancePercent Decimal?            @db.Decimal(5, 2)
  millAvgShrinkage         Decimal?            @db.Decimal(5, 2)
  varianceFromMillAvg      Decimal?            @db.Decimal(5, 2)
  greigeCost               Decimal?            @db.Decimal(10, 2)
  processingCost           Decimal?            @db.Decimal(10, 2)
  totalFinishedCost        Decimal?            @db.Decimal(10, 2)
  costPerMeter             Decimal?            @db.Decimal(10, 2)
  finishedFabricId         String?
  sentDate                 DateTime?
  expectedReturnDate       DateTime?
  actualReturnDate         DateTime?
  processingStatus         String              @default("SENT")
  qualityNotes             String?
  rejectionReason          String?
  componentName            String? // Garment component (Top, Shirt) — for traceability
  colorName                String? // Dye/processing color — what color to apply
  createdById              String
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  createdBy                users               @relation("fabric_processing_createdBy", fields: [createdById], references: [id])
  finishedFabric           fabric_master?      @relation("ProcessingResult", fields: [finishedFabricId], references: [id])
  greigeMaster             greige_master       @relation("ProcessingGreige", fields: [greigeId], references: [id])
  processor                suppliers           @relation("ProcessingProcessor", fields: [processorId], references: [id])
  procurement              fabric_procurement? @relation(fields: [procurementId], references: [id])
  challans                 challans[]          @relation("ChallanProcessing")

  @@index([processorId, greigeId])
  @@index([processingStatus])
  @@index([sentDate])
  @@index([procurementId])
}

/// Fabric Stock Allocation - Reserves stock for orders with CAD variance tracking
/// Supports cross-style allocation (Style A excess used for Style B)
model fabric_stock_allocation {
  id                String            @id @default(uuid())
  stockId           String
  orderId           String
  styleId           String
  quantityAllocated Decimal           @db.Decimal(10, 2)
  unit              String            @default("meters")
  quantityConsumed  Decimal           @default(0) @db.Decimal(10, 2)
  quantityReturned  Decimal           @default(0) @db.Decimal(10, 2)
  plannedCad        Decimal           @db.Decimal(10, 4)
  actualCad         Decimal?          @db.Decimal(10, 4)
  cadVariance       Decimal?          @db.Decimal(10, 4)
  varianceReason    String?
  originalStyleId   String?
  allocationType    String            @default("SAME_STYLE")
  allocationStatus  String            @default("RESERVED")
  allocatedDate     DateTime          @default(now())
  consumptionDate   DateTime?
  createdById       String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productionCadId   String?           @map("production_cad_id")
  createdBy         users             @relation("fabric_stock_allocation_createdBy", fields: [createdById], references: [id])
