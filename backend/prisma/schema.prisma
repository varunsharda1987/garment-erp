  buttonCode    String   @unique
  buttonName    String
  supplierCode  String?
  buyerCode     String?
  size          String?
  holes         Int?
  color         String?
  material      String?
  shape         String?
  pricePerPiece Decimal? @db.Decimal(10, 2)
  pricePerGross Decimal? @db.Decimal(10, 2)
  image         String?
  supplierId    String?
  description   String?
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  suppliers                 suppliers?                  @relation(fields: [supplierId], references: [id])
  createdBy                 users?                      @relation(fields: [createdById], references: [id])
  materials                 materials[]
  style_material_bom        style_material_bom[] // Phase 2: Used in style BOM
  button_style_associations button_style_associations[]
  buttonSuppliers           button_suppliers[] // Multi-supplier support

  @@index([buttonCode])
  @@index([supplierId])
}

model thread_master {
  id            String               @id @default(uuid())
  threadCode    String               @unique
  threadName    String
  supplierCode  String?
  buyerCode     String?
  brand         String? // Brand name
  packagingType ThreadPackagingType? // CONE or TUBE
  piecesPerBox  Int? // 6 for Cone, 10 for Tube
