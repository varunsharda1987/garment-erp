model materials {
  id                              String                              @id
  code                            String                              @unique
  name                            String
  categoryId                      String
  description                     String?
  specifications                  String?
  unit                            Unit
  reorderLevel                    Int?
  image                           String?
  isActive                        Boolean                             @default(true)
  createdAt                       DateTime                            @default(now())
  updatedAt                       DateTime                            @updatedAt
  categoryData                    Json?
  materialType                    MaterialType                        @default(GENERIC)
  hsnCode                         String?
  gstRate                         Decimal?                            @db.Decimal(5, 2)
  // One materials row per master. @unique on these nullable FKs enforces it at the DB level (in
  // Postgres NULLs stay distinct, so the many null rows are fine) — this is what prevents the
  // FAB-RAW phantom / split-ledger class from ever recurring (bug-hunt: materials integrity).
  // labelId is intentionally NOT unique: labels legitimately have one materials row per size.
  greigeId                        String?                             @unique
  fabricId                        String?                             @unique
  laceId                          String?                             @unique
  buttonId                        String?                             @unique
  threadId                        String?                             @unique
  zipperId                        String?                             @unique
  elasticId                       String?                             @unique
  labelId                         String?
  packagingId                     String?                             @unique
  sizeVariantId                   String?                             @unique
  // Extended trim/accessory identity FKs — @unique (nullable, so many nulls are fine): one materials
  // row per master, closing the Phase-2 gap (was 9 of ~27). labelId above stays open (size variants).
  machinePartId                   String?                             @unique
  otherMaterialId                 String?                             @unique
  hookEyeId                       String?                             @unique
  snapButtonId                    String?                             @unique
  buckleId                        String?                             @unique
  beltId                          String?                             @unique
  velcroId                        String?                             @unique
  drawstringId                    String?                             @unique
  ribbonId                        String?                             @unique
  sequinId                        String?                             @unique
  beadId                          String?                             @unique
  motifId                         String?                             @unique
  interliningId                   String?                             @unique
  paddingId                       String?                             @unique
  otherFastenerId                 String?                             @unique
  otherTapeId                     String?                             @unique
  otherDecorativeId               String?                             @unique
  otherFunctionalId               String?                             @unique
  customer_accessory_preset_items customer_accessories_preset_items[] @relation("PresetMaterials")
  grn_items                       grn_items[]
  inventory_stock                 inventory_stock[]
  material_requirements           material_requirements[]
  material_requisition_items      material_requisition_items[]
  suppliers                       material_suppliers[]
  button_master                   button_master?                      @relation(fields: [buttonId], references: [id])
  material_categories             material_categories                 @relation(fields: [categoryId], references: [id])
  elastic_master                  elastic_master?                     @relation(fields: [elasticId], references: [id])
  fabric_master                   fabric_master?                      @relation(fields: [fabricId], references: [id])
  greige_master                   greige_master?                      @relation(fields: [greigeId], references: [id])
  label_master                    label_master?                       @relation(fields: [labelId], references: [id])
  lace_master                     lace_master?                        @relation(fields: [laceId], references: [id])
  machine_part_master             machine_part_master?                @relation(fields: [machinePartId], references: [id])
  other_material_master           other_material_master?              @relation(fields: [otherMaterialId], references: [id])
  packaging_master                packaging_master?                   @relation(fields: [packagingId], references: [id])
  label_size_variant              label_size_variants?                @relation(fields: [sizeVariantId], references: [id])
  thread_master                   thread_master?                      @relation(fields: [threadId], references: [id])
  zipper_master                   zipper_master?                      @relation(fields: [zipperId], references: [id])
  hook_eye_master                 hook_eye_master?                    @relation(fields: [hookEyeId], references: [id])
  snap_button_master              snap_button_master?                 @relation(fields: [snapButtonId], references: [id])
  buckle_master                   buckle_master?                      @relation(fields: [buckleId], references: [id])
  belt_master                     belt_master?                        @relation(fields: [beltId], references: [id])
  velcro_master                   velcro_master?                      @relation(fields: [velcroId], references: [id])
  drawstring_master               drawstring_master?                  @relation(fields: [drawstringId], references: [id])
  ribbon_master                   ribbon_master?                      @relation(fields: [ribbonId], references: [id])
  sequin_master                   sequin_master?                      @relation(fields: [sequinId], references: [id])
  bead_master                     bead_master?                        @relation(fields: [beadId], references: [id])
  motif_master                    motif_master?                       @relation(fields: [motifId], references: [id])
  interlining_master              interlining_master?                 @relation(fields: [interliningId], references: [id])
  padding_master                  padding_master?                     @relation(fields: [paddingId], references: [id])
  other_fastener_master           other_fastener_master?              @relation(fields: [otherFastenerId], references: [id])
  other_tape_master               other_tape_master?                  @relation(fields: [otherTapeId], references: [id])
  other_decorative_master         other_decorative_master?            @relation(fields: [otherDecorativeId], references: [id])
  other_functional_master         other_functional_master?            @relation(fields: [otherFunctionalId], references: [id])
  order_bom_items                 order_bom_items[]
  purchase_order_items            purchase_order_items[]
  stock_count_items               stock_count_items[]
  stock_levels                    stock_levels[]
  stock_movements                 stock_movements[]
