/// NEW: Relational fabric costing (replaces JSON fabricDetails)
/// Provides proper structure for fabric cost breakdown in style costing
model style_costing_fabric_items {
  id          String  @id @default(uuid())
  costingId   String
  fabricId    String
  fabricCADId String?

  // Fabric Details (snapshot at costing time)
  fabricName String
  colorName  String?
  width      Decimal @db.Decimal(10, 2)

  // CAD & Consumption
  cadMeters         Decimal @db.Decimal(10, 4)
  cadWastagePercent Decimal @default(5) @db.Decimal(5, 2)
  effectiveCad      Decimal @db.Decimal(10, 4) // CAD including wastage

  // Pricing
  costPerMeter Decimal @db.Decimal(10, 2)
  totalCost    Decimal @db.Decimal(10, 2) // effectiveCad * costPerMeter

  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  costing   style_costing     @relation(fields: [costingId], references: [id], onDelete: Cascade)
  fabric    fabric_master     @relation(fields: [fabricId], references: [id])
  fabricCAD fabric_width_cad? @relation(fields: [fabricCADId], references: [id])

  @@index([costingId])
  @@index([fabricId])
  @@index([fabricCADId])
}

model style_fabrics {
  id          String @id @default(uuid())
  componentId String

  // NEW: Proper fabric reference (replaces hardcoded fabricName, fabricType, etc.)
  fabricId    String? // Reference to fabric_master - Optional during migration
  fabricCADId String? // Optional: Specific CAD width override for this component

  // NEW: Fabric finish type and CAD grouping
  fabricFinishType FabricFinishType? // DYED, PRINTED, YARN_DYED, RAW
  cadGroupKey      String?           // For grouping fabrics during CAD planning (e.g., "Cambric-DYED-63")

  // DEPRECATED: Keep temporarily for migration, will be removed
  fabricName       String? // DEPRECATED: Use fabric.fabricName instead
  fabricType       String? // DEPRECATED: Use fabric.finishType instead
  fabricColor      String? // DEPRECATED: Use fabric.colorName instead
  fabricGSM        String? // DEPRECATED: Use fabric.actualGSM instead
  fabricWidth      Decimal? @db.Decimal(10, 2) // DEPRECATED: Use fabric.actualWidth instead
  cadAverageMeters Decimal? @db.Decimal(10, 3) // DEPRECATED: Use fabricCAD.cadMeters instead
  cadAverageYards  Decimal? @db.Decimal(10, 3) // DEPRECATED: Use fabricCAD.cadYards instead
  supplierName     String? // DEPRECATED: Use fabric.supplier.name instead
  greigeName       String? // DEPRECATED: Use fabric.greige.greigeName instead

  // Component-specific overrides (keep these)
  quantityNeeded Decimal? @db.Decimal(10, 4) // Quantity needed for this component
  unitPrice      Decimal? @db.Decimal(10, 2) // Override price if different from fabric master
  notes          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  style_components style_components  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  fabric           fabric_master?    @relation(fields: [fabricId], references: [id])
  fabricCAD        fabric_width_cad? @relation(fields: [fabricCADId], references: [id])

  @@index([componentId])
  @@index([fabricId])
  @@index([fabricCADId])
  @@index([cadGroupKey])
}

