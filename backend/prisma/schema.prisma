  delivery_note        delivery_notes? @relation(fields: [deliveryNoteId], references: [id])
  placeOfSupply        indian_states?  @relation("InvoicePlaceOfSupply", fields: [placeOfSupplyId], references: [id])
  payments             payments[]
  invoice_items        invoice_items[]
  credit_notes         credit_notes[]

  @@index([customerId])
  @@index([invoiceNumber])
  @@index([orderId])
  @@index([saleOrderId])
  @@index([deliveryNoteId])
  @@index([placeOfSupplyId])
}

