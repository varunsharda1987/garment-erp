/// External Process Send-Out - Tracks material sent to vendors for smocking, handwork, or piece-level embroidery
model external_process_send_outs {
  id          String                    @id @default(uuid())
  batchNumber String                    @unique
  processType ExternalProcessType
  sourceType  ExternalProcessSourceType

  // Context
  workOrderId String
  orderId     String?
  styleId     String?

  // Source references (only one populated per record based on sourceType)
  cuttingBatchId   String?
  fabricStockId    String?
  stitchingIssueId String?

  // Vendor
  supplierId String

  // Quantities (meters for fabric, pieces for garments)
  quantitySent     Decimal  @db.Decimal(10, 2)
  quantityReceived Decimal? @db.Decimal(10, 2)
  quantityDamaged  Decimal? @db.Decimal(10, 2)
  quantityGood     Decimal? @db.Decimal(10, 2)
  unit             String   @default("PCS") // PCS or MTR

  // Rates & Cost
  agreedRate Decimal  @db.Decimal(10, 2)
  actualCost Decimal? @db.Decimal(10, 2)

  // Dates
  sendDate           DateTime
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?

  // Phase 5b: JWO is the commercial document (required by service/controller);
  // purchaseOrderId is a dead legacy column kept for the cleanup phase
  jobWorkOrderId       String?
  purchaseOrderId      String?
  serviceRequirementId String?

  // Challan references (auto-created)
  outwardChallanId String?
  inwardChallanId  String?

  // Invoice
  invoiceNumber String?
  invoiceDate   DateTime?

  // Status
  status  ExternalProcessStatus @default(DRAFT)
  remarks String?

  // Embroidery-specific (only for EMBROIDERY_PIECE)
  embroideryId String?

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)

  // Relations
  workOrder          work_orders                      @relation("ExternalProcessWorkOrder", fields: [workOrderId], references: [id])
  order              orders?                          @relation("ExternalProcessOrder", fields: [orderId], references: [id])
  style              styles?                          @relation("ExternalProcessStyle", fields: [styleId], references: [id])
  cuttingBatch       cutting_batches?                 @relation("ExternalProcessCuttingBatch", fields: [cuttingBatchId], references: [id])
  fabricStock        fabric_stock?                    @relation("ExternalProcessFabricStock", fields: [fabricStockId], references: [id])
  stitchingIssue     stitching_issues?                @relation("ExternalProcessStitchingIssue", fields: [stitchingIssueId], references: [id])
  supplier           suppliers                        @relation("ExternalProcessSupplier", fields: [supplierId], references: [id])
  purchaseOrder      purchase_orders?                 @relation("ExternalProcessPO", fields: [purchaseOrderId], references: [id])
  jobWorkOrder       job_work_orders?                 @relation("ExternalProcessJWO", fields: [jobWorkOrderId], references: [id])
  serviceRequirement work_order_service_requirements? @relation("ExternalProcessServiceReq", fields: [serviceRequirementId], references: [id])
  embroidery         embroidery_master?               @relation("ExternalProcessEmbroidery", fields: [embroideryId], references: [id])
  createdBy          users                            @relation("ExternalProcessCreatedBy", fields: [createdById], references: [id])
  skuBreakdown       external_process_send_out_skus[]

  @@index([processType])
  @@index([workOrderId])
  @@index([supplierId])
  @@index([status])
  @@index([sendDate])
  @@index([cuttingBatchId])
  @@index([stitchingIssueId])
  @@index([purchaseOrderId])
  @@index([jobWorkOrderId])
  @@index([processType, status])
}

/// External Process Send-Out SKUs - Per-size/color piece breakdown
model external_process_send_out_skus {
  id          String  @id @default(uuid())
  sendOutId   String
  colorId     String?
  sizeId      String
  sentQty     Int
  receivedQty Int     @default(0)
  damagedQty  Int     @default(0)
  goodQty     Int     @default(0)

  sendOut external_process_send_outs @relation(fields: [sendOutId], references: [id], onDelete: Cascade)
  color   color_options?             @relation("ExternalProcessSkuColor", fields: [colorId], references: [id])
  size    size_options               @relation("ExternalProcessSkuSize", fields: [sizeId], references: [id])

  @@unique([sendOutId, colorId, sizeId])
  @@index([sendOutId])
}

/// Refresh tokens for JWT authentication (BUG-AUTH6)
/// Stores long-lived refresh tokens that can be exchanged for new access tokens
model refresh_tokens {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  expiresAt  DateTime
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  deviceInfo String? // Optional: browser/device identification
  ipAddress  String? // Optional: IP address at token creation
  createdAt  DateTime  @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

/// Permanent old→new id record from the materials-id unification (2026-08-03).
/// Written by scripts/migrations/unify-material-ids.ts; resolves historical references
/// (audit_logs, bookmarks) to migrated ids. NEVER drop — it is the provenance ledger.
model material_id_map {
  old_id        String    @id
  new_id        String
  material_type String?
  action        String
  migrated_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@map("material_id_map")
}

/// Mini marker files attached per style+purpose for CAD planning
/// Stores PDF/JPG/PNG files for COSTING, RAW_MATERIAL_CALCULATION, PRODUCTION purposes
model cad_purpose_files {
  id           String     @id @default(uuid())
  styleId      String     @map("style_id")
  purpose      CadPurpose @map("purpose")
  fileUrl      String     @map("file_url")
  fileName     String?    @map("file_name")
  fileSize     Int?       @map("file_size")
  sortOrder    Int        @default(0) @map("sort_order")
  uploadedById String?    @map("uploaded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")

  style      styles @relation(fields: [styleId], references: [id], onDelete: Cascade)
  uploadedBy users? @relation("cad_file_uploader", fields: [uploadedById], references: [id])

  @@index([styleId, purpose])
  @@map("cad_purpose_files")
}

/// Tally ERP Integration Settings - Singleton table
/// Stores configuration for pushing Sales vouchers to Tally over HTTP XML gateway.
/// CRITICAL: tallyCompanyName must be set before any push (both HOK and KF may be open on same Tally PC).
/// Rule: Single row only (id="singleton", enforced via upsert pattern in service).
model tally_settings {
  id String @id @default("singleton")

  // Connection settings
  tallyEnabled     Boolean @default(false) // Master switch - nothing pushes while off
  tallyHost        String  @default("127.0.0.1") // Tally PC IP on LAN
  tallyPort        Int     @default(9000) // Gateway port (TallyPrime default)
  tallyCompanyName String? // MUST match open company in Tally exactly

  // Sales voucher settings
  tallyPartyGroup       String @default("Sundry Debtors") // Parent group for customer ledgers
  tallyVoucherType      String @default("Sales") // Tally voucher type to post under
  tallySalesLedgerIntra String @default("") // Intra-state sales ledger (same state)
  tallySalesLedgerInter String @default("") // Inter-state sales ledger (different state)

  // GST output ledgers (5% rate - apparel <= Rs 2,500/pc)
  tallyCgstLedger String @default("") // Output CGST @2.5%
  tallySgstLedger String @default("") // Output SGST @2.5%
  tallyIgstLedger String @default("") // Output IGST @5%

  // GST output ledgers (18% rate - apparel > Rs 2,500/pc)
  tallyCgstLedger18 String @default("") // Output CGST @9%
  tallySgstLedger18 String @default("") // Output SGST @9%
  tallyIgstLedger18 String @default("") // Output IGST @18%

  // Other ledgers
  tallyRoundOffLedger String @default("") // Round-off ledger
  tallyFreightLedger  String @default("") // Freight income ledger (recovered freight)

  // Inventory settings
  tallyGodownName String @default("Main Location") // Stock godown name
  tallyStockUnit  String @default("Pcs") // Base unit for stock items

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tally_settings")
}

/// GST e-Invoice (IRN) Settings - Singleton table
/// Credentials for the NIC Invoice Registration Portal (IRP) API.
/// SANDBOX mode targets einv-apisandbox.nic.in; PRODUCTION needs real API-user credentials.
/// Secrets (einvClientId/einvClientSecret/einvApiPassword) are masked in GET responses.
/// Rule: Single row only (id="singleton", enforced via upsert pattern in service).
model einvoice_settings {
  id String @id @default("singleton")

  einvEnabled  Boolean @default(false) // Master switch - nothing generates while off
  einvMode     String  @default("SANDBOX") // SANDBOX | PRODUCTION
  einvProvider String  @default("NIC") // Adapter key (future: GSP/IRIS adapters)
  einvBaseUrl  String? // Override; null = mode default URL

  // NIC API credentials (created on e-invoice portal, per-GSP API user)
  einvClientId     String @default("")
  einvClientSecret String @default("")
  einvApiUsername  String @default("")
  einvApiPassword  String @default("")

  einvGstin        String  @default("") // Seller GSTIN (sent as gstin header)
  einvPublicKeyPem String? @db.Text // Production NIC RSA public key; null = bundled sandbox key

  einvAutoGenerateOnCreate Boolean @default(false) // Reserved for phase 2

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("einvoice_settings")
}

/// Issue Reports - Team members report app problems (with optional screenshot) for admin review
model issue_reports {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String
  description   String?  @db.Text
  screenshotUrl String?  @map("screenshot_url")
  pageUrl       String?  @map("page_url")
  status        String   @default("OPEN") // OPEN, IN_PROGRESS, FIXED, CLOSED
  adminNotes    String?  @map("admin_notes") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("issue_reports")
}

/// AI Knowledge Guides - step-by-step how-to guides authored from the real UI code.
/// Retrieved by keyword at chat time and injected into the AI system prompt so the
/// assistant answers with real menu/button names instead of generic guesses.
/// Written ONLY by backend/scripts/ingest-ai-guides.js (no HTTP CRUD surface).
model ai_knowledge_guides {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  keywords    String[] // English + Hinglish + Devanagari + common misspellings
  content     String   @db.Text // markdown guide body
  sourcesJson Json     @map("sources_json") // [{path, hash}] the guide was generated from
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("ai_knowledge_guides")
}
