model order_items {
  id                       String                       @id
  orderId                  String
  styleId                  String
  itemDescription          String?
  totalQuantity            Int
  unitPrice                Decimal                      @db.Decimal(10, 2)
  totalPrice               Decimal                      @db.Decimal(12, 2)
  deliveryDate             DateTime?
  status                   OrderStatus                  @default(PENDING)
  remarks                  String?
  inheritInspections       Boolean                      @default(true)
  inheritStyleSamples      Boolean                      @default(true)
  selectedCadId            String?
  delivery_note_items      delivery_note_items[]
  material_requirements    material_requirements[]
  orderBoms                order_bom[]
  order_inspections        order_inspections[]
  order_item_breakup       order_item_breakup[]
  order_item_costing       order_item_costing?
  orders                   orders                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  selectedCad              fabric_width_cad?            @relation("order_item_selected_cad", fields: [selectedCadId], references: [id])
  styles                   styles                       @relation(fields: [styleId], references: [id])
  labelOverrides           order_label_override[]
  order_samples            order_samples[]
  stageTransitionOverrides stage_transition_overrides[]
  orderItemCostings        style_costing[]              @relation("order_item_level_costing")
  work_orders              work_orders[]

  @@index([orderId])
  @@index([styleId])
  @@index([selectedCadId])
  // Performance: composite indexes for order item queries
  @@index([orderId, status])
  @@index([styleId, status])
}

model orders {
  id                               String                       @id
  orderNumber                      String                       @unique
  customerId                       String
  orderDate                        DateTime                     @default(now())
  expectedDeliveryDate             DateTime
  status                           OrderStatus                  @default(PENDING)
  priority                         Priority                     @default(MEDIUM)
  totalQuantity                    Int
  totalAmount                      Decimal                      @db.Decimal(12, 2)
  paymentTerms                     String?
  shippingAddress                  String?
  remarks                          String?
  // Make-to-order origin: the HOK B2B sale order this production order fulfils
  saleOrderId                      String?
  createdById                      String
  approvedById                     String?
  createdAt                        DateTime                     @default(now())
  updatedAt                        DateTime                     @updatedAt
  isActive                         Boolean                      @default(true)
  sale_orders                      sale_orders?                 @relation(fields: [saleOrderId], references: [id])
  asn_applications                 asn_applications[]
  delivery_notes                   delivery_notes[]
  embroiderySendOuts               embroidery_send_out[]        @relation("EmbroideryForOrder")
  procurementOrigins               fabric_procurement[]         @relation("ProcurementOriginOrder")
  stockOrigins                     fabric_stock[]               @relation("StockOriginOrder")
  stockAllocations                 fabric_stock_allocation[]    @relation("AllocationOrder")
  clonedCadEntries                 fabric_width_cad[]           @relation("cad_cloned_from_order")
  invoices                         invoices[]
  material_requirements            material_requirements[]
  orderBomsCopiedFrom              order_bom[]                  @relation("order_bom_copied_from")
  orderBoms                        order_bom[]
  order_items                      order_items[]
  users_orders_approvedByIdTousers users?                       @relation("orders_approvedByIdTousers", fields: [approvedById], references: [id])
  users_orders_createdByIdTousers  users                        @relation("orders_createdByIdTousers", fields: [createdById], references: [id])
  customers                        customers                    @relation(fields: [customerId], references: [id])
  orderCostings                    style_costing[]              @relation("order_level_costing")
  work_orders                      work_orders[]
  // Lace processing relations
  laceStockOrigins                 lace_stock[]                 @relation("lace_stock_origin_order")
  laceAllocations                  lace_stock_allocation[]      @relation("lace_allocation_order")
  laceOriginalOrderAllocs          lace_stock_allocation[]      @relation("lace_allocation_original_order")
  laceIssueNotes                   lace_issue_note[]            @relation("lace_issue_order")
  // Thread module relations
  orderThreadRequirements          order_thread_requirements[]
  // Challans linked to this order
  challans                         challans[]
  external_process_send_outs       external_process_send_outs[] @relation("ExternalProcessOrder")
  // Purchase orders linked to this order (for Manual PO traceability)
  purchaseOrders                   purchase_orders[]            @relation("PO_Order")

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([saleOrderId])
  // Performance: composite indexes for common query patterns
  @@index([customerId, status])
  @@index([status, createdAt])
}

model payments {
  id                 String        @id
  invoiceId          String
  paymentDate        DateTime      @default(now())
  amount             Decimal       @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  referenceNumber    String?
  remarks            String?
  receivedById       String
  createdAt          DateTime      @default(now())
  // Tally push fields
  tallyPushedAt      DateTime?
  tallyVoucherNumber String?
  tallyLastError     String?       @db.Text

  invoices invoices @relation(fields: [invoiceId], references: [id])
  users    users    @relation(fields: [receivedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
}

model production_plans {
  id           String      @id
  planNumber   String
  planDate     DateTime    @default(now())
  startDate    DateTime
  endDate      DateTime
  status       OrderStatus @default(PENDING)
  remarks      String?
  createdById  String
  approvedById String?
  createdAt    DateTime    @default(now())
  isActive     Boolean     @default(true)
  approvedBy   users?      @relation("production_plans_approvedBy", fields: [approvedById], references: [id])
  createdBy    users       @relation("production_plans_createdBy", fields: [createdById], references: [id])

  @@index([planNumber])
  @@index([createdById])
  @@index([approvedById])
}

model production_tracking {
  id                String          @id
  workOrderId       String
  productionStage   ProductionStage
  updateDate        DateTime        @default(now())
  quantityCompleted Int
  remarks           String?
  updatedById       String
  createdAt         DateTime        @default(now())
  users             users           @relation(fields: [updatedById], references: [id])
  work_orders       work_orders     @relation(fields: [workOrderId], references: [id])

  @@index([productionStage])
  @@index([updateDate])
  @@index([workOrderId])
}

model purchase_order_items {
  id                           String                         @id
  poId                         String
  materialId                   String? // Optional for service POs
  orderedQuantity              Decimal                        @db.Decimal(10, 3)
  receivedQuantity             Decimal                        @default(0) @db.Decimal(10, 3)
  unit                         Unit
  unitPrice                    Decimal                        @db.Decimal(10, 2)
  totalPrice                   Decimal                        @db.Decimal(12, 2)
  remarks                      String?
  componentName                String? // Garment component (Top, Shirt, Sleeve) — from BOM/MRP
  colorName                    String? // Dye/processing color (Burgundy, White) — from BOM/MRP
  fabricWidth                  Decimal?                       @db.Decimal(10, 2) // Expected cutable width (inches) — from CAD planning
  foldLengthCm                 Decimal?                       @db.Decimal(5, 2) // "L" - fold length in cm (for greige/fabric)
  // Service PO fields (used when materialId is null)
  serviceType                  ServiceType?
  serviceDescription           String?
  printingType                 String? // PrintingType: PIGMENT, PROCIAN, DISCHARGE, PIGMENT_DISCHARGE
  // GST fields
  hsnCode                      String?
  gstRate                      Decimal?                       @db.Decimal(5, 2)
  cgstRate                     Decimal?                       @db.Decimal(5, 2)
  cgstAmount                   Decimal?                       @db.Decimal(12, 2)
  sgstRate                     Decimal?                       @db.Decimal(5, 2)
  sgstAmount                   Decimal?                       @db.Decimal(12, 2)
  igstRate                     Decimal?                       @db.Decimal(5, 2)
  igstAmount                   Decimal?                       @db.Decimal(12, 2)
  taxAmount                    Decimal?                       @db.Decimal(12, 2)
  grn_items                    grn_items[]
  materials                    materials?                     @relation(fields: [materialId], references: [id])
  purchase_orders              purchase_orders                @relation(fields: [poId], references: [id], onDelete: Cascade)
  requirement_po_links         requirement_po_links[]
  service_requirement_po_links service_requirement_po_links[] @relation("ServiceRequirementPOLink")
  po_source_links              po_source_links[]
  threadRequirements           order_thread_requirements[]    @relation("thread_requirement_po_item")

  @@index([materialId])
  @@index([poId])
  @@index([serviceType])
}

model purchase_orders {
  id                                        String                            @id
  poNumber                                  String                            @unique
  supplierId                                String
  poDate                                    DateTime                          @default(now())
  expectedDeliveryDate                      DateTime
  status                                    PurchaseOrderStatus               @default(DRAFT)
  totalAmount                               Decimal?                          @db.Decimal(12, 2)
  subtotal                                  Decimal?                          @db.Decimal(12, 2)
  totalCgst                                 Decimal?                          @db.Decimal(12, 2)
  totalSgst                                 Decimal?                          @db.Decimal(12, 2)
  totalIgst                                 Decimal?                          @db.Decimal(12, 2)
  totalTax                                  Decimal?                          @db.Decimal(12, 2)
  isInterstate                              Boolean                           @default(false)
  isReverseCharge                           Boolean                           @default(false)
  paymentTerms                              String?
  remarks                                   String?
  createdById                               String
  approvedById                              String?
  createdAt                                 DateTime                          @default(now())
  userId                                    String?
  isActive                                  Boolean                           @default(true)
  // Cost Sheet PO Generation fields
  poCategory                                POCategory?                       @default(GENERAL)
  linkedGreigePOId                          String? // For Processing PO, link to Greige PO
  costSheetGenerationId                     String? // Link to generation record
  // Unified source tracking
  poSource                                  POSource?                         @default(MANUAL)
  mrpBatchId                                String? // Group MRP POs from same bulk operation
  serviceWorkOrderId                        String? // Link to work order for service POs
  // Optional traceability links for Manual POs
  styleId                                   String? // Link to style for cost tracking
  orderId                                   String? // Link to customer order
  cadId                                     String? // Link to CAD plan (for fabric POs)
  goods_receiving_notes                     goods_receiving_notes[]
  purchase_order_items                      purchase_order_items[]
  users_purchase_orders_approvedByIdTousers users?                            @relation("purchase_orders_approvedByIdTousers", fields: [approvedById], references: [id])
  users_purchase_orders_createdByIdTousers  users                             @relation("purchase_orders_createdByIdTousers", fields: [createdById], references: [id])
  suppliers                                 suppliers                         @relation(fields: [supplierId], references: [id])
  users_purchase_orders_userIdTousers       users?                            @relation("purchase_orders_userIdTousers", fields: [userId], references: [id])
  requirement_po_links                      requirement_po_links[]
  work_order_service_requirements           work_order_service_requirements[]
  linkedGreigePO                            purchase_orders?                  @relation("processing_to_greige", fields: [linkedGreigePOId], references: [id])
  processingPOs                             purchase_orders[]                 @relation("processing_to_greige")
  costSheetGeneration                       cost_sheet_po_generation?         @relation(fields: [costSheetGenerationId], references: [id])
  // Unified source links
  po_source_links                           po_source_links[]
  serviceWorkOrder                          work_orders?                      @relation("PO_ServiceWorkOrder", fields: [serviceWorkOrderId], references: [id])
  // Challans linked to this PO
  challans                                  challans[]
  debit_notes                               debit_notes[]
  // Job Work Order linked to this PO (1:1 for Process POs)
  jobWorkOrder                              job_work_orders?                  @relation("JobWorkPurchaseOrder")
  external_process_send_outs                external_process_send_outs[]      @relation("ExternalProcessPO")
  // Optional traceability relations
  style                                     styles?                           @relation("PO_Style", fields: [styleId], references: [id])
  order                                     orders?                           @relation("PO_Order", fields: [orderId], references: [id])
  cad                                       fabric_width_cad?                 @relation("PO_CAD", fields: [cadId], references: [id])
  // Delivery Location
  deliveryLocationType                      DeliveryLocationType?
  deliveryLocationId                        String? // Points to warehouses.id OR suppliers.id (processor)
  // Amendment tracking
  originalDeliveryLocationId                String? // Original location before any amendment
  deliveryLocationAmendedAt                 DateTime? // When location was amended
  deliveryLocationAmendedById               String? // Who amended it
  // Delivery location relations
  deliveryWarehouse                         warehouses?                       @relation("PO_DeliveryWarehouse", fields: [deliveryLocationId], references: [id])
  deliveryLocationAmendedBy                 users?                            @relation("PO_DeliveryAmendedBy", fields: [deliveryLocationAmendedById], references: [id])

  @@index([poNumber])
  @@index([supplierId])
  @@index([poCategory])
  @@index([linkedGreigePOId])
  @@index([costSheetGenerationId])
  @@index([poSource])
  @@index([mrpBatchId])
  @@index([serviceWorkOrderId])
  @@index([styleId])
  @@index([orderId])
  @@index([cadId])
  @@index([deliveryLocationId])
  // Performance: composite indexes for common query patterns
  @@index([supplierId, status])
  @@index([status, createdAt])
  @@index([expectedDeliveryDate])
}

model quality_defects {
  id                  String              @id
  inspectionId        String
  defectType          String
  defectDescription   String?
  severity            Severity
  quantity            Int
  image               String?
  actionTaken         String?
  quality_inspections quality_inspections @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model quality_inspections {
  id                                             String            @id
  inspectionNumber                               String            @unique
  inspectionType                                 InspectionType
  workOrderId                                    String?
  styleId                                        String
  inspectionDate                                 DateTime          @default(now())
  inspectedQuantity                              Int
  passedQuantity                                 Int
  failedQuantity                                 Int
  reworkQuantity                                 Int
  status                                         QualityStatus
  remarks                                        String?
  inspectedById                                  String
  approvedById                                   String?
  createdAt                                      DateTime          @default(now())
  userId                                         String?
  quality_defects                                quality_defects[]
  users_quality_inspections_approvedByIdTousers  users?            @relation("quality_inspections_approvedByIdTousers", fields: [approvedById], references: [id])
  users_quality_inspections_inspectedByIdTousers users             @relation("quality_inspections_inspectedByIdTousers", fields: [inspectedById], references: [id])
  styles                                         styles            @relation(fields: [styleId], references: [id])
  users_quality_inspections_userIdTousers        users?            @relation("quality_inspections_userIdTousers", fields: [userId], references: [id])
  work_orders                                    work_orders?      @relation(fields: [workOrderId], references: [id])

  @@index([inspectionNumber])
  @@index([workOrderId])
}

model quotation_items {
  id            String     @id
  quotationId   String
  styleId       String
  description   String?
  totalQuantity Int
  unitPrice     Decimal    @db.Decimal(10, 2)
  totalPrice    Decimal    @db.Decimal(12, 2)
  deliveryDays  Int?
  remarks       String?
  hsnCode       String?
  gstRate       Decimal?   @db.Decimal(5, 2)
  cgstRate      Decimal?   @db.Decimal(5, 2)
  cgstAmount    Decimal?   @db.Decimal(12, 2)
  sgstRate      Decimal?   @db.Decimal(5, 2)
  sgstAmount    Decimal?   @db.Decimal(12, 2)
  igstRate      Decimal?   @db.Decimal(5, 2)
  igstAmount    Decimal?   @db.Decimal(12, 2)
  taxAmount     Decimal?   @db.Decimal(12, 2)
  quotations    quotations @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  styles        styles     @relation(fields: [styleId], references: [id])

  @@index([quotationId])
  @@index([styleId])
}

model quotations {
  id                                   String            @id
  quotationNumber                      String            @unique
  customerId                           String
  quotationDate                        DateTime          @default(now())
  validUntil                           DateTime
  status                               QuotationStatus   @default(DRAFT)
  totalAmount                          Decimal?          @db.Decimal(12, 2)
  remarks                              String?
  termsAndConditions                   String?
  createdById                          String
  approvedById                         String?
  createdAt                            DateTime          @default(now())
  updatedAt                            DateTime          @updatedAt
  isActive                             Boolean           @default(true)
  estimatedCGST                        Decimal           @default(0) @db.Decimal(12, 2)
  estimatedIGST                        Decimal           @default(0) @db.Decimal(12, 2)
  estimatedSGST                        Decimal           @default(0) @db.Decimal(12, 2)
  placeOfSupplyId                      String?
  taxRate                              Decimal?          @db.Decimal(5, 2)
  totalWithTax                         Decimal?          @db.Decimal(12, 2)
  quotation_items                      quotation_items[]
  users_quotations_approvedByIdTousers users?            @relation("quotations_approvedByIdTousers", fields: [approvedById], references: [id])
  users_quotations_createdByIdTousers  users             @relation("quotations_createdByIdTousers", fields: [createdById], references: [id])
  customers                            customers         @relation(fields: [customerId], references: [id])
  placeOfSupply                        indian_states?    @relation("QuotationPlaceOfSupply", fields: [placeOfSupplyId], references: [id])

  @@index([customerId])
  @@index([quotationNumber])
  @@index([placeOfSupplyId])
}

model samples {
  id                       String                       @id
  sampleNumber             String
  customerId               String
  styleId                  String?
  sampleType               SampleType
  requestDate              DateTime                     @default(now())
  requiredDate             DateTime
  completionDate           DateTime?
  status                   SampleStatus                 @default(REQUESTED)
  customerFeedback         String?
  remarks                  String?
  createdById              String
  createdAt                DateTime                     @default(now())
  courierMode              String?
  feedbackDate             DateTime?
  linkedDispatchId         String?
  measurementComments      String?
  nextAction               String?
  productionLot            String?
  purpose                  String?
  receivedDate             DateTime?
  revisionRequired         Boolean                      @default(false)
  sentDate                 DateTime?
  sentTo                   String?
  trackingNumber           String?
  buyerNotifiedAt          DateTime?
  buyerNotifiedTo          String?
  version                  Int                          @default(1)
  isActive                 Boolean                      @default(true)
  colorways                sample_colorways[]
  measurements             sample_measurements[]
  sizeSets                 sample_size_sets[]
  users                    users                        @relation(fields: [createdById], references: [id])
  customers                customers                    @relation(fields: [customerId], references: [id])
  styles                   styles?                      @relation(fields: [styleId], references: [id])
  stageTransitionOverrides stage_transition_overrides[]

  @@index([customerId])
  @@index([sampleNumber])
}

model size_options {
  id                             String                           @id
  styleId                        String
  sizeName                       String
  sizeCode                       String
  sortOrder                      Int                              @default(0)
  isActive                       Boolean                          @default(true)
  asn_skus                       asn_skus[]
  cad_size_breakdowns            cad_size_breakdown[]
  carton_skus                    carton_skus[]
  cutting_batch_skus             cutting_batch_skus[]
  cutting_lay_skus               cutting_lay_skus[]
  delivery_note_items            delivery_note_items[]
  embroidery_cad_size_breakdowns embroidery_cad_size_breakdown[]
  finished_goods_stock           finished_goods_stock[]
  finishing_issue_skus           finishing_issue_skus[]
  finishing_output_skus          finishing_output_skus[]
  garment_physical_tests         garment_physical_tests[]
  order_item_breakup             order_item_breakup[]
  polybag_skus                   polybag_skus[]
  sample_colorways               sample_colorways[]
  sample_measurements            sample_measurements[]
  sample_size_sets               sample_size_sets[]
  styles                         styles                           @relation(fields: [styleId], references: [id], onDelete: Cascade)
  stage_receipt_skus             stage_receipt_skus[]
  stitching_issue_skus           stitching_issue_skus[]
  stitching_output_skus          stitching_output_skus[]
  style_variants                 style_variants[]
  transfer_slip_skus             transfer_slip_skus[]
  work_order_breakup             work_order_breakup[]
  stock_production_order_items   stock_production_order_items[]
  sale_order_items               sale_order_items[]
  external_process_send_out_skus external_process_send_out_skus[] @relation("ExternalProcessSkuSize")
  rejectDispositions             reject_dispositions[]            @relation("reject_disposition_size")

  @@index([styleId])
}

model style_variants {
  id                   String                 @id @default(cuid())
  styleId              String
  sku                  String                 @unique
  sizeId               String?
  colorId              String?
  sizeName             String?
  colorName            String?
  barcode              String?
  accountingSKU        String?
  isActive             Boolean                @default(true)
  sortOrder            Int                    @default(0)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  delivery_note_items  delivery_note_items[]
  finished_goods_stock finished_goods_stock[]
  order_item_breakup   order_item_breakup[]
  color                color_options?         @relation(fields: [colorId], references: [id])
  size                 size_options?          @relation(fields: [sizeId], references: [id])
  style                styles                 @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

model style_accessories {
  id               String           @id @default(uuid())
  componentId      String
  accessoryName    String
  accessoryType    String
  quantityPerPiece Decimal          @db.Decimal(10, 3)
  unit             String
  supplierName     String?
  unitPrice        Decimal?         @db.Decimal(10, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  style_components style_components @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

model style_categories {
  id          String   @id
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  styles      styles[]
}

model product_category_master {
  id                String                        @id @default(uuid())
  code              String
  name              String
  description       String?
  parentId          String?                       @map("parent_id")
  level             Int                           @default(1)
  sortOrder         Int                           @default(0) @map("sort_order")
  isActive          Boolean                       @default(true) @map("is_active")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")
  maxComponents     Int                           @default(1) @map("max_components")
  minComponents     Int                           @default(1) @map("min_components")
  codePrefix        String?                       @map("code_prefix")
  brandCategories   brand_categories[]
  defaultComponents category_component_defaults[]
  parent            product_category_master?      @relation("ProductCategoryHierarchy", fields: [parentId], references: [id])
  children          product_category_master[]     @relation("ProductCategoryHierarchy")
  styles            styles[]

  @@index([parentId])
  @@index([level])
  @@index([isActive])
  @@map("product_category_master")
}

model style_components {
  id                         String                       @id @default(uuid())
  styleId                    String
  componentName              String
  componentType              String
  sortOrder                  Int                          @default(0)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  componentMasterId          String?                      @map("component_master_id")
  carton_packings            carton_packings[]
  cutting_batches            cutting_batches[]
  finishing_daily_outputs    finishing_daily_outputs[]
  finishing_issue_components finishing_issue_components[]
  polybag_entries            polybag_entries[]
  stitching_daily_outputs    stitching_daily_outputs[]
  stitching_issue_components stitching_issue_components[]
  style_accessories          style_accessories[]
  componentMaster            component_masters?           @relation(fields: [componentMasterId], references: [id])
  styles                     styles                       @relation(fields: [styleId], references: [id], onDelete: Cascade)
  style_fabrics              style_fabrics[]
  transfer_slips             transfer_slips[]

  @@index([styleId])
  @@index([componentMasterId])
}

model style_costing {
  id                                      String                          @id
  styleId                                 String
  totalMaterialCost                       Decimal                         @default(0) @db.Decimal(15, 2)
  printingCost                            Decimal                         @default(0) @db.Decimal(10, 2)
  totalProcessingCost                     Decimal                         @default(0) @db.Decimal(15, 2)
  cuttingCost                             Decimal                         @default(0) @db.Decimal(10, 2)
  stitchingCost                           Decimal                         @default(0) @db.Decimal(10, 2)
  finishingCost                           Decimal                         @default(0) @db.Decimal(10, 2)
  checkingCost                            Decimal                         @default(0) @db.Decimal(10, 2)
  totalProductionCost                     Decimal                         @default(0) @db.Decimal(15, 2)
  profitMargin                            Decimal                         @default(0) @db.Decimal(5, 2)
  totalCostPerPiece                       Decimal                         @default(0) @db.Decimal(15, 2)
  sellingPricePerPiece                    Decimal                         @default(0) @db.Decimal(15, 2)
  notes                                   String?
  createdAt                               DateTime                        @default(now())
  updatedAt                               DateTime                        @updatedAt
  approvedAt                              DateTime?
  approvedById                            String?
  isApproved                              Boolean                         @default(false)
  accessoriesCost                         Decimal                         @default(0) @db.Decimal(10, 2)
  adminOverhead                           Decimal                         @default(0) @db.Decimal(10, 2)
  cadFabricConsumption                    Decimal?                        @db.Decimal(10, 4)
  cadUnit                                 String?
  cadWastagePercent                       Decimal?                        @db.Decimal(5, 2)
  cmtCost                                 Decimal                         @default(0) @db.Decimal(10, 2)
  createdById                             String
  dyeingCost                              Decimal                         @default(0) @db.Decimal(10, 2)
  embroideryWork                          Decimal                         @default(0) @db.Decimal(10, 2)
  fabricCost                              Decimal                         @default(0) @db.Decimal(10, 2)
  factoryOverhead                         Decimal                         @default(0) @db.Decimal(10, 2)
  handWork                                Decimal                         @default(0) @db.Decimal(10, 2)
  smockingCost                            Decimal                         @default(0) @db.Decimal(10, 2)
  otherMaterialCost                       Decimal                         @default(0) @db.Decimal(10, 2)
  otherOverheads                          Decimal                         @default(0) @db.Decimal(10, 2)
  otherProcessingCost                     Decimal                         @default(0) @db.Decimal(10, 2)
  packagingCost                           Decimal                         @default(0) @db.Decimal(10, 2)
  profitAmount                            Decimal                         @default(0) @db.Decimal(10, 2)
  transportCost                           Decimal                         @default(0) @db.Decimal(10, 2)
  trimsCost                               Decimal                         @default(0) @db.Decimal(10, 2)
  washingCost                             Decimal                         @default(0) @db.Decimal(10, 2)
  numberOfComponents                      Int?
  category                                String?
  subCategory                             String?
  fabricDetails                           Json?
  fabricTotal                             Decimal?                        @default(0) @db.Decimal(10, 2)
  trimsDetails                            Json?
  trimsTotal                              Decimal?                        @default(0) @db.Decimal(10, 2)
  buttonAttachmentCost                    Decimal?                        @default(0) @db.Decimal(10, 2)
  handworkCmtCost                         Decimal?                        @default(0) @db.Decimal(10, 2)
  cmtTotal                                Decimal?                        @default(0) @db.Decimal(10, 2)
  embroideryDetails                       Json?
  embroideryTotal                         Decimal?                        @default(0) @db.Decimal(10, 2)
  accessoriesDetails                      Json?
  accessoriesTotal                        Decimal?                        @default(0) @db.Decimal(10, 2)
  // Lace costing total (calculated from style_costing_lace_items)
