/// Job Work Order - Print/Dye job work tracking
/// Phase 2+: Will absorb Service PO fields (terms, GST, approval)
model job_work_orders {
  id                     String        @id @default(uuid())
  jobWorkNumber          String
  processType            String // Legacy - will migrate to processTypeId
  processTypeId          String? // FK to process_type_master (Phase 1+)
  labDipId               String? // Optional - Process PO can be style-based without lab dip
  styleId                String? // Optional for garment/multi-material JWOs
  fabricId               String? // Optional - multi-material JWOs use components table
  processorId            String
  fabricStockLotId       String? // Optional - use components for multi-material
  fabricType             String? // Optional for garment JWOs
  /// Shade asked of the processor on a STOCK job (no style, so no requirement/BOM/lab dip to
  /// carry the colour). Read as the last rungs of the fabric-identity colour ladder, so an
  /// order-linked job is unaffected. Without it every stock dye run of one greige would dedup
  /// into a single finished-fabric master — Black and Navy sharing one record and one cost.
  colorMasterId          String?
  /// Free-text shade for a colour not in the master (e.g. a buyer's own name for it).
  colorName              String?
  reprocessReason        String?
  qtySentMeters          Decimal       @db.Decimal(10, 2)
  /// Greige (loom-state) width of the material issued, e.g. 63". Distinct from
  /// sentWidthInches, which holds the FINISHED width asked of the processor.
  greigeWidthInches      Decimal?      @db.Decimal(10, 2)
  /// ASKED FINISHED width (selvedge-to-selvedge target the processor must deliver,
  /// set on the stenter) = CAD cutable width + selvedge deduction. Historically named
  /// "sent", but no flow ever stored the greige width here.
  sentWidthInches        Decimal?      @db.Decimal(10, 2) // Optional for garments
  uom                    String        @default("MTR") // MTR, PCS, KG
  sentDate               DateTime?
  challanNumber          String?
  vehicleNumber          String?
  expectedReturnDate     DateTime?
  expectedShrinkage      Decimal?      @db.Decimal(5, 2)
  /// Billing qty = FINISHED goods the processor returns (fabric out), not the greige issued.
  /// NULL = legacy/piece-based job → billing falls back to qtySentMeters.
  qtyBillable            Decimal?      @db.Decimal(10, 2)
  agreedRatePerMeter     Decimal       @db.Decimal(10, 2)
  isRateTbd              Boolean       @default(false) // True when rate=0 is intentional TBD
  qtyReceivedMeters      Decimal?      @db.Decimal(10, 2)
  receivedWidthInches    Decimal?      @db.Decimal(10, 2)
  receivedDate           DateTime?
  receivedChallan        String?
  invoiceNumber          String?
  actualShrinkage        Decimal?      @db.Decimal(5, 2)
  widthVariance          Decimal?      @db.Decimal(10, 2)
  qualityGrade           String?
  colorMatchStatus       String?
  defectMeters           Decimal?      @db.Decimal(10, 2)
  defectType             String?
  actualRate             Decimal?      @db.Decimal(10, 2)
  status                 JobWorkStatus @default(READY_TO_SEND)
  remarks                String?
  workOrderId            String?
  createdById            String
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  isActive               Boolean       @default(true)
  finishedFabricId       String? // FK to auto-created finished fabric_master
  thanCount              Int? // Number of thans (folded bundles) received
  foldLengthCm           Decimal?      @db.Decimal(5, 2) // "L" - actual fold length in cm
  calculatedActualMeters Decimal?      @db.Decimal(10, 2) // thanCount × foldLengthCm / 100
  outwardChallanId       String? // FK to new challans table (outbound)
  inwardChallanId        String? // FK to new challans table (inbound)
  purchaseOrderId        String?       @unique @db.VarChar(50) // FK to purchase_orders (Process PO link)
  greigeStockLotId       String?       @db.VarChar(50) // FK to greige_stock (source greige)
  grnId                  String?       @db.VarChar(50) // FK to GRN if received via GRN path

  // ===== Phase 2: Commercial fields (absorbed from Service PO) =====
  // GST/Tax fields
  subtotal        Decimal? @db.Decimal(12, 2) // qty × rate (before tax)
  gstRate         Decimal? @db.Decimal(5, 2) // From process_type_master, can override
  cgstAmount      Decimal? @db.Decimal(12, 2) // CGST (intrastate)
  sgstAmount      Decimal? @db.Decimal(12, 2) // SGST (intrastate)
  igstAmount      Decimal? @db.Decimal(12, 2) // IGST (interstate)
  totalTaxAmount  Decimal? @db.Decimal(12, 2) // Total tax
  totalAmount     Decimal? @db.Decimal(12, 2) // subtotal + totalTaxAmount
  isInterstate    Boolean  @default(false) // Derived from processor state vs company state
  isReverseCharge Boolean  @default(false) // For unregistered processors

  // Payment terms
  paymentTerms   String? // e.g., "Net 30", "Against Delivery"
  paymentDueDays Int? // Days from invoice date

  // Approval workflow
  approvedById String? // Who approved
  approvedAt   DateTime? // When approved

  // Statutory fields (Section 143 compliance)
  statutoryDueDate DateTime? // 1 year from sentDate, IMMUTABLE after ISSUED
  ewayBillNumber   String? // E-way bill number for transport
  ewayBillDate     DateTime? // E-way bill generation date
  declaredValue    Decimal?  @db.Decimal(12, 2) // Value for e-way bill/insurance

  // Tolerance and loss tracking (spec requirement)
  // Loss split is measured against the CONTRACTED EXPECTED OUTPUT (qtyBillable), not greige sent (2026-08-18)
  tolerancePercent Decimal? @db.Decimal(5, 2) // Resolved chain persisted at receive: jwo ?? process_type_master ?? 0 (strict)
  qtyNormalLoss    Decimal? @db.Decimal(10, 2) // Commercially accepted loss: expected shrinkage incurred + tolerance consumed
  qtyAbnormalLoss  Decimal? @db.Decimal(10, 2) // Shortfall beyond (expected output − tolerance allowance) → debit-note gate at close

  // ===== KAAJ_BUTTON specific fields (only used when processType = KAAJ_BUTTON) =====
  buttonholeCount       Int? // Number of buttonholes to make
  buttonCount           Int? // Number of buttons to attach
  buttonholeRatePerUnit Decimal? @db.Decimal(10, 2) // Rate per buttonhole (default from settings)
  buttonRatePerUnit     Decimal? @db.Decimal(10, 2) // Rate per button attachment (default from settings)
  // ===== End KAAJ_BUTTON fields =====

  // ===== End Phase 2 fields =====

  // Phase 7: Universal lifecycle status (coexists with legacy 'status' during migration)
  jwoStatus JobWorkOrderStatus?

  createdBy               users                             @relation(fields: [createdById], references: [id])
  fabric                  fabric_master?                    @relation(fields: [fabricId], references: [id])
  finishedFabric          fabric_master?                    @relation("JobWorkFinishedFabric", fields: [finishedFabricId], references: [id])
  fabricStockLot          fabric_stock?                     @relation(fields: [fabricStockLotId], references: [id])
  labDip                  lab_dips?                         @relation(fields: [labDipId], references: [id])
  processor               suppliers                         @relation("JobWorkProcessor", fields: [processorId], references: [id])
  style                   styles?                           @relation(fields: [styleId], references: [id])
  colorMaster             color_master?                     @relation(fields: [colorMasterId], references: [id])
  workOrder               work_orders?                      @relation("JobWorkForWorkOrder", fields: [workOrderId], references: [id])
  outwardChallan          challans?                         @relation("JobWorkOutwardChallan", fields: [outwardChallanId], references: [id])
  inwardChallan           challans?                         @relation("JobWorkInwardChallan", fields: [inwardChallanId], references: [id])
  purchaseOrder           purchase_orders?                  @relation("JobWorkPurchaseOrder", fields: [purchaseOrderId], references: [id])
  greigeStockLot          greige_stock?                     @relation(fields: [greigeStockLotId], references: [id])
  grn                     goods_receiving_notes?            @relation(fields: [grnId], references: [id])
  processTypeMaster       process_type_master?              @relation(fields: [processTypeId], references: [id])
  approvedBy              users?                            @relation("JobWorkApprover", fields: [approvedById], references: [id])
  challanItems            challan_items[]                   @relation("ChallanItemJobWorkOrder")
  components              job_work_order_components[]
  // Phase 4a reverse relations (JWO IS the PO endgame)
  debitNotes              debit_notes[]                     @relation("DebitNoteJobWorkOrder")
  headerChallans          challans[]                        @relation("ChallanHeaderJobWorkOrder")
  receivingGRNs           goods_receiving_notes[]           @relation("GRNJobWorkOrder")
  requirementLinks        requirement_jwo_links[]
  serviceRequirements     work_order_service_requirements[]
  // Phase 5a: WOSR allocation links (mirror of requirementLinks for service requirements)
  serviceRequirementLinks service_requirement_jwo_links[]
  // Phase 5b: embroidery design (EMBROIDERY JWOs); piece send-out batches; frozen batch-stage hook
  embroideryId            String?
  embroidery              embroidery_master?                @relation("JwoEmbroidery", fields: [embroideryId], references: [id])
  externalProcessSendOuts external_process_send_outs[]      @relation("ExternalProcessJWO")
  processingStage         processing_stage?                 @relation("ProcessingStageJWO")
  greigeIssueDetails      greige_issue_details[]            @relation("GreigeIssueDetailsJWO")

  @@index([embroideryId])
  @@index([labDipId])
  @@index([processTypeId])
  @@index([styleId])
  @@index([colorMasterId])
  @@index([processorId])
  @@index([status])
  @@index([processType])
  @@index([workOrderId])
  @@index([outwardChallanId])
  @@index([inwardChallanId])
  @@index([finishedFabricId])
  @@index([purchaseOrderId])
  @@index([greigeStockLotId])
  @@index([grnId])
  @@index([approvedById])
  @@index([statutoryDueDate])
  @@index([jwoStatus])
}

/// Job Work Order Component - Multi-material support for JWOs
/// Phase 4: Enables one JWO to handle multiple materials (e.g., fabric + lining)
model job_work_order_components {
  id             String @id @default(uuid())
  jobWorkOrderId String

  // Material identification (one of these should be set)
  materialType String // GREIGE, FABRIC, LACE, THREAD, TRIM
  greigeId     String? // FK to greige_master
  fabricId     String? // FK to fabric_master
  laceId       String? // FK to lace_master
  materialId   Int? // FK to material_master (for trims)

  // Stock lot reference (for deduction)
  greigeStockId String? // FK to greige_stock
  fabricStockId String? // FK to fabric_stock
  laceStockId   String? // FK to lace_stock
  threadStockId String? // FK to thread_stock (Phase 7)

  // Quantities (precision increased to 14,3 per spec)
  qtySent         Decimal  @db.Decimal(14, 3)
  qtyReceived     Decimal? @db.Decimal(14, 3)
  qtyNormalLoss   Decimal? @db.Decimal(10, 3) // Loss within tolerance
  qtyAbnormalLoss Decimal? @db.Decimal(10, 3) // Loss beyond tolerance
  unit            String   @default("MTR")

  // Rate and value
  rate          Decimal? @db.Decimal(10, 2) // Current rate
  rateAtIssue   Decimal? @db.Decimal(12, 4) // D4: Immutable rate snapshot at issue
  declaredValue Decimal? @db.Decimal(12, 2) // For e-way bill

  // R3: Chargeable and returnable flags
  isChargeable Boolean @default(true) // Adds to processing cost
  isReturnable Boolean @default(true) // Expected back (consumables may not be)
  hsnCode      String? // HSN code for GST invoicing

  // Component details
  description   String?
  colorName     String?
  componentName String? // e.g., "Main Fabric", "Lining"

  // Sequence for ordering
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  jobWorkOrder job_work_orders @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)
  greige       greige_master?  @relation(fields: [greigeId], references: [id])
  fabric       fabric_master?  @relation("JWOComponentFabric", fields: [fabricId], references: [id])
  lace         lace_master?    @relation(fields: [laceId], references: [id])
  greigeStock  greige_stock?   @relation("JWOComponentGreigeStock", fields: [greigeStockId], references: [id])
  fabricStock  fabric_stock?   @relation("JWOComponentFabricStock", fields: [fabricStockId], references: [id])
  laceStock    lace_stock?     @relation("JWOComponentLaceStock", fields: [laceStockId], references: [id])
  threadStock  thread_stock?   @relation("JWOComponentThreadStock", fields: [threadStockId], references: [id])
  challanItems challan_items[] @relation("ChallanItemJWOComponent")

  @@index([jobWorkOrderId])
  @@index([materialType])
  @@index([threadStockId])
}

/// ASN Application - Advance Shipping Notice
