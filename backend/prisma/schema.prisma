  product_category          product_category_master?    @relation(fields: [productCategoryId], references: [id])
  users                     users                       @relation(fields: [createdById], references: [id])
  work_orders               work_orders[]

  // Phase 1B: Procurement & Stock Management Relations
  procurementOrigins  fabric_procurement[]      @relation("ProcurementOriginStyle")
  stockOrigins        fabric_stock[]            @relation("StockOriginStyle")
  allocationStyles    fabric_stock_allocation[] @relation("AllocationStyle")
