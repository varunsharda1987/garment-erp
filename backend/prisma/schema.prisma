/// Junction table: Greige to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which greige fabrics
model greige_suppliers {
  id          String   @id @default(uuid())
  greigeId    String
  supplierId  String
  isPreferred Boolean  @default(false) // Primary/preferred supplier
  isActive    Boolean  @default(true) // Currently available
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  greige   greige_master @relation(fields: [greigeId], references: [id], onDelete: Cascade)
  supplier suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([greigeId, supplierId])
  @@index([greigeId])
  @@index([supplierId])
}

/// Junction table: Fabric to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which finished fabrics
model fabric_suppliers {
  id          String   @id @default(uuid())
  fabricId    String
  supplierId  String
  isPreferred Boolean  @default(false) // Primary/preferred supplier
  isActive    Boolean  @default(true) // Currently available
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fabric   fabric_master @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  supplier suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([fabricId, supplierId])
  @@index([fabricId])
  @@index([supplierId])
}

/// Junction table: Material to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which materials
model material_suppliers {
  id          String   @id @default(uuid())
  materialId  String
  supplierId  String
  isPreferred Boolean  @default(false) // Primary/preferred supplier
  isActive    Boolean  @default(true) // Currently available
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  material materials @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier suppliers @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([materialId, supplierId])
  @@index([materialId])
  @@index([supplierId])
}

