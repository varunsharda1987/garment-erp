/// P6.2.3 Reject Dispositions - Track what happens to defective pieces
/// Provides audit trail for rejects that currently vanish between production stages
model reject_dispositions {
  id          String          @id @default(uuid())
  workOrderId String
  stage       ProductionStage
  defectDate  DateTime        @default(now())

  // Source reference (one of these will be set based on stage)
  cuttingBatchId   String?
  stitchingDailyId String?
  finishingDailyId String?
  qcInspectionId   String?

  // SKU tracking
  colorId  String?
  sizeId   String?
  quantity Int // Number of defective pieces

  // Defect details
  defectType        String
  defectDescription String?
  severity          Severity @default(MAJOR)

  // Disposition tracking
  disposition      DefectDisposition @default(PENDING)
  dispositionDate  DateTime?
  dispositionNotes String?
  resolvedById     String? // User who resolved/disposed

  // Recovery tracking (for rework)
  recoveredQuantity Int     @default(0)
  reworkNotes       String?

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workOrder    work_orders      @relation("reject_disposition_wo", fields: [workOrderId], references: [id])
  cuttingBatch cutting_batches? @relation("reject_disposition_cutting", fields: [cuttingBatchId], references: [id])
  color        color_options?   @relation("reject_disposition_color", fields: [colorId], references: [id])
  size         size_options?    @relation("reject_disposition_size", fields: [sizeId], references: [id])
  createdBy    users            @relation("reject_disposition_creator", fields: [createdById], references: [id])
  resolvedBy   users?           @relation("reject_disposition_resolver", fields: [resolvedById], references: [id])

  @@index([workOrderId])
  @@index([stage])
  @@index([disposition])
  @@index([defectDate])
  @@index([cuttingBatchId])
}

