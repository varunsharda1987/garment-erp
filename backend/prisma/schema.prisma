/// Export Template Master - Configurable export templates for CSV/Excel/PDF
model export_templates {
  id           String   @id @default(uuid())
  moduleName   String // e.g., "customers", "suppliers", "materials", "styles", etc.
  templateName String
  description  String?
  columnConfig Json // Array of {fieldName, displayName, format, width, etc.}
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users users @relation(fields: [createdById], references: [id])

  @@unique([moduleName, templateName])
  @@index([moduleName])
  @@index([createdById])
}

// ============================================
// FABRIC & GREIGE MANAGEMENT SYSTEM
// Phase 1A: Core Foundation Tables
// ============================================

/// Greige Master - Raw, unfinished fabric specifications
/// This represents fabric straight from the loom before any processing
model greige_master {
  id                String  @id @default(uuid())
  greigeCode        String  @unique
  greigeName        String
  genericFabricName String? // e.g., "Cambric", "Poplin", "Cotton Twill" - stored separately for accurate retrieval

  // Technical Specifications
  yarnCount    String? // e.g., "40x40"
  construction String? // e.g., "133x72" (ends x picks per inch)
  composition  String // e.g., "100% Cotton", "65% Polyester 35% Cotton"
  weaveType    String? // "Plain", "Twill", "Satin", "Dobby"

  // Width Management (in inches)
  greigeWidth         Decimal  @db.Decimal(10, 2)
  defaultCutableWidth Decimal? @db.Decimal(10, 2) // Default finished/cutable width for CAD planning

  // Expected Shrinkage After Processing
  expectedFinishedWidthMin Decimal? @db.Decimal(10, 2)
  expectedFinishedWidthMax Decimal? @db.Decimal(10, 2)
  averageShrinkagePercent  Decimal? @default(8) @db.Decimal(5, 2) // Default 8%

  // Procurement (Multi-supplier support via greige_suppliers junction table)
  gsmRange String? // e.g., "120-130"

  // Pricing & Procurement Fields
  costPerMeter Decimal? @db.Decimal(10, 2) // Default cost per meter
  moq          Int? // Minimum Order Quantity
  leadTimeDays Int? // Lead time in days
  supplierId   String? // Default supplier

  // Additional Info
  description String? @db.Text
  notes       String? @db.Text

  // Status
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy       users           @relation("greige_master_createdBy", fields: [createdById], references: [id])
  defaultSupplier suppliers?      @relation("greige_default_supplier", fields: [supplierId], references: [id])
  finishedFabrics fabric_master[] // One greige → Many finished fabrics
  materials       materials[] // Greige can be referenced in materials table

  // Phase 1B: Procurement & Stock Management Relations
  fabricProcurements fabric_procurement[] @relation("ProcurementGreige")
  fabricProcessing   fabric_processing[]  @relation("ProcessingGreige")

  // Multi-supplier support
  suppliers        greige_suppliers[]
  processing_batch processing_batch[]

  // CAD Planning relations
  fabricWidthCads fabric_width_cad[] @relation("fabric_width_cad_greige") // CAD entries using this greige
  styleFabrics    style_fabrics[]    @relation("style_fabrics_selectedGreige") // Style fabrics with this greige selected

  @@index([supplierId])
  @@index([greigeCode])
  @@index([isActive])
}

/// Fabric Master - Finished, ready-to-use fabrics
/// This represents fabric AFTER dyeing, printing, or other finishing processes
model fabric_master {
  id         String @id @default(uuid())
  fabricCode String @unique
  fabricName String // e.g., "Navy Blue Solid Poplin"

  // Greige Relationship (optional for CAD planning placeholders)
  greigeId String?

  // Generic Fabric Name (simplified fabric type)
  genericFabricName String? // "Cambric", "Poplin", "Twill", etc.

  // Finishing Details
  colorName     String?
  colorCode     String? // Pantone code or custom code
  colorMasterId String? // Reference to global color master
  finishType    String? // "Dyed", "Printed", "Yarn Dyed"
  printDesign   String? // For printed fabrics

  // Actual Specifications (Post-finishing)
  actualWidth          Decimal? @db.Decimal(10, 2) // Finished width in inches (optional for CAD placeholders)
  cutableWidth         Decimal? @db.Decimal(10, 2) // Usable width (default: actualWidth - 2")
  finishedConstruction String? // Post-processing construction (e.g., "96x92")
  actualGSM            Int?

  // Value Addition
  valueAddition     String? // e.g., "Embroidery", "Special Wash", "Printing"
  valueAdditionCost Decimal? @db.Decimal(10, 2) // Additional cost for value addition

  // Pricing & Procurement Fields
  costPerMeter Decimal? @db.Decimal(10, 2) // Cost per meter
  moq          Int? // Minimum Order Quantity
  leadTimeDays Int? // Lead time in days
  supplierId   String? // Default supplier

  // Additional Info
  description String? @db.Text
  notes       String? @db.Text
  imageUrl    String?

  // Style Import Fields
  styleReference String? // Original style code this fabric was created for
  isGeneric      Boolean @default(false) // true if can be used across styles
  componentType  String? // BODY, SLEEVE, COLLAR, etc.

  // Status
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  greige          greige_master?     @relation(fields: [greigeId], references: [id])
  createdBy       users              @relation("fabric_master_createdBy", fields: [createdById], references: [id])
  defaultSupplier suppliers?         @relation("fabric_default_supplier", fields: [supplierId], references: [id])
  color_master    color_master?      @relation(fields: [colorMasterId], references: [id])
  widthCADs       fabric_width_cad[] // One fabric → Many width options
  materials       materials[] // Fabric can be referenced in materials table

  // Phase 1B: Procurement & Stock Management Relations
  fabricProcurements  fabric_procurement[] @relation("ProcurementFabric")
  processedFromGreige fabric_procurement[] @relation("ProcessedFabric")

  // Multi-supplier support
  suppliers          fabric_suppliers[]
  processingResults  fabric_processing[]  @relation("ProcessingResult")
  fabricStock        fabric_stock[]
  qualityInspections quality_inspection[]

  // Style Fabric References
  styleFabrics       style_fabrics[] // Fabrics used in style components
  costingFabricItems style_costing_fabric_items[] // Fabric items in cost sheets
  processing_batch   processing_batch[]

  // Manufacturing module relations
  lab_dips        lab_dips[] // Lab dips for this fabric
  job_work_orders job_work_orders[] // Job work orders for this fabric

  // Testing Module Relations
  fabric_physical_tests fabric_physical_tests[]

  @@index([fabricCode])
  @@index([greigeId])
  @@index([supplierId])
  @@index([isActive])
  @@index([styleReference])
}

/// Fabric Width CAD - CAD consumption by width
/// Centralized repository for CAD averages per fabric width
/// This eliminates duplicate CAD entry for same fabric in different styles
model fabric_width_cad {
  id       String @id @default(uuid())
  fabricId String

  // Width Specifications (RENAMED: availableWidth → cutableWidth)
  cutableWidth Decimal @map("cutableWidth") @db.Decimal(10, 2) // Usable cutting width in inches
  widthUnit    String  @default("inches")

  // CAD Consumption (per single garment piece)
  cadMeters         Decimal? @db.Decimal(10, 4)
  cadYards          Decimal? @db.Decimal(10, 4)
  cadWastagePercent Decimal  @default(5) @db.Decimal(5, 2)
  markerEfficiency  Decimal? @db.Decimal(5, 2)

  // NEW: Layer margin for cutting (auto-calculated based on CAD meters)
  layerMarginMeters Decimal? @db.Decimal(10, 4) // e.g., 0.05 = 5cm

  // NEW: Greige reference (for pricing lookup during CAD planning)
  greigeId String?
  greige   greige_master? @relation("fabric_width_cad_greige", fields: [greigeId], references: [id], onDelete: SetNull)

  // NEW: Processing price for this width (varies by order quantity)
  processingPricePerMeter Decimal? @db.Decimal(10, 2)

  // NEW: Component name for SEPARATE averaging mode
  componentName String?

  // Actual Production Data
  actualCad          Decimal? @db.Decimal(10, 4) // Last production actual consumption
  cadVariancePercent Decimal? @db.Decimal(5, 2) // (actualCad - cadMeters) / cadMeters * 100

  // Procurement Planning
  isPreferred          Boolean  @default(false) // Recommended width
  supplierAvailability String? // "Readily Available", "2-week lead", "Custom order"
  priceDifferential    Decimal? @db.Decimal(10, 2) // Extra cost vs base width

  // Marker Details
  markerPlanFile     String? // Path to marker file
  markerLengthMeters Decimal? @db.Decimal(10, 2)
  piecesPerMarker    Int?

  // Notes
  notes String? @db.Text

  // Metadata
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  fabric             fabric_master                @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  createdBy          users?                       @relation("fabric_width_cad_createdBy", fields: [createdById], references: [id])
  bom_items          bom_items[] // BOM items can reference specific CAD widths
  styleFabrics       style_fabrics[] // Style fabrics can reference specific CAD widths
  costingFabricItems style_costing_fabric_items[] // Costing items can reference specific CAD widths

  @@unique([fabricId, cutableWidth, componentName]) // One CAD entry per fabric-width-component
  @@index([fabricId])
  @@index([isPreferred])
  @@index([greigeId])
}

// ============================================
// FABRIC PROCUREMENT & STOCK MANAGEMENT
// Phase 1B: Inventory & Lifecycle Tracking
// ============================================

/// Fabric Procurement - Tracks fabric purchases (greige or finished)
/// Records WHY fabric was purchased (order-specific vs stock) for MOQ excess tracking
model fabric_procurement {
  id String @id @default(uuid())

  // Procurement Type & Details
  procurementType     String // "GREIGE", "FINISHED"
  purchaseOrderNumber String?
  supplierId          String

  // Fabric Reference - One of these will be populated based on type
  greigeId String? // If bought as greige
  fabricId String? // If bought as finished

  // Quantity Details
  quantityPurchased Decimal @db.Decimal(10, 2)
  unit              String  @default("meters")
  width             Decimal @db.Decimal(10, 2)

  // Financial
  ratePerUnit Decimal @db.Decimal(10, 2)
  totalCost   Decimal @db.Decimal(10, 2)

  // Origin Context - WHY was this purchased?
  orderedForStyleId String? // Style that triggered purchase
  orderedForOrderId String? // Specific order reference
  isStockPurchase   Boolean @default(false) // Stock vs order-specific

  // Processing Details (if greige)
  processingRequired Boolean  @default(false)
  processingType     String? // "DYEING", "PRINTING", "BOTH"
  processingColor    String?
  processingDesign   String? // For prints
  processedFabricId  String? // Links to fabric_master after processing
  processingMoq      Decimal? @db.Decimal(10, 2) // MOQ that caused excess

  // Status & Dates
  status           String    @default("ORDERED") // "ORDERED", "IN_TRANSIT", "RECEIVED", "PROCESSING", "COMPLETED"
  purchaseDate     DateTime  @default(now())
  expectedDelivery DateTime?
  receivedDate     DateTime?

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  greigeMaster    greige_master? @relation("ProcurementGreige", fields: [greigeId], references: [id])
  fabricMaster    fabric_master? @relation("ProcurementFabric", fields: [fabricId], references: [id])
  processedFabric fabric_master? @relation("ProcessedFabric", fields: [processedFabricId], references: [id])
  supplier        suppliers      @relation(fields: [supplierId], references: [id])
  styleOrigin     styles?        @relation("ProcurementOriginStyle", fields: [orderedForStyleId], references: [id])
  orderOrigin     orders?        @relation("ProcurementOriginOrder", fields: [orderedForOrderId], references: [id])
  createdBy       users          @relation("fabric_procurement_createdBy", fields: [createdById], references: [id])

  fabricStock        fabric_stock[] // Creates stock entries after receiving
  fabricProcessing   fabric_processing[] // If greige, links to processing records
  qualityInspections quality_inspection[] // Quality checks
  fabric_physical_tests fabric_physical_tests[] // Fabric testing

  @@index([orderedForStyleId])
  @@index([orderedForOrderId])
  @@index([supplierId])
  @@index([procurementType])
  @@index([status])
  @@index([purchaseDate])
}

/// Fabric Stock - Current inventory by fabric/width with weighted average costing
/// Tracks origin (which style/order caused the purchase) for excess stock management
/// Now also tracks embroidered fabric stock with embroideryId
model fabric_stock {
  id String @id @default(uuid())

  // Fabric Identity (RENAMED: width → finishedWidth, ADDED: cutableWidth)
  fabricId      String
  finishedWidth Decimal            @map("finishedWidth") @db.Decimal(10, 2) // Width after processing
  cutableWidth  Decimal            @map("cutableWidth") @db.Decimal(10, 2) // Usable cutting width
  embroideryId  String? // If set, this is embroidered fabric stock
  embroidery    embroidery_master? @relation(fields: [embroideryId], references: [id])

  // Quantity Tracking
  quantityAvailable Decimal @db.Decimal(10, 2)
  quantityReserved  Decimal @default(0) @db.Decimal(10, 2) // Reserved for orders
  quantityConsumed  Decimal @default(0) @db.Decimal(10, 2) // Used from this stock
  unit              String  @default("meters")

  // Origin Tracking - WHY does this stock exist?
  procurementId String // Links to fabric_procurement
  originStyleId String? // Style that originally caused purchase
  originOrderId String? // Order that originally caused purchase

  // Stock Status
  status    String @default("AVAILABLE") // "AVAILABLE", "RESERVED", "DEPLETED", "QUARANTINED"
  stockType String @default("EXCESS")
  // "EXCESS_MOQ", "PLANNED_STOCK", "RETURNED", "VARIANCE_UNUSED"

  // CAD Variance Tracking (if created due to consumption differences)
  plannedCad     Decimal? @db.Decimal(10, 4) // Original CAD used for planning
  actualCad      Decimal? @db.Decimal(10, 4) // Actual consumption
  varianceReason String?
  // "CAD_IMPROVED", "PATTERN_CHANGED", "WASTAGE_REDUCED", "CUTTING_EFFICIENCY"

  // Weighted Average Costing (Business Rule)
  weightedAvgCost Decimal @db.Decimal(10, 2) // Cost per meter
  purchaseCost    Decimal @db.Decimal(10, 2) // Original purchase cost

  // Quality Management
  qualityGrade String   @default("A") // "A", "B", "DEFECT"
  defectMeters Decimal? @db.Decimal(10, 2)
  defectValue  Decimal? @db.Decimal(10, 2) // Business Rule: = greige cost

  // Warehouse Location
  warehouseLocation String?
  rackNumber        String?
  rollNumbers       String? @db.Text // Comma-separated roll IDs

  // Aging Management (Business Rule: Alert at 6+ months)
  receivedDate     DateTime
  lastConsumedDate DateTime?
  agingAlertSent   Boolean   @default(false)
  agingDays        Int       @default(0) // Auto-calculated

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  fabricMaster fabric_master      @relation(fields: [fabricId], references: [id])
  procurement  fabric_procurement @relation(fields: [procurementId], references: [id])
  originStyle  styles?            @relation("StockOriginStyle", fields: [originStyleId], references: [id])
  originOrder  orders?            @relation("StockOriginOrder", fields: [originOrderId], references: [id])
  createdBy    users              @relation("fabric_stock_createdBy", fields: [createdById], references: [id])

  stockAllocations   fabric_stock_allocation[] // Allocations to orders
  stockTransactions  fabric_stock_transaction[] // Complete audit trail
  qualityInspections quality_inspection[] // Quality checks

  // Embroidery Send-Out Relations
  embroiderySourceFor embroidery_send_out[] @relation("EmbroiderySourceStock") // This stock was sent for embroidery
  embroideryResultOf  embroidery_send_out?  @relation("EmbroideryResultStock") // This stock was created from embroidery

  // Manufacturing module relations
  cutting_batches cutting_batches[] // Cutting batches using this stock
  job_work_orders job_work_orders[] // Job work orders using this stock lot

  // Testing Module Relations
  fabric_physical_tests fabric_physical_tests[] // Fabric testing

  @@unique([fabricId, procurementId, finishedWidth, cutableWidth, qualityGrade, embroideryId])
  @@index([fabricId, finishedWidth, cutableWidth, status])
  @@index([originStyleId])
  @@index([originOrderId])
  @@index([status])
  @@index([agingDays])
  @@index([qualityGrade])
  @@index([stockType])
  @@index([embroideryId])
}

/// Fabric Processing - Tracks greige→finished lifecycle with mill-specific shrinkage patterns
/// Records variance from expected shrinkage for mill performance tracking
model fabric_processing {
  id String @id @default(uuid())

  // Procurement Reference
  procurementId String // Links to fabric_procurement

  // Processing Details
  processingMillId      String // Supplier who does processing (dyer/printer)
  processingType        String // "DYEING", "PRINTING", "CALENDERING", "SANFORIZING", "MERCERIZING"
  batchNumber           String?
  processSpecifications String? @db.Text // Detailed processing specs

  // Greige Input
  greigeId           String
  greigeQuantitySent Decimal @db.Decimal(10, 2)
  greigeWidth        Decimal @db.Decimal(10, 2)

  // Expected Output (Planning)
  expectedFinishedWidthMin Decimal @db.Decimal(10, 2)
  expectedFinishedWidthMax Decimal @db.Decimal(10, 2)
  expectedShrinkagePercent Decimal @db.Decimal(5, 2)

  // Actual Output (After Processing)
  actualFinishedWidth    Decimal? @db.Decimal(10, 2)
  actualQuantityReceived Decimal? @db.Decimal(10, 2)
  actualShrinkagePercent Decimal? @db.Decimal(5, 2)
  processingLossMeters   Decimal? @db.Decimal(10, 2)

  // Variance Analysis (Business Rule: Track mill-specific patterns)
  widthVarianceInches      Decimal? @db.Decimal(10, 2)
  shrinkageVariancePercent Decimal? @db.Decimal(5, 2)

  // Mill Performance Tracking
  millAvgShrinkage    Decimal? @db.Decimal(5, 2) // Historical avg for this mill+greige combo
  varianceFromMillAvg Decimal? @db.Decimal(5, 2)

  // Costing (Greige + Processing = Finished)
  greigeCost        Decimal @db.Decimal(10, 2)
  processingCost    Decimal @db.Decimal(10, 2)
  totalFinishedCost Decimal @db.Decimal(10, 2)
  costPerMeter      Decimal @db.Decimal(10, 2)

  // Finished Fabric Created
  finishedFabricId String? // Links to fabric_master

  // Dates
  sentDate           DateTime
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?

  // Status
  processingStatus String @default("SENT")
  // "SENT", "IN_PROCESS", "COMPLETED", "REJECTED", "PARTIAL_COMPLETED"

  // Quality Notes
  qualityNotes    String? @db.Text
  rejectionReason String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  procurement    fabric_procurement @relation(fields: [procurementId], references: [id])
  greigeMaster   greige_master      @relation("ProcessingGreige", fields: [greigeId], references: [id])
  processingMill suppliers          @relation("ProcessingMill", fields: [processingMillId], references: [id])
  finishedFabric fabric_master?     @relation("ProcessingResult", fields: [finishedFabricId], references: [id])
  createdBy      users              @relation("fabric_processing_createdBy", fields: [createdById], references: [id])

  @@index([processingMillId, greigeId]) // For mill performance queries
  @@index([processingStatus])
  @@index([sentDate])
  @@index([procurementId])
}

/// Fabric Stock Allocation - Reserves stock for orders with CAD variance tracking
/// Supports cross-style allocation (Style A excess used for Style B)
model fabric_stock_allocation {
  id String @id @default(uuid())

  // Stock Reference
  stockId String

  // Order Reference
  orderId String
  styleId String

  // Allocation Details
  quantityAllocated Decimal @db.Decimal(10, 2)
  unit              String  @default("meters")

  // Consumption Tracking
  quantityConsumed Decimal @default(0) @db.Decimal(10, 2)
  quantityReturned Decimal @default(0) @db.Decimal(10, 2) // Unused returned to stock

  // CAD Variance Tracking (Planned vs Actual)
  plannedCad     Decimal  @db.Decimal(10, 4)
  actualCad      Decimal? @db.Decimal(10, 4)
  cadVariance    Decimal? @db.Decimal(10, 4)
  varianceReason String?  @db.Text

  // Cross-Style Allocation Support (Business Rule)
  originalStyleId String? // If stock from Style A used for Style B
  allocationType  String  @default("SAME_STYLE")
  // "SAME_STYLE", "CROSS_STYLE", "STOCK_UTILIZATION"

  // Status
  allocationStatus String @default("RESERVED")
  // "RESERVED", "IN_PRODUCTION", "CONSUMED", "PARTIAL_RETURNED", "CANCELLED"

  // Dates
  allocatedDate   DateTime  @default(now())
  consumptionDate DateTime?

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  fabricStock   fabric_stock @relation(fields: [stockId], references: [id])
  order         orders       @relation("AllocationOrder", fields: [orderId], references: [id])
  style         styles       @relation("AllocationStyle", fields: [styleId], references: [id])
  originalStyle styles?      @relation("OriginalStyle", fields: [originalStyleId], references: [id])
  createdBy     users        @relation("fabric_stock_allocation_createdBy", fields: [createdById], references: [id])

  @@index([stockId])
  @@index([orderId])
  @@index([styleId])
  @@index([allocationType])
  @@index([allocationStatus])
}

/// Fabric Stock Transaction - Complete audit trail of all stock movements
/// Records weighted average cost at time of transaction (Business Rule)
model fabric_stock_transaction {
  id String @id @default(uuid())

  stockId String

  // Transaction Type & Details
  transactionType String
  // "RECEIPT", "CONSUMPTION", "RETURN", "ADJUSTMENT",
  // "TRANSFER", "GRADE_DOWN", "AGING_ALERT", "RESERVATION", "RELEASE"

  quantity Decimal @db.Decimal(10, 2)
  unit     String  @default("meters")

  // Context & Reference
  referenceType String?
  // "ORDER", "PROCUREMENT", "WASTAGE", "QUALITY_REJECTION",
  // "CROSS_STYLE_ALLOCATION", "MANUAL_ADJUSTMENT"
  referenceId   String?

  // Weighted Average Costing (Business Rule: Track at transaction time)
  costPerUnit     Decimal @db.Decimal(10, 2)
  weightedAvgCost Decimal @db.Decimal(10, 2)
  totalValue      Decimal @db.Decimal(10, 2)

  // CAD Variance Context (if consumption transaction)
  plannedCad     Decimal? @db.Decimal(10, 4)
  actualCad      Decimal? @db.Decimal(10, 4)
  piecesProduced Int?

  // Quality Context (if grade-down transaction)
  qualityGradeFrom String? // "A", "B", "DEFECT"
  qualityGradeTo   String?
  defectType       String?

  // Stock Balance After Transaction
  balanceAfter Decimal @db.Decimal(10, 2)
  valueAfter   Decimal @db.Decimal(10, 2)

  // Audit
  notes           String?  @db.Text
  createdById     String?
  transactionDate DateTime @default(now())

  // Relations
  fabricStock fabric_stock @relation(fields: [stockId], references: [id])
  createdBy   users?       @relation("fabric_stock_transaction_createdBy", fields: [createdById], references: [id])

  @@index([stockId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([referenceType, referenceId])
}

/// Quality Inspection - Fabric quality grading with defect tracking
/// Business Rule: Defect fabric value = greige cost
model quality_inspection {
  id String @id @default(uuid())

  // Inspection Context
  inspectionType      String // "INCOMING", "IN_PROCESS", "FINAL"
  fabricProcurementId String? // For incoming inspection
  fabricStockId       String? // For stock inspection

  // Fabric Details
  fabricId          String
  width             Decimal @db.Decimal(10, 2)
  quantityInspected Decimal @db.Decimal(10, 2)

  // Inspector & Date
  inspectorId    String
  inspectionDate DateTime @default(now())

  // Defects Tracking (4-point system)
  defectTypes String? @db.Text // JSON array
  // ["COLOR_VARIATION", "WEAVING_DEFECT", "PRINTING_MISALIGNMENT",
  //  "HOLE", "STAIN", "SHADE_VARIATION", "SIZING_ISSUE"]

  defectPoints     Int     @default(0) // Total defect points
  defectMeters     Decimal @default(0) @db.Decimal(10, 2)
  defectPercentage Decimal @default(0) @db.Decimal(5, 2)

  // Grade Assignment
  qualityGrade String // "A", "B", "DEFECT"
  gradeReason  String? @db.Text

  // Grade Breakdown (quantities per grade)
  aGradeQuantity Decimal @default(0) @db.Decimal(10, 2)
  bGradeQuantity Decimal @default(0) @db.Decimal(10, 2)
  defectQuantity Decimal @default(0) @db.Decimal(10, 2)

  // Financial Impact (Business Rule: Defect value = greige cost)
  aGradeValue Decimal @default(0) @db.Decimal(10, 2)
  bGradeValue Decimal @default(0) @db.Decimal(10, 2)
  defectValue Decimal @default(0) @db.Decimal(10, 2) // = greige cost
  totalLoss   Decimal @default(0) @db.Decimal(10, 2)

  // Action Taken
  action String?
  // "ACCEPTED", "PARTIAL_REJECTION", "FULL_REJECTION",
  // "GRADE_DOWN", "CLAIM_SUPPLIER", "REWORK"

  // Supplier Claim
  supplierClaimAmount Decimal? @db.Decimal(10, 2)
  claimStatus         String? // "PENDING", "APPROVED", "REJECTED", "SETTLED"

  // Attachments & Documentation
  inspectionPhotos    String? @db.Text // JSON array of URLs
  inspectionReportUrl String?
  notes               String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  fabricMaster fabric_master       @relation(fields: [fabricId], references: [id])
  procurement  fabric_procurement? @relation(fields: [fabricProcurementId], references: [id])
  stock        fabric_stock?       @relation(fields: [fabricStockId], references: [id])
  inspector    users               @relation("Inspector", fields: [inspectorId], references: [id])
  createdBy    users               @relation("quality_inspection_createdBy", fields: [createdById], references: [id])

  @@index([fabricId])
  @@index([qualityGrade])
  @@index([inspectionDate])
  @@index([inspectorId])
  @@index([inspectionType])
}

// =====================================================
// Style Import Staging Table
// =====================================================
/// Temporary table for bulk style import processing
/// Stores CSV data during import for validation and error handling
model style_import_staging {
  id String @id @default(uuid())

  // Original CSV columns
  styleCode             String
  projectGroup          String?
  itemDescription       String
  customer              String?
  season                String?
  gender                String?
  category              String?
  componentName         String
  fabricDescription     String
  cadAverage            Decimal? @db.Decimal(10, 4)
  lastProductionAverage Decimal? @db.Decimal(10, 4)
  fabricWidth           Decimal? @db.Decimal(10, 2)

  // Generated fields
  generatedFabricCode String?
  generatedFabricName String?

  // Import metadata
  importBatchId String
  importedAt    DateTime @default(now())
  status        String   @default("PENDING") // PENDING, PROCESSED, ERROR
  errorMessage  String?  @db.Text

  // Links to created records
  createdStyleId     String?
  createdFabricId    String?
  createdComponentId String?

  @@index([importBatchId])
  @@index([status])
  @@index([styleCode])
}

// ============================================
// PHASE 1: MATERIAL MASTERS (Lace, Button, Thread)
// ============================================

model lace_master {
  id            String   @id @default(uuid())
  laceCode      String   @unique
  laceName      String
  supplierCode  String? // Reference code from supplier (kept for reference)
  buyerCode     String?
  width         Decimal? @db.Decimal(10, 2)
  design        String?
  color         String?
  composition   String?
  laceType      String?
  pricePerMeter Decimal? @db.Decimal(10, 2)
  image         String?
  supplierId    String?
  description   String?
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  suppliers               suppliers?                @relation(fields: [supplierId], references: [id])
  createdBy               users?                    @relation(fields: [createdById], references: [id])
  materials               materials[]
  style_material_bom      style_material_bom[] // Phase 2: Used in style BOM
  lace_style_associations lace_style_associations[]
  lace_suppliers          lace_suppliers[] // Multi-supplier support

  @@index([laceCode])
  @@index([supplierId])
