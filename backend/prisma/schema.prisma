/// Cost Sheet PO Generation Tracking
/// Links cost sheets to generated Purchase Orders
model cost_sheet_po_generation {
  id                 String   @id @default(uuid())
  costSheetId        String // FK to style_costing
  totalOrderQuantity Int // User-entered total pieces for PO calculation
  generatedAt        DateTime @default(now())
  generatedById      String // FK to users

  // Generated PO references (one PO per category per generation)
  fabricPOId     String? @unique
  greigePOId     String? @unique
  processingPOId String? @unique
  trimsPOId      String? @unique

  // Lace PO references
  lacePOId           String? @unique
  greigeLacePOId     String? @unique
  laceProcessingPOId String? @unique

  // Generation status
  status String  @default("GENERATED") // GENERATED, PARTIALLY_ORDERED, COMPLETED, CANCELLED
  notes  String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  costSheet       style_costing     @relation(fields: [costSheetId], references: [id])
  generatedBy     users             @relation("cost_sheet_po_gen_user", fields: [generatedById], references: [id])
  purchaseOrders  purchase_orders[]
  po_source_links po_source_links[]

  @@index([costSheetId])
  @@index([generatedById])
  @@index([status])
  @@map("cost_sheet_po_generation")
}

/// NEW: Relational fabric costing (replaces JSON fabricDetails)
