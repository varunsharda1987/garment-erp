# =============================================================================
# POST-COMMIT: say how this commit goes live. It builds and restarts NOTHING.
# =============================================================================
# Until 2026-09-26 this hook rebuilt frontend/dist + backend/dist FROM THE FILES ON DISK and
# restarted the apps inside `git commit`. With several Claude terminals editing this one folder,
# every commit shipped the other terminals' unfinished edits too, two commits could deploy at once,
# and a Bash timeout could kill it between `pm2 stop` and `pm2 start`.
#
# Deploys are done by ONE process, the PM2 app garment-erp-deployer (scripts/ship/deployer.js): it
# notices the new commit on main, builds EXACTLY that commit in a private build folder, swaps it in
# and restarts safely — one deploy at a time. Follow it with `npm run ship:wait`.
#
# If the deployer is not running, `ship notify` prints a WARNING (and fleet-check raises it); the
# commit then waits until it runs again. There is deliberately no in-place fallback build: that
# fallback IS the bug this replaced.
# =============================================================================

[ "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" = "main" ] || exit 0
node scripts/ship/ship.js notify || true
