  finished_goods_stock      finished_goods_stock[]
  order_items               order_items[]
  quality_inspections       quality_inspections[]
  quotation_items           quotation_items[]
  samples                   samples[]
  size_options              size_options[]
  style_components          style_components[]
  style_costing             style_costing?
  style_garment_trims       style_garment_trims[]
  style_packaging           style_packaging[]
  style_processes           style_processes[]
  style_production_tracking style_production_tracking[]
  style_value_additions     style_value_additions[]
  style_variants            style_variants[]
  style_material_bom        style_material_bom[] // Phase 2: Material BOM Integration
