# Garment ERP - Environment Configuration
# Copy this file to .env and update the values

# ======================
# DATABASE CONFIGURATION
# ======================
DB_USER=garment_user
DB_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
DB_NAME=garment_erp

# ======================
# APPLICATION SECRETS
# ======================
# Generate a random string: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_STRING_32_CHARS_MIN

# ======================
# NETWORK CONFIGURATION
# ======================
# Your Synology's local IP address (e.g., 192.168.1.100)
SYNOLOGY_IP=192.168.1.100

# Frontend URL (how users access the ERP)
CORS_ORIGIN=http://192.168.1.100:5173

# API URL (how frontend talks to backend)
API_URL=http://192.168.1.100:5000

# ======================
# BACKUP CONFIGURATION
# ======================
# Backblaze B2 credentials (for cloud backup)
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_app_key
B2_BUCKET_NAME=your_bucket_name

# ======================
# ALERT CONFIGURATION
# ======================
# Email for alerts
ALERT_EMAIL=your.email@gmail.com

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
