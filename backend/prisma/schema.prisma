  effectiveCad       Decimal              @default(0) @db.Decimal(10, 4)
  costPerMeter       Decimal              @default(0) @db.Decimal(10, 2)
  totalCost          Decimal              @default(0) @db.Decimal(10, 2)
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  costComparisonData Json?
  greigeCost         Decimal?             @db.Decimal(10, 2)
  isManualOverride   Boolean              @default(false)
  overrideReason     String?
  processingCost     Decimal?             @db.Decimal(10, 2)
  processorId        String?
  procurementId      String?
  rateCardId         String?
