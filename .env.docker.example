# Docker Compose Environment Variables
# Copy this file to .env.docker and update with your values

# ==================================
# Database Configuration
# ==================================
DB_USER=postgres
DB_PASSWORD=strong_postgres_password_here
DB_NAME=garment_erp
DB_PORT=5432

# ==================================
# Backend Configuration
# ==================================
# CRITICAL: Generate a strong JWT secret (min 64 characters)
# Command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_EXPIRES_IN=7d

BACKEND_PORT=5000

# Frontend URL for CORS
FRONTEND_URL=http://localhost

# Debugging
DEBUG_TRANSFORM=false

# ==================================
# Frontend Configuration
# ==================================
FRONTEND_PORT=80

# Backend API URL (as seen from the browser)
# Development: http://localhost:5000/api
# Production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api

# ==================================
# AI Configuration (Optional)
# ==================================
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ==================================
# Redis Configuration (Optional)
# ==================================
REDIS_PORT=6379

# ==================================
# Production Security Checklist
# ==================================
# [ ] Change DB_PASSWORD to a strong password
# [ ] Generate strong JWT_SECRET (min 64 characters)
# [ ] Update FRONTEND_URL to production domain
# [ ] Update VITE_API_URL to production backend URL
# [ ] Set DEBUG_TRANSFORM=false
# [ ] Secure AI_API_KEY if using cloud providers
# [ ] Use HTTPS in production (setup reverse proxy)
# [ ] Configure firewall rules
# [ ] Enable database backups
# [ ] Setup monitoring and alerting
