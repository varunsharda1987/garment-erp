/// Which finished_goods_stock rows a delivery note ACTUALLY deducted (and by how much). Written inside
/// the create-note transaction; deleting a PENDING note restores stock from these records EXACTLY —
/// without them, restore-by-SKU could re-inflate stock the creation never deducted (shortfalls) or
/// restore to the wrong location row (bug-hunt dispatch-2 / T3-C).
model delivery_note_fg_allocations {
  id             String               @id @default(uuid())
  deliveryNoteId String
  fgStockId      String
  quantity       Int
  createdAt      DateTime             @default(now())
  delivery_note  delivery_notes       @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  fgStock        finished_goods_stock @relation(fields: [fgStockId], references: [id])

  @@index([deliveryNoteId])
  @@index([fgStockId])
}

model finished_goods_stock {
  id                           String                         @id
  styleId                      String
  colorId                      String
  sizeId                       String
  variantId                    String?
  quantity                     Int
  locationId                   String
  workOrderId                  String?
