  styleId                String
  fabricId               String
  millId                 String
  fabricStockLotId       String
  fabricType             String
  reprocessReason        String?
  qtySentMeters          Decimal                           @db.Decimal(10, 2)
  sentWidthInches        Decimal                           @db.Decimal(10, 2)
  sentDate               DateTime?
  challanNumber          String?
  vehicleNumber          String?
  expectedReturnDate     DateTime?
  expectedShrinkage      Decimal?                          @db.Decimal(5, 2)
  agreedRatePerMeter     Decimal                           @db.Decimal(10, 2)
  qtyReceivedMeters      Decimal?                          @db.Decimal(10, 2)
  receivedWidthInches    Decimal?                          @db.Decimal(10, 2)
  receivedDate           DateTime?
  receivedChallan        String?
  invoiceNumber          String?
  actualShrinkage        Decimal?                          @db.Decimal(5, 2)
  widthVariance          Decimal?                          @db.Decimal(10, 2)
  qualityGrade           String?
  colorMatchStatus       String?
  defectMeters           Decimal?                          @db.Decimal(10, 2)
  defectType             String?
  actualRate             Decimal?                          @db.Decimal(10, 2)
  status                 JobWorkStatus                     @default(READY_TO_SEND)
  remarks                String?
  workOrderId            String?
  createdById            String
  createdAt              DateTime                          @default(now())
  updatedAt              DateTime                          @updatedAt
  isActive               Boolean                           @default(true)
  finishedFabricId       String? // FK to auto-created finished fabric_master
  thanCount              Int? // Number of thans (folded bundles) received
  foldLengthCm           Decimal?                          @db.Decimal(5, 2) // "L" - actual fold length in cm
  calculatedActualMeters Decimal?                          @db.Decimal(10, 2) // thanCount × foldLengthCm / 100
  outwardChallanId       String? // FK to new challans table (outbound)
  inwardChallanId        String? // FK to new challans table (inbound)
  purchaseOrderId        String?                           @unique @db.VarChar(50) // FK to purchase_orders (Process PO link)
  greigeStockLotId       String?                           @db.VarChar(50) // FK to greige_stock (source greige)
  grnId                  String?                           @db.VarChar(50) // FK to GRN if received via GRN path
