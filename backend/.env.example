# Kashaya Fabs ERP - Environment Variables Template
# Copy this file to .env and update with your actual values
# NEVER commit .env with real credentials to version control

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# PRODUCTION: Use strong credentials and secure connection
DATABASE_URL="postgresql://username:password@localhost:5432/garment_erp"

# ============================================
# JWT Configuration
# ============================================
# CRITICAL: Generate a strong random secret for production
# Example command: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_STRING_MIN_64_CHARS"
JWT_EXPIRES_IN="7d"

# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV="development"  # Options: development, production, test

# ============================================
# CORS Configuration
# ============================================
# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL="http://localhost:5173"

# ============================================
# Debugging
# ============================================
# Enable transformation debugging logs (true/false)
DEBUG_TRANSFORM="false"

# ============================================
# Monitoring & Error Tracking
# ============================================
# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io/ → Project Settings → Client Keys (DSN)
# Leave empty to disable Sentry
SENTRY_DSN=""

# Sentry sample rates (0.0 to 1.0)
SENTRY_TRACES_SAMPLE_RATE="0.1"  # 10% of transactions in production
SENTRY_PROFILES_SAMPLE_RATE="0.1"  # 10% profiling in production

# ============================================
# AI Provider Configuration
# ============================================
# Enable/disable AI features (true/false)
AI_ENABLED="true"

# AI Provider Type
# Options: openai, anthropic, google, ollama
# - openai: GPT-4, GPT-3.5 (requires OpenAI API key)
# - anthropic: Claude 3.5 Sonnet, Claude 3 Opus (requires Anthropic API key)
# - google: Gemini 1.5 Pro, Gemini 1.5 Flash (requires Google API key)
# - ollama: Local models like Llama 3, Mistral (free, requires local Ollama installation)
# - deepseek: DeepSeek V4 Flash/Pro (RECOMMENDED - 8x cheaper than Kimi, very fast)
# - kimi: Kimi K3 (Moonshot AI, 1M context)
AI_PROVIDER="ollama"

# API Key (required for cloud providers: openai, anthropic, google, deepseek, kimi)
# Get your API key from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google: https://makersuite.google.com/app/apikey
# - DeepSeek: https://platform.deepseek.com/api_keys (RECOMMENDED - cheapest)
# - Kimi: https://platform.kimi.com/
AI_API_KEY=""

# Model (optional, defaults to provider's recommended model)
# OpenAI models: gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Anthropic models: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Google models: gemini-1.5-pro, gemini-1.5-flash
# Ollama models: llama3, mistral, phi, codellama (any model you have installed)
# DeepSeek models: deepseek-v4-flash (fast, cheap), deepseek-v4-pro (smarter)
# Kimi models: kimi-k3 (flagship), kimi-k2.7-code (coding), kimi-k2.6 (vision)
AI_MODEL="llama3"

# Base URL (required only for Ollama local installations)
# Default Ollama URL: http://localhost:11434
AI_BASE_URL="http://localhost:11434"

# ============================================
# Example Configurations
# ============================================
# OpenAI (GPT-4):
#   AI_ENABLED="true"
#   AI_PROVIDER="openai"
#   AI_API_KEY="sk-..."
#   AI_MODEL="gpt-4-turbo"
#
# Anthropic (Claude):
#   AI_ENABLED="true"
#   AI_PROVIDER="anthropic"
#   AI_API_KEY="sk-ant-..."
#   AI_MODEL="claude-3-5-sonnet-20241022"
#
# Google (Gemini):
#   AI_ENABLED="true"
#   AI_PROVIDER="google"
#   AI_API_KEY="AIza..."
#   AI_MODEL="gemini-1.5-pro"
#
# Ollama (Local - Free):
#   AI_ENABLED="true"
#   AI_PROVIDER="ollama"
#   AI_BASE_URL="http://localhost:11434"
#   AI_MODEL="llama3"
#
# DeepSeek (RECOMMENDED - Cheapest cloud option, ~₹60-80/month for team):
#   AI_ENABLED="true"
#   AI_PROVIDER="deepseek"
#   AI_API_KEY="sk-..."
#   AI_MODEL="deepseek-v4-flash"  # or "deepseek-v4-pro" for complex reasoning
#
# Kimi (Moonshot - 1M context, good for large documents):
#   AI_ENABLED="true"
#   AI_PROVIDER="kimi"
#   AI_API_KEY="sk-..."
#   AI_MODEL="kimi-k3"

# ============================================
# WhatsApp Integration (per-user, whatsapp-web.js)
# ============================================
# Each user links their OWN WhatsApp by scanning a QR (WhatsApp > Settings > Linked devices).
# There is NO API key — the "credential" is the QR-scanned session, saved on disk below.
#
# Where each user's linked-device session is stored (survives restarts, so no re-scan).
# Defaults to <backend cwd>/.wwebjs_auth if unset. This directory is git-ignored.
WHATSAPP_SESSION_DIR=".wwebjs_auth"
#
# Optional: path to a system Chromium/Chrome/Edge to skip Puppeteer's bundled download.
# Windows example: "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
# Leave empty to use the Chromium that installed with whatsapp-web.js.
WHATSAPP_BROWSER_PATH=""

# ============================================
# Production Security Checklist
# ============================================
# [ ] Change DATABASE_URL with strong credentials
# [ ] Generate strong JWT_SECRET (min 64 characters)
# [ ] Set NODE_ENV="production"
# [ ] Update FRONTEND_URL to production domain
# [ ] Set DEBUG_TRANSFORM="false"
# [ ] Secure AI_API_KEY if using cloud providers
# [ ] Enable HTTPS/SSL for database connection
# [ ] Configure firewall rules for database access
# [ ] Setup regular database backups
# [ ] Enable database connection pooling

# PDF renderer (kf-documents design): path to a Chrome/chrome-headless-shell exe.
# Auto-discovery order when unset: ~/.cache/puppeteer/chrome-headless-shell ->
# ~/.cache/puppeteer/chrome -> system Chrome (Program Files).
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
