  quality_inspections_quality_inspections_approvedByIdTousers     quality_inspections[]   @relation("quality_inspections_approvedByIdTousers")
  quality_inspections_quality_inspections_inspectedByIdTousers    quality_inspections[]   @relation("quality_inspections_inspectedByIdTousers")
  quality_inspections_quality_inspections_userIdTousers           quality_inspections[]   @relation("quality_inspections_userIdTousers")
  quotations_quotations_approvedByIdTousers                       quotations[]            @relation("quotations_approvedByIdTousers")
  quotations_quotations_createdByIdTousers                        quotations[]            @relation("quotations_createdByIdTousers")
  samples                                                         samples[]
  style_costing_style_costing_approvedByIdTousers                 style_costing[]         @relation("style_costing_approvedByIdTousers")
  style_costing_style_costing_createdByIdTousers                  style_costing[]         @relation("style_costing_createdByIdTousers")
  styles                                                          styles[]
  suppliers                                                       suppliers[]
  work_orders_work_orders_approvedByIdTousers                     work_orders[]           @relation("work_orders_approvedByIdTousers")
  work_orders_work_orders_createdByIdTousers                      work_orders[]           @relation("work_orders_createdByIdTousers")
  work_orders_work_orders_userIdTousers                           work_orders[]           @relation("work_orders_userIdTousers")
  chart_of_accounts                                               chart_of_accounts[]
  cost_centers                                                    cost_centers[]
  expense_types                                                   expense_types[]
  tax_masters                                                     tax_masters[]
  payment_terms                                                   payment_terms[]
  component_masters                                               component_masters[]
  bank_accounts                                                   bank_accounts[]
  exchange_rates                                                  exchange_rates[]
  export_templates                                                export_templates[]

  // Phase 3: Inventory Management Relations
  warehouses warehouses[]

  // Phase 1A: Fabric/Greige Management Relations
  greige_masters_created    greige_master[]    @relation("greige_master_createdBy")
  fabric_masters_created    fabric_master[]    @relation("fabric_master_createdBy")
  fabric_width_cads_created fabric_width_cad[] @relation("fabric_width_cad_createdBy")

  // Phase 1B: Procurement & Stock Management Relations
  fabricProcurementCreated      fabric_procurement[]       @relation("fabric_procurement_createdBy")
  fabricStockCreated            fabric_stock[]             @relation("fabric_stock_createdBy")
  fabricProcessingCreated       fabric_processing[]        @relation("fabric_processing_createdBy")
  fabricStockAllocationCreated  fabric_stock_allocation[]  @relation("fabric_stock_allocation_createdBy")
  fabricStockTransactionCreated fabric_stock_transaction[] @relation("fabric_stock_transaction_createdBy")
  qualityInspectionsCreated     quality_inspection[]       @relation("quality_inspection_createdBy")
  inspections                   quality_inspection[]       @relation("Inspector")
  lace_master                   lace_master[]
  button_master                 button_master[]
  thread_master                 thread_master[]
  zipper_master                 zipper_master[]
  elastic_master                elastic_master[]
  label_master                  label_master[]
  packaging_master              packaging_master[]

  @@index([email])
}

model work_order_breakup {
  id                String        @id
  workOrderId       String
  colorId           String
  sizeId            String
  plannedQuantity   Int
  completedQuantity Int           @default(0)
  color_options     color_options @relation(fields: [colorId], references: [id])
  size_options      size_options  @relation(fields: [sizeId], references: [id])
  work_orders       work_orders   @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, colorId, sizeId])
  @@index([workOrderId])
}

model work_orders {
  id                                    String                  @id
  workOrderNumber                       String                  @unique
  orderId                               String
  orderItemId                           String
  styleId                               String
  locationId                            String
  plannedStartDate                      DateTime
  plannedEndDate                        DateTime
  actualStartDate                       DateTime?
  actualEndDate                         DateTime?
  totalQuantity                         Int
  completedQuantity                     Int                     @default(0)
  status                                OrderStatus             @default(PENDING)
  priority                              Priority                @default(MEDIUM)
  remarks                               String?
  createdById                           String
  approvedById                          String?
  createdAt                             DateTime                @default(now())
  updatedAt                             DateTime @updatedAt
  userId                                String?
  finished_goods_stock                  finished_goods_stock[]
  material_requisitions                 material_requisitions[]
  production_tracking                   production_tracking[]
  quality_inspections                   quality_inspections[]
  work_order_breakup                    work_order_breakup[]
  users_work_orders_approvedByIdTousers users?                  @relation("work_orders_approvedByIdTousers", fields: [approvedById], references: [id])
  users_work_orders_createdByIdTousers  users                   @relation("work_orders_createdByIdTousers", fields: [createdById], references: [id])
  locations                             locations               @relation(fields: [locationId], references: [id])
  orders                                orders                  @relation(fields: [orderId], references: [id])
  order_items                           order_items             @relation(fields: [orderItemId], references: [id])
  styles                                styles                  @relation(fields: [styleId], references: [id])
  users_work_orders_userIdTousers       users?                  @relation("work_orders_userIdTousers", fields: [userId], references: [id])

  @@index([locationId])
  @@index([orderId])
  @@index([status])
  @@index([workOrderNumber])
}

// ============================================
// PHASE 3: INVENTORY & WAREHOUSE MANAGEMENT
// ============================================

/// Warehouse Master - Multiple warehouse/location management
model warehouses {
  id            String        @id @default(uuid())
  warehouseCode String        @unique
  warehouseName String
  warehouseType WarehouseType
  address       String?
  city          String?
  state         String?
  pincode       String?
  contactPerson String?
  contactPhone  String?
  capacity      Decimal?      @db.Decimal(10, 2) // In cubic meters or square feet
  isActive      Boolean       @default(true)
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  users              users                @relation(fields: [createdById], references: [id])
  stock_levels       stock_levels[]
  stock_movements    stock_movements[]
  stock_reservations stock_reservations[]
  stock_counts       stock_counts[]

  @@index([warehouseCode])
  @@index([warehouseType])
  @@index([createdById])
}

/// Stock Levels - Current stock balance per material per warehouse
model stock_levels {
  id            String   @id @default(uuid())
  materialId    String
  warehouseId   String
  quantity      Decimal  @db.Decimal(10, 3)
  unit          Unit
  reorderLevel  Decimal? @db.Decimal(10, 3)
  maxLevel      Decimal? @db.Decimal(10, 3)
  minLevel      Decimal? @db.Decimal(10, 3)
  lastUpdated   DateTime @default(now())
  valuationRate Decimal? @db.Decimal(10, 2) // Average cost for valuation
  stockValue    Decimal? @db.Decimal(12, 2) // quantity * valuationRate

  // Relations
  materials  materials  @relation(fields: [materialId], references: [id])
  warehouses warehouses @relation(fields: [warehouseId], references: [id])

  @@unique([materialId, warehouseId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([quantity])
}

/// Stock Movements - Transaction log for all stock movements
model stock_movements {
  id              String       @id @default(uuid())
  movementType    MovementType
  materialId      String
  warehouseId     String
  quantity        Decimal      @db.Decimal(10, 3)
  unit            Unit
  referenceType   String? // GRN, MaterialRequisition, Adjustment, Transfer, etc.
  referenceId     String?
  referenceNumber String?
  fromLocation    String? // For transfers
  toLocation      String? // For transfers
  rate            Decimal?     @db.Decimal(10, 2)
  value           Decimal?     @db.Decimal(12, 2)
  remarks         String?
  performedById   String
  movementDate    DateTime     @default(now())
  createdAt       DateTime     @default(now())

  // Relations
  materials  materials  @relation(fields: [materialId], references: [id])
  warehouses warehouses @relation(fields: [warehouseId], references: [id])

  @@index([materialId])
  @@index([warehouseId])
  @@index([movementType])
  @@index([movementDate])
  @@index([referenceType, referenceId])
}

/// Stock Transactions - Detailed ledger for stock valuation (FIFO/LIFO/Weighted Average)
model stock_transactions {
  id              String               @id @default(uuid())
  materialId      String
  warehouseId     String
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(10, 3)
  unit            Unit
  rate            Decimal              @db.Decimal(10, 2)
  value           Decimal              @db.Decimal(12, 2)
  balanceQuantity Decimal              @db.Decimal(10, 3)
  balanceValue    Decimal              @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  transactionDate DateTime             @default(now())
  createdAt       DateTime             @default(now())

  // Relations
  materials materials @relation("stockTransactions", fields: [materialId], references: [id])

  @@index([materialId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([transactionDate])
}

/// Stock Reservations - Reserve stock for orders/work orders
model stock_reservations {
  id               String            @id @default(uuid())
  materialId       String
  warehouseId      String
  reservationType  ReservationType
  referenceType    String // Order, WorkOrder, MaterialRequisition
  referenceId      String
  referenceNumber  String?
  reservedQuantity Decimal           @db.Decimal(10, 3)
  consumedQuantity Decimal           @default(0) @db.Decimal(10, 3)
  unit             Unit
  status           ReservationStatus @default(ACTIVE)
  expiryDate       DateTime?
  remarks          String?
  reservedById     String
  reservedAt       DateTime          @default(now())
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  materials  materials  @relation(fields: [materialId], references: [id])
  warehouses warehouses @relation(fields: [warehouseId], references: [id])

  @@index([materialId])
  @@index([warehouseId])
  @@index([status])
  @@index([referenceType, referenceId])
}

/// Stock Counts - Physical inventory count management
model stock_counts {
  id            String      @id @default(uuid())
  countNumber   String      @unique
  warehouseId   String
  countType     CountType
  countDate     DateTime    @default(now())
  status        CountStatus @default(DRAFT)
  totalItems    Int         @default(0)
  countedItems  Int         @default(0)
  varianceItems Int         @default(0)
  remarks       String?
  countedById   String
  verifiedById  String?
  verifiedAt    DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  warehouses        warehouses          @relation(fields: [warehouseId], references: [id])
  stock_count_items stock_count_items[]

  @@index([countNumber])
  @@index([warehouseId])
  @@index([status])
  @@index([countDate])
}

/// Stock Count Items - Line items for physical counts
model stock_count_items {
  id               String   @id @default(uuid())
  stockCountId     String
  materialId       String
  systemQuantity   Decimal  @db.Decimal(10, 3)
  physicalQuantity Decimal? @db.Decimal(10, 3)
  variance         Decimal? @db.Decimal(10, 3)
  unit             Unit
  remarks          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  stock_counts stock_counts @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  materials    materials    @relation(fields: [materialId], references: [id])

  @@unique([stockCountId, materialId])
  @@index([stockCountId])
  @@index([materialId])
}

