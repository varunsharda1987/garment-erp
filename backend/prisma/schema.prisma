  linkedGreigePOId                          String? // For Processing PO, link to Greige PO
  costSheetGenerationId                     String? // Link to generation record
  // Unified source tracking
  poSource                                  POSource?                         @default(MANUAL)
  mrpBatchId                                String? // Group MRP POs from same bulk operation
  serviceWorkOrderId                        String? // Link to work order for service POs
  goods_receiving_notes                     goods_receiving_notes[]
  purchase_order_items                      purchase_order_items[]
