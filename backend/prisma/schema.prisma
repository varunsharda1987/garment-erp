// ============================================
// CREDIT NOTES & DEBIT NOTES
// ============================================

enum DocumentStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum CreditNoteReason {
  SALES_RETURN
  RATE_DIFFERENCE
  QUALITY_ISSUE
  QUANTITY_DIFFERENCE
  OTHER
}

enum DebitNoteReason {
  PURCHASE_RETURN
  RATE_DIFFERENCE
  QUALITY_ISSUE
  QUANTITY_SHORT
  DAMAGED_GOODS
  OTHER
}

model credit_notes {
  id               String           @id @default(uuid())
  creditNoteNumber String           @unique
  invoiceId        String
  customerId       String
  creditNoteDate   DateTime         @default(now())
  reason           CreditNoteReason
  subtotal         Decimal          @db.Decimal(12, 2)
  cgstAmount       Decimal          @default(0) @db.Decimal(12, 2)
  sgstAmount       Decimal          @default(0) @db.Decimal(12, 2)
  igstAmount       Decimal          @default(0) @db.Decimal(12, 2)
  totalTax         Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal          @db.Decimal(12, 2)
  isInterstate     Boolean          @default(false)
  status           DocumentStatus   @default(DRAFT)
  remarks          String?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  invoice   invoices            @relation(fields: [invoiceId], references: [id])
  customer  customers           @relation(fields: [customerId], references: [id])
  createdBy users               @relation(fields: [createdById], references: [id])
  items     credit_note_items[]

  @@index([invoiceId])
  @@index([customerId])
  @@index([creditNoteNumber])
  @@index([status])
}

model credit_note_items {
  id            String   @id @default(uuid())
  creditNoteId  String
  invoiceItemId String?
  description   String
  hsnCode       String?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  gstRate       Decimal? @db.Decimal(5, 2)
  cgstAmount    Decimal? @db.Decimal(12, 2)
  sgstAmount    Decimal? @db.Decimal(12, 2)
  igstAmount    Decimal? @db.Decimal(12, 2)
  taxAmount     Decimal? @db.Decimal(12, 2)

  creditNote credit_notes @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

model debit_notes {
  id              String          @id @default(uuid())
  debitNoteNumber String          @unique
  poId            String?
  supplierId      String
  debitNoteDate   DateTime        @default(now())
  reason          DebitNoteReason
  subtotal        Decimal         @db.Decimal(12, 2)
  cgstAmount      Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal         @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal         @default(0) @db.Decimal(12, 2)
  totalTax        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @db.Decimal(12, 2)
  isInterstate    Boolean         @default(false)
  status          DocumentStatus  @default(DRAFT)
  remarks         String?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  purchaseOrder purchase_orders?   @relation(fields: [poId], references: [id])
  supplier      suppliers          @relation(fields: [supplierId], references: [id])
  createdBy     users              @relation(fields: [createdById], references: [id])
  items         debit_note_items[]

  @@index([poId])
  @@index([supplierId])
  @@index([debitNoteNumber])
  @@index([status])
}

model debit_note_items {
  id          String   @id @default(uuid())
  debitNoteId String
  poItemId    String?
  description String
  hsnCode     String?
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  gstRate     Decimal? @db.Decimal(5, 2)
  cgstAmount  Decimal? @db.Decimal(12, 2)
  sgstAmount  Decimal? @db.Decimal(12, 2)
  igstAmount  Decimal? @db.Decimal(12, 2)
  taxAmount   Decimal? @db.Decimal(12, 2)

  debitNote debit_notes @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)

  @@index([debitNoteId])
}

enum SupplyType {
  DOMESTIC
  EXPORT_WITH_PAYMENT
  EXPORT_WITHOUT_PAYMENT
  SEZ_WITH_PAYMENT
  SEZ_WITHOUT_PAYMENT
  DEEMED_EXPORT
}

// ============================================
// TDS/TCS TRACKING
// ============================================

enum TDSStatus {
  PENDING
  CERTIFICATE_RECEIVED
  VERIFIED
}

model tds_entries {
  id            String    @id @default(uuid())
  invoiceId     String?
  paymentId     String?
  deductorName  String // Customer who deducts TDS
  deducteeName  String // Our company name
  tdsSection    String // "194C", "194J", etc.
  tdsRate       Decimal   @db.Decimal(5, 2)
  grossAmount   Decimal   @db.Decimal(12, 2)
  tdsAmount     Decimal   @db.Decimal(12, 2)
  netAmount     Decimal   @db.Decimal(12, 2)
  certificateNo String?
  deductionDate DateTime
  financialYear String // "2025-26"
  quarter       Int // 1,2,3,4
  status        TDSStatus @default(PENDING)
  remarks       String?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([invoiceId])
  @@index([financialYear, quarter])
  @@index([status])
}

model tcs_entries {
  id             String   @id @default(uuid())
  invoiceId      String?
  customerName   String
  tcsSection     String // "206C(1H)"
  tcsRate        Decimal  @db.Decimal(5, 2)
  saleAmount     Decimal  @db.Decimal(12, 2)
  tcsAmount      Decimal  @db.Decimal(12, 2)
  collectionDate DateTime
  financialYear  String
  quarter        Int
  status         String   @default("PENDING")
  remarks        String?
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invoiceId])
  @@index([financialYear, quarter])
  @@index([status])
}

/// Atomic code sequence generator — prevents duplicate document numbers.
/// Each row tracks the last-used sequence for a given prefix (e.g., PO2603, ORD202603).
/// Used with SELECT ... FOR UPDATE to guarantee uniqueness under concurrency.
model code_sequences {
  id        String   @id @default(uuid())
  prefix    String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}
