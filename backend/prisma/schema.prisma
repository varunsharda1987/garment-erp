  @@index([locationId])
  @@index([styleId])
}

model goods_receiving_notes {
  id                                              String            @id
  grnNumber                                       String            @unique
  poId                                            String? // Phase 4b: nullable — PO-less receiving keys on jobWorkOrderId
  jobWorkOrderId                                  String? // Phase 4a: GRN→JWO at creation (supports partial GRNs; 4b: the key for PO-less receiving)
  supplierId                                      String
  warehouseId                                     String?
  receivingDate                                   DateTime          @default(now())
  invoiceNumber                                   String?
  invoiceDate                                     DateTime?
  status                                          GRNStatus         @default(PENDING_QC)
  remarks                                         String?
  receivedById                                    String
  approvedById                                    String?
  createdAt                                       DateTime          @default(now())
  users_goods_receiving_notes_approvedByIdTousers users?            @relation("goods_receiving_notes_approvedByIdTousers", fields: [approvedById], references: [id])
  purchase_orders                                 purchase_orders?  @relation(fields: [poId], references: [id])
  jobWorkOrder                                    job_work_orders?  @relation("GRNJobWorkOrder", fields: [jobWorkOrderId], references: [id])
  users_goods_receiving_notes_receivedByIdTousers users             @relation("goods_receiving_notes_receivedByIdTousers", fields: [receivedById], references: [id])
  suppliers                                       suppliers         @relation(fields: [supplierId], references: [id])
  warehouses                                      warehouses?       @relation(fields: [warehouseId], references: [id])
  grn_items                                       grn_items[]
  job_work_orders                                 job_work_orders[]

  @@index([grnNumber])
  @@index([poId])
  @@index([jobWorkOrderId])
  @@index([warehouseId])
  @@index([receivedById])
  @@index([approvedById])
  @@index([supplierId])
}

model grn_items {
  id                    String                @id
  grnId                 String
  poItemId              String? // Phase 4b: nullable — PO-less (JWO) receipts have no PO item
  materialId            String
  orderedQuantity       Decimal               @db.Decimal(10, 3)
  receivedQuantity      Decimal               @db.Decimal(10, 3)
  acceptedQuantity      Decimal               @default(0) @db.Decimal(10, 3)
  rejectedQuantity      Decimal               @default(0) @db.Decimal(10, 3)
  unit                  Unit
  remarks               String?
  componentName         String? // Garment component (Top, Shirt) — copied from PO item
  colorName             String? // Dye/processing color — copied from PO item
  // Measurement fields
  foldLengthCm          Decimal?              @db.Decimal(5, 2) // "L" - fold length in cm, same for all thans
  receivedWidthInches   Decimal?              @db.Decimal(5, 2) // Actual width as received
  entryMode             String?               @db.VarChar(20) // TOTAL_METERS | THAN_WISE | BALE_WISE | ROLL_WISE
  baleCount             Int?
  thanCount             Int?
  rollCount             Int?
  totalMeters           Decimal?              @db.Decimal(10, 3) // Sum from details or direct entry
  isOverReceipt         Boolean               @default(false)
  overReceiptQty        Decimal?              @db.Decimal(10, 3) // Excess amount beyond PO pending
  // Source mismatch override fields (greige→ready fabric scenario)
  receivedAsReadyFabric Boolean               @default(false) // Override: treat greige PO item as ready fabric
  actualRatePerUnit     Decimal?              @db.Decimal(12, 2) // Actual rate received (may differ from PO rate)
  updateFutureSourcing  Boolean               @default(false) // true = permanent change, false = one-time exception
  actualQuantity        Decimal?              @db.Decimal(10, 3) // P2: Physical quantity after fold adjustment (stock uses this; docs use receivedQuantity)
  goods_receiving_notes goods_receiving_notes @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materials             materials             @relation(fields: [materialId], references: [id])
  purchase_order_items  purchase_order_items? @relation(fields: [poItemId], references: [id], onDelete: Cascade)
  grn_item_details      grn_item_details[]
  greige_stock          greige_stock[]        @relation("GreigeStockGrnItem")

  @@index([grnId])
  @@index([poItemId])
}

model grn_item_details {
  id         String  @id @default(uuid())
  grnItemId  String
  detailType String  @db.VarChar(10) // THAN | ROLL
  baleNumber Int? // Which bale (1, 2, 3...) — null for roll-wise or unbaled thans
  sequenceNo Int // Order within bale or overall
  meters     Decimal @db.Decimal(10, 3) // Length of this than/roll in meters
  remarks    String?

  grn_items grn_items @relation(fields: [grnItemId], references: [id], onDelete: Cascade)

  @@index([grnItemId])
}

model inventory_stock {
