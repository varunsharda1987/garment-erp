// ============================================
// JOB WORK & PROCESSING CHAIN MANAGEMENT
// ============================================

/// Processing Batch - Parent record for job work tracking
model processing_batch {
  id          String @id @default(uuid())
  batchNumber String @unique

  // Material
  materialType String // "GREIGE" or "FABRIC"
  greigeId     String?
  fabricId     String?

  // Quantities
  totalQuantitySent     Decimal @db.Decimal(10, 2)
  totalQuantityReceived Decimal @default(0) @db.Decimal(10, 2)
  quantityInProcess     Decimal @db.Decimal(10, 2)
  quantityInTransit     Decimal @default(0) @db.Decimal(10, 2)
  quantityRejected      Decimal @default(0) @db.Decimal(10, 2)

  // Status
  overallStatus String @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED

  // Costing
  totalCostIncurred Decimal @default(0) @db.Decimal(10, 2)

  // Audit
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  greigeMaster greige_master?        @relation(fields: [greigeId], references: [id])
  fabricMaster fabric_master?        @relation(fields: [fabricId], references: [id])
  createdBy    users                 @relation(fields: [createdById], references: [id])
  stages       processing_stage[]
  movements    processing_movement[]
  deliveries   processing_delivery[]

  @@index([batchNumber])
  @@index([overallStatus])
  @@index([greigeId])
  @@index([fabricId])
  @@index([createdById])
}

/// Processing Stage - Individual processing step in the chain
model processing_stage {
  id          String @id @default(uuid())
  batchId     String
  stageNumber Int // 1, 2, 3... (sequence)

  // Processor Details
  processorId       String
  processorFacility String? // Which facility/building at processor
  processingType    String // DYEING, PRINTING, EMBROIDERY, etc.

  // Quantities for this stage
  quantitySent      Decimal @db.Decimal(10, 2)
  quantityReceived  Decimal @default(0) @db.Decimal(10, 2)
  quantityInProcess Decimal @db.Decimal(10, 2)

  // Specifications
  processSpecifications String? @db.Text
  expectedOutputSpecs   Json? // Width, shrinkage, etc.
  actualOutputSpecs     Json?

  // Status
  status String @default("PENDING")
  // PENDING → IN_TRANSIT_TO_PROCESSOR → AT_PROCESSOR → IN_PROCESS →
  // IN_TRANSIT_TO_COMPANY → COMPLETED → REWORK_REQUIRED

  // Dates
  sentDate               DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?

  // Costing
  processingCost Decimal @db.Decimal(10, 2)

  // Quality
  qualityNotes String? @db.Text
  reworkReason String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  batch      processing_batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  processor  suppliers             @relation(fields: [processorId], references: [id])
  movements  processing_movement[]
  deliveries processing_delivery[]

  @@index([batchId, stageNumber])
  @@index([processorId, status])
  @@index([status])
}

/// Processing Movement - Transit tracking between locations
model processing_movement {
  id      String  @id @default(uuid())
  batchId String
  stageId String?

  movementType String
  // Types: WAREHOUSE_TO_PROCESSOR, PROCESSOR_TO_WAREHOUSE,
  //        PROCESSOR_TO_PROCESSOR, REWORK_TO_PROCESSOR

  // Locations
  fromLocation String // "WAREHOUSE:RAW001" or "PROCESSOR:SUPP123:FACILITY_A"
  toLocation   String // "PROCESSOR:SUPP123:FACILITY_A" or "WAREHOUSE:FG001"

  // Quantity
  quantity Decimal @db.Decimal(10, 2)

  // Transit Details
  status        String  @default("IN_TRANSIT") // IN_TRANSIT, DELIVERED
  vehicleNumber String?
  driverName    String?
  lrNumber      String? // Lorry Receipt Number

  // Dates
  dispatchDate         DateTime
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?

  // Documents
  challanNumber String?
  documents     Json? // Array of document URLs

  // Audit
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  performedById String

  // Relations
  batch       processing_batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stage       processing_stage? @relation(fields: [stageId], references: [id])
  performedBy users             @relation(fields: [performedById], references: [id])

  @@index([status])
  @@index([batchId])
  @@index([stageId])
  @@index([performedById])
}

/// Processing Delivery - Partial deliveries and quality check
model processing_delivery {
  id      String @id @default(uuid())
  batchId String
  stageId String

  deliveryNumber String @unique

  // Quantity
  quantityDelivered Decimal @db.Decimal(10, 2)
  quantityAccepted  Decimal @db.Decimal(10, 2)
  quantityRejected  Decimal @default(0) @db.Decimal(10, 2)

  // Quality Check
  qualityStatus String @default("PENDING_QC")
  // PENDING_QC → QC_PASSED → QC_FAILED → ACCEPTED → REJECTED → REWORK_REQUIRED

  qualityNotes    String? @db.Text
  rejectionReason String? @db.Text

  // Destination
  receivedAtWarehouse String? // Warehouse ID if going to company
  nextStageId         String? // If going to another processor

  // Dates
  deliveryDate   DateTime
  qcDate         DateTime?
  acceptanceDate DateTime?

  // Documents
  invoiceNumber String?
  challanNumber String?
  documents     Json?

  // Audit
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  receivedById String

  // Relations
  batch      processing_batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stage      processing_stage @relation(fields: [stageId], references: [id])
  receivedBy users            @relation(fields: [receivedById], references: [id])

  @@index([batchId])
  @@index([stageId])
  @@index([qualityStatus])
  @@index([deliveryNumber])
  @@index([receivedById])
}

