notepad .gitignore
```

When Notepad opens, copy and paste this:
```
# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment variables
.env
.env.local
.env.production
.env.development

# Build outputs
dist/
build/
.next/
out/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.suo

# Prisma
prisma/migrations/*/migration.sql

# Temporary files
*.tmp
*.temp
.cache/

# Testing
coverage/
.nyc_output/nul
backend/nul
