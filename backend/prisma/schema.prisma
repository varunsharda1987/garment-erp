  DIRECT
  INDIRECT
  OVERHEAD
  ADMINISTRATIVE
  MARKETING
}

enum BankAccountType {
  CURRENT
  SAVINGS
  OD
  CC
}

enum RateType {
  BUYING
  SELLING
  AVERAGE
}

// ============================================
// FINANCIAL MANAGEMENT MODELS
// ============================================

/// Chart of Accounts Master - Core accounting structure
model chart_of_accounts {
  id              String       @id @default(uuid())
  accountCode     String       @unique
  accountName     String
  accountType     AccountType
  accountGroup    AccountGroup
  parentAccountId String?
  description     String?
  isActive        Boolean      @default(true)
  isSystem        Boolean      @default(false)
  createdById     String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Self-referential relation for account hierarchy
  parentAccount chart_of_accounts?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts chart_of_accounts[] @relation("AccountHierarchy")

  // Relations
  users         users           @relation(fields: [createdById], references: [id])
  expense_types expense_types[]

  @@index([accountCode])
  @@index([accountType])
  @@index([parentAccountId])
}

/// Cost Center Master - Track costs by department/location/project
model cost_centers {
  id             String   @id @default(uuid())
  costCenterCode String   @unique
  costCenterName String
  costCenterType String // DEPARTMENT, LOCATION, PROJECT, PRODUCT_LINE
  departmentId   String?
  locationId     String?
  budgetAmount   Decimal? @db.Decimal(12, 2)
  description    String?
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  locations locations? @relation(fields: [locationId], references: [id])
  users     users      @relation(fields: [createdById], references: [id])

  @@index([costCenterCode])
  @@index([locationId])
}

/// Expense Type Master - Categorize expenses
model expense_types {
  id              String          @id @default(uuid())
  expenseCode     String          @unique
  expenseName     String
  expenseCategory ExpenseCategory
  accountId       String?
  isRecurring     Boolean         @default(false)
  description     String?
  isActive        Boolean         @default(true)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  chart_of_accounts chart_of_accounts? @relation(fields: [accountId], references: [id])
  users             users              @relation(fields: [createdById], references: [id])

  @@index([expenseCode])
  @@index([accountId])
}

/// Tax Master - GST/VAT/Duties management
model tax_masters {
  id             String    @id @default(uuid())
  taxCode        String    @unique
  taxName        String
  taxType        TaxType
  taxRate        Decimal   @db.Decimal(5, 2)
  hsnSacCode     String?
  description    String?
  applicableFrom DateTime
  applicableTo   DateTime?
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  users users @relation(fields: [createdById], references: [id])

  @@index([taxCode])
  @@index([taxType])
  @@index([applicableFrom])
}

/// Payment Terms Master - Standardize payment terms
model payment_terms {
  id              String   @id @default(uuid())
  termCode        String   @unique
  termName        String
  description     String?
  daysCount       Int?
  paymentSchedule Json? // For complex payment schedules
  discountPercent Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  users     users       @relation(fields: [createdById], references: [id])
  customers customers[]
  suppliers suppliers[]

  @@index([termCode])
}

/// Bank Account Master - Track multiple bank accounts
model bank_accounts {
  id                String          @id @default(uuid())
  accountNumber     String          @unique
  bankName          String
  branchName        String
  ifscCode          String?
  swiftCode         String?
  accountType       BankAccountType
  accountHolderName String
  openingBalance    Decimal         @db.Decimal(12, 2)
  currentBalance    Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  isActive          Boolean         @default(true)
  isPrimaryAccount  Boolean         @default(false)
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  users users @relation(fields: [createdById], references: [id])

  @@index([accountNumber])
  @@index([bankName])
}

/// Currency Master - Multi-currency support
model currencies {
  id             String   @id @default(uuid())
  currencyCode   String   @unique
  currencyName   String
  currencySymbol String
  isBaseCurrency Boolean  @default(false)
  decimalPlaces  Int      @default(2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  exchange_rates exchange_rates[]
  customers      customers[]
  suppliers      suppliers[]

  @@index([currencyCode])
}

/// Exchange Rate Master - Track daily exchange rates
model exchange_rates {
  id            String   @id @default(uuid())
  currencyCode  String
  effectiveDate DateTime
  rateType      RateType
  exchangeRate  Decimal  @db.Decimal(10, 4)
  createdById   String?
  createdAt     DateTime @default(now())

  // Relations
  currencies currencies @relation(fields: [currencyCode], references: [currencyCode])
  users      users?     @relation(fields: [createdById], references: [id])

  @@unique([currencyCode, effectiveDate, rateType])
  @@index([currencyCode])
  @@index([effectiveDate])
}

/// Export Template Master - Configurable export templates for CSV/Excel/PDF
model export_templates {
  id           String   @id @default(uuid())
  moduleName   String // e.g., "customers", "suppliers", "materials", "styles", etc.
  templateName String
  description  String?
  columnConfig Json // Array of {fieldName, displayName, format, width, etc.}
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users users @relation(fields: [createdById], references: [id])

  @@unique([moduleName, templateName])
  @@index([moduleName])
  @@index([createdById])
}
