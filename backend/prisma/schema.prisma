  users_purchase_orders_createdByIdTousers  users                             @relation("purchase_orders_createdByIdTousers", fields: [createdById], references: [id])
  suppliers                                 suppliers                         @relation(fields: [supplierId], references: [id])
  users_purchase_orders_userIdTousers       users?                            @relation("purchase_orders_userIdTousers", fields: [userId], references: [id])
  requirement_po_links                      requirement_po_links[]
  work_order_service_requirements           work_order_service_requirements[]
  linkedGreigePO                            purchase_orders?                  @relation("processing_to_greige", fields: [linkedGreigePOId], references: [id])
  processingPOs                             purchase_orders[]                 @relation("processing_to_greige")
  costSheetGeneration                       cost_sheet_po_generation?         @relation(fields: [costSheetGenerationId], references: [id])
  // Unified source links
  po_source_links                           po_source_links[]
  serviceWorkOrder                          work_orders?                      @relation("PO_ServiceWorkOrder", fields: [serviceWorkOrderId], references: [id])
