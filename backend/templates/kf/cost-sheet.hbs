<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Cost Sheet — {{docNo}}</title>
<link rel="stylesheet" href="assets/base.css">
</head>
<body>
<div class="sheet">

  {{> mast company=company docTitle="Cost Sheet" docNo=docNo docPill=statusLabel}}

  <!-- 01 — Basic Information (matches form header) -->
  <div class="sec">
    <div class="sec-h"><span>{{sec.basic}} — Basic Information</span></div>
    <div class="kv">
      <div>
        <div class="row"><span class="k">Style</span><span class="v">{{style.code}}{{#if style.buyerRef}} · <span class="muted">{{style.buyerRef}}</span>{{/if}}</span></div>
        <div class="row"><span class="k">Style Name</span><span class="v">{{style.name}}</span></div>
        <div class="row"><span class="k">Customer</span><span class="v">{{customer}}</span></div>
      </div>
      <div>
        <div class="row"><span class="k">Costing Mode</span><span class="v">{{costingModeLabel}}</span></div>
        <div class="row"><span class="k">Components</span><span class="v">{{numberOfComponents}}</span></div>
        <div class="row"><span class="k">Category</span><span class="v">{{category}}{{#if subCategory}} · {{subCategory}}{{/if}}</span></div>
      </div>
    </div>
  </div>

  <!-- Fabric Costs -->
  {{#if hasFabrics}}
  <div class="sec">
    <div class="sec-h"><span>{{sec.fabric}} — Fabric Details</span><b>Fabric Total: ₹{{fabricTotal}}</b></div>
    <table>
      <thead>
        <tr>
          <th style="width:24px">#</th>
          <th>Fabric</th>
          <th class="num" style="width:60px">CAD (m)</th>
          <th class="num" style="width:48px">Width</th>
          <th style="width:100px">Sourcing</th>
          <th class="num" style="width:72px">Price (₹/m)</th>
          <th class="num" style="width:72px">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each fabrics}}
        <tr>
          <td class="num">{{this.sn}}</td>
          <td>{{this.name}}</td>
          <td class="num">{{this.cad}}</td>
          <td class="num">{{this.width}}</td>
          <td>{{this.sourcing}}</td>
          <td class="num">{{this.rate}}</td>
          <td class="num">{{this.total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Lace Costs (before Trims in form order) -->
  {{#if hasLaces}}
  <div class="sec">
    <div class="sec-h"><span>{{sec.lace}} — Lace Details</span><b>Lace Total: ₹{{laceTotal}}</b></div>
    <table>
      <thead>
        <tr>
          <th style="width:24px">#</th>
          <th>Lace Name</th>
          <th class="num" style="width:56px">Qty/Garment</th>
          <th class="num" style="width:48px">Wastage</th>
          <th class="num" style="width:60px">Effective</th>
          <th style="width:90px">Sourcing</th>
          <th class="num" style="width:64px">Cost</th>
        </tr>
      </thead>
      <tbody>
        {{#each laces}}
        <tr>
          <td class="num">{{this.sn}}</td>
          <td>
            {{this.name}}
            {{#if this.colorSub}}<div class="muted">{{this.colorSub}}</div>{{/if}}
            {{#if this.widthSub}}<div class="muted">{{this.widthSub}}</div>{{/if}}
          </td>
          <td class="num">{{this.qty}}</td>
          <td class="num">{{this.wastage}}</td>
          <td class="num">{{this.effective}}</td>
          <td>{{this.sourcing}}</td>
          <td class="num">{{this.total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Trims Costs -->
  {{#if hasTrims}}
  <div class="sec">
    <div class="sec-h"><span>{{sec.trims}} — Trims Details</span><b>Trims Total: ₹{{trimsTotal}}</b></div>
    <table>
      <thead>
        <tr>
          <th style="width:24px">#</th>
          <th style="width:80px">Type</th>
          <th>Trim Name</th>
          <th class="num" style="width:48px">Qty</th>
          <th style="width:48px">Unit</th>
          <th class="num" style="width:72px">Rate</th>
          <th class="num" style="width:72px">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each trims}}
        <tr>
          <td class="num">{{this.sn}}</td>
          <td>{{this.type}}</td>
          <td>{{this.name}}</td>
          <td class="num">{{this.qty}}</td>
          <td>{{this.unit}}</td>
          <td class="num">{{this.rate}}</td>
          <td class="num">{{this.total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- CMT Costs -->
  <div class="sec">
    <div class="sec-h"><span>{{sec.cmt}} — CMT Costs</span><b>CMT Total: ₹{{cmtTotal}}</b></div>
    <table>
      <thead>
        <tr>
          <th>Component</th>
          <th class="num" style="width:100px">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each cmt}}
        <tr>
          <td>{{this.label}}</td>
          <td class="num">{{this.amount}}</td>
        </tr>
        {{/each}}
        <tr class="tot">
          <td>CMT Total</td>
          <td class="num">{{cmtTotal}}</td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Embroidery Costs -->
  {{#if hasEmbroideries}}
  <div class="sec">
    <div class="sec-h"><span>{{sec.embroidery}} — Embroidery</span><b>Embroidery Total: ₹{{embroideryTotal}}</b></div>
    <table>
      <thead>
        <tr>
          <th style="width:24px">#</th>
          <th>Embroidery Name</th>
          <th class="num" style="width:64px">Avg (m)</th>
          <th class="num" style="width:72px">Rate/m</th>
          <th class="num" style="width:72px">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each embroideries}}
        <tr>
          <td class="num">{{this.sn}}</td>
          <td>{{this.name}}</td>
          <td class="num">{{this.average}}</td>
          <td class="num">{{this.rate}}</td>
          <td class="num">{{this.total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Accessories Costs -->
  {{#if hasAccessories}}
  <div class="sec">
    <div class="sec-h"><span>{{sec.accessories}} — Accessories</span><b>Accessories Total: ₹{{accessoriesTotal}}</b></div>
    <table>
      <thead>
        <tr>
          <th style="width:24px">#</th>
          <th style="width:80px">Type</th>
          <th>Name</th>
          <th class="num" style="width:48px">Qty</th>
          <th class="num" style="width:72px">Rate</th>
          <th class="num" style="width:72px">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each accessories}}
        <tr>
          <td class="num">{{this.sn}}</td>
          <td>{{this.type}}</td>
          <td>{{this.name}}</td>
          <td class="num">{{this.qty}}</td>
          <td class="num">{{this.rate}}</td>
          <td class="num">{{this.total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Cost Summary (11 rows matching form) -->
  <div class="sec">
    <div class="sec-h"><span>{{sec.summary}} — Value Loss & Markup</span></div>
    <table>
      <tbody>
        {{#each summaryLines}}
        <tr{{#if this.isSub}} class="sub"{{/if}}{{#if this.isTot}} class="tot"{{/if}}>
          <td>{{this.label}}</td>
          <td class="num" style="width:120px">{{this.amount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    {{#if hasClosedCost}}
    <table style="margin-top:12px;">
      <thead>
        <tr>
          <th>Calculated Cost</th>
          <th>Closed Cost</th>
          <th>Variance</th>
        </tr>
      </thead>
      <tbody>
        <tr class="tot">
          <td class="num">₹ {{calculatedCost}}</td>
          <td class="num">₹ {{closedCost}}</td>
          <td class="num">{{variance}}</td>
        </tr>
      </tbody>
    </table>
    {{#if closedCostNotes}}
    <div class="callout" style="margin-top:8px;">
      <b>Notes</b>
      {{closedCostNotes}}
    </div>
    {{/if}}
    {{/if}}

    {{#if hasNotes}}
    <div class="callout" style="margin-top:8px;">
      <b>Notes</b>
      {{notes}}
    </div>
    {{/if}}
  </div>

  <div class="sign">
    <div>Prepared by / Costing</div>
    <div>Reviewed by</div>
    <div>For {{company.name}} — Authorised Signatory</div>
  </div>

  <div class="foot">
    <span>{{docNo}} · v{{version}}</span>
    <span>Cost Sheet · Internal Document</span>
  </div>
</div>
</body>
</html>
