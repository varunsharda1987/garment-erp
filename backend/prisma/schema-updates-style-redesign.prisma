// =====================================================
// 1. NEW MODEL: customer_accessories
// Add this after the customers model
// =====================================================
model customer_accessories {
  id             String    @id @default(uuid())
  customerId     String
  accessoryType  String    // "GARMENT" | "PACKAGING"
  itemName       String
  itemCategory   String?
  specification  String?
  isDefault      Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer       customers @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, accessoryType])
}

// =====================================================
// 2. NEW MODEL: style_garment_accessories
// Add this near other style-related models
// =====================================================
model style_garment_accessories {
  id                String   @id @default(uuid())
  styleId           String
  accessoryName     String
  accessoryType     String?
  specification     String?
  quantityPerPiece  Int?
  isFromCustomer    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  style             styles   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

// =====================================================
// 3. NEW MODEL: style_packaging_accessories
// Add this near other style-related models
// =====================================================
model style_packaging_accessories {
  id                String   @id @default(uuid())
  styleId           String
  itemName          String
  itemType          String?
  specification     String?
  quantityPerPack   Int?
  isFromCustomer    Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  style             styles   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@index([styleId])
}

