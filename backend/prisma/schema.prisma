/// Stores quantity slab definitions (column headers) for each processor
/// Each processor can have different slab ranges for DYEING and PRINTING
model processor_quantity_slabs {
  id             String                @id @default(uuid())
  processorId    String
  processingType String
  slabOrder      Int
  minQuantity    Decimal               @db.Decimal(10, 2)
  maxQuantity    Decimal               @db.Decimal(10, 2)
  slabLabel      String?
  isActive       Boolean               @default(true)
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      users                 @relation("quantity_slab_creator", fields: [createdById], references: [id])
  processor      suppliers             @relation("processor_quantity_slabs", fields: [processorId], references: [id], onDelete: Cascade)
  rateEntries    processor_rate_card[] @relation("rate_card_slab")

  @@unique([processorId, processingType, slabOrder])
  @@index([processorId, processingType])
  @@index([isActive])
}

/// Stores fabric processing rates from dyeing/printing mills
/// Matrix structure: greige (row) x slab (column) = rate
/// For PRINTING: also includes printingType dimension (PIGMENT, PROCIAN, DISCHARGE, PIGMENT_DISCHARGE)
model processor_rate_card {
  id                  String        @id @default(uuid())
  processorId         String
  processingType      String
  ratePerMeter        Decimal       @db.Decimal(10, 2)
  isActive            Boolean       @default(true)
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  greigeId            String?
  slabId              String?
  printingType        PrintingType?
  shrinkagePercent    Decimal?      @db.Decimal(5, 2)
  screenCostPerScreen Decimal?      @db.Decimal(10, 2)
  screenType          String?

  // Lace support (greigeId and laceId are mutually exclusive)
  laceId String? // For lace dyeing rates (greige lace reference)

  // Rate history tracking (never overwrite rates)
  effectiveFrom     DateTime  @default(now()) // When this rate became effective
  effectiveTo       DateTime? // null = currently active, set when superseded
  supersededById    String? // FK to the rate that replaced this one
  previousRateValue Decimal?  @db.Decimal(10, 2) // Quick reference to previous rate
  changeReasonCode  String? // MARKET_INCREASE, NEGOTIATION, ANNUAL_REVISION, CORRECTION
  changeNotes       String? // Additional notes about the rate change

  // Relations
  createdBy          users                        @relation("processor_rate_card_creator", fields: [createdById], references: [id])
  greige             greige_master?               @relation("greige_rate_cards", fields: [greigeId], references: [id], onDelete: Cascade)
  processor          suppliers                    @relation("processor_rate_cards", fields: [processorId], references: [id], onDelete: Cascade)
  slab               processor_quantity_slabs?    @relation("rate_card_slab", fields: [slabId], references: [id], onDelete: Cascade)
  lace               lace_master?                 @relation("lace_rate_cards", fields: [laceId], references: [id], onDelete: Cascade)
  fabricCostingItems style_costing_fabric_items[] @relation("fabric_costing_rate_card")
  laceCostingItems   style_costing_lace_items[]   @relation("lace_costing_rate_card")
  orderBomItems      order_bom_items[]            @relation("bom_item_rate_card")
  fabricWidthCads    fabric_width_cad[]           @relation("fabric_width_cad_rate_card")

  // Self-relation for rate history chain
  supersededBy processor_rate_card?  @relation("RateHistory", fields: [supersededById], references: [id])
  supersedes   processor_rate_card[] @relation("RateHistory")

  @@unique([processorId, processingType, printingType, greigeId, laceId, slabId, effectiveFrom], name: "unique_rate_card_v4")
  @@index([processorId, processingType])
  @@index([processorId, processingType, printingType])
  @@index([greigeId])
  @@index([laceId])
  @@index([slabId])
  @@index([isActive])
  @@index([processorId, processingType, effectiveFrom])
  @@index([effectiveTo])
}

/// Audit log for processor rate changes - tracks all rate modifications for history
model processor_rate_change_log {
  id             String  @id @default(uuid())
  oldRateCardId  String // FK to the rate that was superseded
  newRateCardId  String // FK to the new rate that replaced it
  processorId    String // Denormalized for efficient querying
  processorName  String // Denormalized - processor name at time of change
  processingType String // DYEING, PRINTING
  printingType   String? // For printing rates
  greigeId       String? // For greige-based rates
  greigeName     String? // Denormalized - greige name at time of change
  laceId         String? // For lace-based rates
  laceName       String? // Denormalized - lace name at time of change
  slabId         String? // Quantity slab
  slabLabel      String? // Denormalized - slab label at time of change

  previousRate  Decimal @db.Decimal(10, 2)
  newRate       Decimal @db.Decimal(10, 2)
  changeAmount  Decimal @db.Decimal(10, 2) // newRate - previousRate
  changePercent Decimal @db.Decimal(5, 2) // ((new - old) / old) * 100

  changeReasonCode String? // MARKET_INCREASE, NEGOTIATION, ANNUAL_REVISION, CORRECTION
  changeNotes      String?
  changedAt        DateTime @default(now())
  changedById      String

  // Relations
  changedBy users @relation("processor_rate_change_log_user", fields: [changedById], references: [id])

  @@index([processorId, changedAt])
  @@index([changedAt])
  @@index([greigeId])
  @@index([laceId])
}

/// Junction table: Greige to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which greige fabrics
model greige_suppliers {
  id          String        @id @default(uuid())
  greigeId    String
  supplierId  String
  isPreferred Boolean       @default(false)
  isActive    Boolean       @default(true)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  greige      greige_master @relation(fields: [greigeId], references: [id], onDelete: Cascade)
  supplier    suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([greigeId, supplierId])
  @@index([greigeId])
  @@index([supplierId])
}

/// Junction table: Fabric to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which finished fabrics
model fabric_suppliers {
  id          String        @id @default(uuid())
  fabricId    String
  supplierId  String
  isPreferred Boolean       @default(false)
  isActive    Boolean       @default(true)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  fabric      fabric_master @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  supplier    suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([fabricId, supplierId])
  @@index([fabricId])
  @@index([supplierId])
}

/// Junction table: Material to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which materials
model material_suppliers {
  id            String    @id @default(uuid())
  materialId    String
  supplierId    String
  isPreferred   Boolean   @default(false)
  isActive      Boolean   @default(true)
  notes         String?
  supplierPrice Decimal?  @db.Decimal(15, 2)
  leadTimeDays  Int?
  moq           Decimal?  @db.Decimal(15, 4)
  moqUnit       String?
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  material      materials @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier      suppliers @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([materialId, supplierId])
  @@index([materialId])
  @@index([supplierId])
}

