  // ==========================================
  closedCost                              Decimal?                        @map("closed_cost") @db.Decimal(15, 2)
  closedCostCurrency                      String?                         @default("INR") @map("closed_cost_currency")
  closedCostNotes                         String?                         @map("closed_cost_notes")
  closedCostApprovedAt                    DateTime?                       @map("closed_cost_approved_at")
  closedCostApprovedById                  String?                         @map("closed_cost_approved_by_id")
  costVariancePercent                     Decimal?                        @db.Decimal(5, 2)
  lockedForOrders                         Boolean                         @default(false)
  supersededById                          String?
  version                                 Int                             @default(1)
  versionDate                             DateTime                        @default(now())
  versionReason                           String?
  approvalStatus                          CostSheetApprovalStatus         @default(PENDING)
  rejectionNotes                          String?
  widthCombinationDescription             String?                         @map("width_combination_description")
  widthCombinationHash                    String?                         @map("width_combination_hash")
  orderId                                 String?
  orderItemId                             String?
  // ==========================================
  // NEW: Purpose field for mode separation
  // ==========================================
  purpose                                 CostSheetPurpose                @default(COSTING) @map("purpose")
  // ==========================================
  // NEW: Copy tracking (like CAD Planning)
  // ==========================================
  copiedFromCostingId                     String?                         @map("copied_from_costing_id")
  // ==========================================
  // NEW: Budget fields (from COSTING mode)
  // ==========================================
  fabricBudget                            Decimal?                        @map("fabric_budget") @db.Decimal(10, 2)
  trimsBudget                             Decimal?                        @map("trims_budget") @db.Decimal(10, 2)
  cmtBudget                               Decimal?                        @map("cmt_budget") @db.Decimal(10, 2)
  embroideryBudget                        Decimal?                        @map("embroidery_budget") @db.Decimal(10, 2)
  accessoriesBudget                       Decimal?                        @map("accessories_budget") @db.Decimal(10, 2)
  totalBudget                             Decimal?                        @map("total_budget") @db.Decimal(10, 2)
  // ==========================================
  // NEW: Buffer percentages (editable in PROCUREMENT_PRODUCTION)
  // ==========================================
  fabricBufferPercent                     Decimal?                        @default(5.0) @map("fabric_buffer_percent") @db.Decimal(5, 2)
  trimsBufferPercent                      Decimal?                        @default(10.0) @map("trims_buffer_percent") @db.Decimal(5, 2)
  cmtBufferPercent                        Decimal?                        @default(5.0) @map("cmt_buffer_percent") @db.Decimal(5, 2)
  embroideryBufferPercent                 Decimal?                        @default(8.0) @map("embroidery_buffer_percent") @db.Decimal(5, 2)
  accessoriesBufferPercent                Decimal?                        @default(10.0) @map("accessories_buffer_percent") @db.Decimal(5, 2)
  // ==========================================
  // NEW: Actual costs (filled during procurement)
  // ==========================================
  fabricActual                            Decimal?                        @map("fabric_actual") @db.Decimal(10, 2)
  trimsActual                             Decimal?                        @map("trims_actual") @db.Decimal(10, 2)
  cmtActual                               Decimal?                        @map("cmt_actual") @db.Decimal(10, 2)
  embroideryActual                        Decimal?                        @map("embroidery_actual") @db.Decimal(10, 2)
  accessoriesActual                       Decimal?                        @map("accessories_actual") @db.Decimal(10, 2)
  totalActual                             Decimal?                        @map("total_actual") @db.Decimal(10, 2)
  // ==========================================
  // NEW: Variance tracking (auto-calculated)
  // ==========================================
  fabricVariance                          Decimal?                        @map("fabric_variance") @db.Decimal(10, 2)
  fabricVariancePercent                   Decimal?                        @map("fabric_variance_percent") @db.Decimal(5, 2)
  trimsVariance                           Decimal?                        @map("trims_variance") @db.Decimal(10, 2)
  trimsVariancePercent                    Decimal?                        @map("trims_variance_percent") @db.Decimal(5, 2)
  cmtVariance                             Decimal?                        @map("cmt_variance") @db.Decimal(10, 2)
  cmtVariancePercent                      Decimal?                        @map("cmt_variance_percent") @db.Decimal(5, 2)
  embroideryVariance                      Decimal?                        @map("embroidery_variance") @db.Decimal(10, 2)
  embroideryVariancePercent               Decimal?                        @map("embroidery_variance_percent") @db.Decimal(5, 2)
  accessoriesVariance                     Decimal?                        @map("accessories_variance") @db.Decimal(10, 2)
  accessoriesVariancePercent              Decimal?                        @map("accessories_variance_percent") @db.Decimal(5, 2)
  totalVariance                           Decimal?                        @map("total_variance") @db.Decimal(10, 2)
  totalVariancePercent                    Decimal?                        @map("total_variance_percent") @db.Decimal(5, 2)
  // ==========================================
  // NEW: Variance approval workflow
  // ==========================================
  varianceStatus                          CostSheetVarianceStatus?        @default(PENDING) @map("variance_status")
  varianceApprovedBy                      String?                         @map("variance_approved_by")
  varianceApprovedAt                      DateTime?                       @map("variance_approved_at")
  varianceNotes                           String?                         @map("variance_notes") @db.Text
  cadCostingRecords                       fabric_width_cad[]              @relation("cad_style_costing")
  orderBoms                               order_bom[]                     @relation("order_bom_source_costing")
  order_item_costings                     order_item_costing[]            @relation("base_style_costing")
  users_style_costing_approvedByIdTousers users?                          @relation("style_costing_approvedByIdTousers", fields: [approvedById], references: [id])
  users_style_costing_createdByIdTousers  users                           @relation("style_costing_createdByIdTousers", fields: [createdById], references: [id])
  order                                   orders?                         @relation("order_level_costing", fields: [orderId], references: [id])
  orderItem                               order_items?                    @relation("order_item_level_costing", fields: [orderItemId], references: [id])
  styles                                  styles                          @relation(fields: [styleId], references: [id], onDelete: Cascade)
  supersededBy                            style_costing?                  @relation("CostSheetVersions", fields: [supersededById], references: [id])
  olderVersions                           style_costing[]                 @relation("CostSheetVersions")
  copiedFromCosting                       style_costing?                  @relation("CostSheetLineage", fields: [copiedFromCostingId], references: [id], onDelete: SetNull)
  copiedToCosting                         style_costing[]                 @relation("CostSheetLineage")
  varianceApprovedByUser                  users?                          @relation("VarianceApprovals", fields: [varianceApprovedBy], references: [id])
  fabricItems                             style_costing_fabric_items[]
  laceItems                               style_costing_lace_items[]
  threadItems                             style_costing_thread_items[] // Thread costing items
  trimItems                               style_costing_trim_items[] // Trim costing items (relational)
  accessoryItems                          style_costing_accessory_items[] // Accessory costing items (relational)
  costSheetPoGenerations                  cost_sheet_po_generation[]

  @@unique([styleId, purpose, version])
  @@index([styleId, version])
  @@index([supersededById])
  @@index([lockedForOrders])
  @@index([approvalStatus])
  @@index([orderId])
  @@index([orderItemId])
  @@index([widthCombinationHash])
  @@index([purpose])
  @@index([copiedFromCostingId])
  @@index([varianceStatus])
}

/// Cost Sheet PO Generation Tracking
/// Links cost sheets to generated Purchase Orders
model cost_sheet_po_generation {
  id                 String   @id @default(uuid())
  costSheetId        String // FK to style_costing
  totalOrderQuantity Int // User-entered total pieces for PO calculation
  generatedAt        DateTime @default(now())
  generatedById      String // FK to users

  // Generated PO references (one PO per category per generation)
  fabricPOId     String? @unique
  greigePOId     String? @unique
  processingPOId String? @unique
  trimsPOId      String? @unique

  // Lace PO references
  lacePOId           String? @unique
  greigeLacePOId     String? @unique
  laceProcessingPOId String? @unique

  // Generation status
  status String  @default("GENERATED") // GENERATED, PARTIALLY_ORDERED, COMPLETED, CANCELLED
  notes  String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  costSheet       style_costing     @relation(fields: [costSheetId], references: [id])
  generatedBy     users             @relation("cost_sheet_po_gen_user", fields: [generatedById], references: [id])
  purchaseOrders  purchase_orders[]
  po_source_links po_source_links[]

  @@index([costSheetId])
  @@index([generatedById])
  @@index([status])
  @@map("cost_sheet_po_generation")
}

