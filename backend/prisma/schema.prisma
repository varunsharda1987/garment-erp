generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id         String   @id
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  timestamp  DateTime @default(now())
  users      users?   @relation(fields: [userId], references: [id])

  @@index([entityType])
  @@index([timestamp])
  @@index([userId])
}

model material_master {
  id                  Int                         @id @default(autoincrement())
  materialType        MaterialType
  code                String                      @unique
  name                String
  description         String?
  pricePerUnit        Decimal?                    @db.Decimal(15, 2)
  pricePerMeter       Decimal?                    @db.Decimal(15, 2)
  pricePerPiece       Decimal?                    @db.Decimal(15, 2)
  pricePerKg          Decimal?                    @db.Decimal(15, 2)
  pricePerGross       Decimal?                    @db.Decimal(15, 2)
  unit                String?
  currencyId          String?
  specifications      Json?
  isActive            Boolean                     @default(true)
  hsnCode             String?
  gstRate             Decimal?                    @db.Decimal(5, 2)
  createdById         String
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  legacyLaceId        String?                     @unique
  legacyButtonId      String?                     @unique
  legacyThreadId      String?                     @unique
  legacyZipperId      String?                     @unique
  legacyElasticId     String?                     @unique
  legacyLabelId       String?                     @unique
  legacyPackagingId   String?                     @unique
  legacyMachinePartId String?                     @unique
  legacyHookEyeId     String?                     @unique
  legacySnapButtonId  String?                     @unique
  legacyBuckleId      String?                     @unique
  legacyBeltId        String?                     @unique
  legacyVelcroId      String?                     @unique
  legacyDrawstringId  String?                     @unique
  legacyRibbonId      String?                     @unique
  legacySequinId      String?                     @unique
  legacyBeadId        String?                     @unique
  legacyMotifId       String?                     @unique
  legacyInterliningId String?                     @unique
  legacyPaddingId     String?                     @unique
  currency            currencies?                 @relation(fields: [currencyId], references: [id])
  createdBy           users                       @relation("material_master_createdBy", fields: [createdById], references: [id])
  suppliers           material_supplier_mapping[]

  @@index([materialType])
  @@index([code])
  @@index([isActive])
  @@index([createdById])
  @@map("material_master")
}

model material_supplier_mapping {
  id               Int             @id @default(autoincrement())
  materialId       Int
  supplierId       String
  supplierCode     String?
  supplierName     String?
  supplierPrice    Decimal?        @db.Decimal(15, 2)
  leadTimeDays     Int?
  moq              Decimal?        @db.Decimal(15, 4)
  moqUnit          String?
  isPrimary        Boolean         @default(false)
  isActive         Boolean         @default(true)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  lastPurchaseDate DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  material         material_master @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier         suppliers       @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([materialId, supplierId])
  @@index([supplierId])
  @@index([isPrimary])
  @@index([isActive])
  @@map("material_supplier_mapping")
}

model order_bom {
  id                                  String                  @id @default(uuid())
  orderId                             String
  orderItemId                         String?
  styleId                             String
  version                             Int                     @default(1)
  isActive                            Boolean                 @default(true)
  status                              OrderBOMStatus          @default(DRAFT)
  totalMaterialCost                   Decimal?                @db.Decimal(15, 2)
  sourceCostSheetId                   String?
  copiedFromOrderId                   String?
  createdById                         String
  approvedById                        String?
  approvedAt                          DateTime?
  createdAt                           DateTime                @default(now())
  updatedAt                           DateTime                @updatedAt
  material_requirements               material_requirements[]
  users_order_bom_approvedByIdTousers users?                  @relation("order_bom_approvedByIdTousers", fields: [approvedById], references: [id])
  copiedFromOrder                     orders?                 @relation("order_bom_copied_from", fields: [copiedFromOrderId], references: [id])
  users_order_bom_createdByIdTousers  users                   @relation("order_bom_createdByIdTousers", fields: [createdById], references: [id])
  order                               orders                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem                           order_items?            @relation(fields: [orderItemId], references: [id])
  sourceCostSheet                     style_costing?          @relation("order_bom_source_costing", fields: [sourceCostSheetId], references: [id])
  style                               styles                  @relation(fields: [styleId], references: [id])
  items                               order_bom_items[]

  @@unique([orderId, styleId, version])
  @@index([orderId])
  @@index([styleId])
  @@index([status])
}

model order_bom_items {
  id                 String   @id @default(uuid())
  orderBomId         String
  materialType       String
  materialId         String?
  buttonId           String?
  threadId           String?
  zipperId           String?
  laceId             String?
  elasticId          String?
  labelId            String?
  packagingId        String?
  fabricId           String?
  quantityPerGarment Decimal  @db.Decimal(10, 4)
  orderQuantity      Int
  totalQuantity      Decimal  @db.Decimal(15, 4)
  wastagePercent     Decimal? @db.Decimal(5, 2)
  totalWithWastage   Decimal? @db.Decimal(15, 4)
  unit               String
  unitPrice          Decimal  @db.Decimal(10, 2)
  totalCost          Decimal  @db.Decimal(15, 2)
  componentName      String?
  usageCategory      String?
  notes              String?
  sortOrder          Int      @default(0)
  cadAverageSnapshot Decimal? @db.Decimal(10, 4)
  fabricWidthInches  Decimal? @db.Decimal(10, 2)
  selectedCadId      String?
  sourcingStrategy   String? // STOCK_REUSE | READY_FABRIC | GREIGE_PROCESSED

  // NEW: Sourcing Strategy fields for GREIGE_PROCESSED workflow
  greigeId       String? // FK to greige_master (for greige variant)
  processorId    String? // FK to suppliers (for processor)
  greigeCost     Decimal? @db.Decimal(12, 2)
  processingCost Decimal? @db.Decimal(12, 2)
  rateCardId     String? // FK to processor_rate_card
  colorName      String? // Dye/processing color (from fabric costing, differentiates same greige)

  button_master    button_master?    @relation(fields: [buttonId], references: [id])
  elastic_master   elastic_master?   @relation(fields: [elasticId], references: [id])
  fabric_master    fabric_master?    @relation(fields: [fabricId], references: [id])
  label_master     label_master?     @relation(fields: [labelId], references: [id])
  lace_master      lace_master?      @relation(fields: [laceId], references: [id])
  material         materials?        @relation(fields: [materialId], references: [id])
  orderBom         order_bom         @relation(fields: [orderBomId], references: [id], onDelete: Cascade)
  packaging_master packaging_master? @relation(fields: [packagingId], references: [id])
  selectedCad      fabric_width_cad? @relation("order_bom_item_cad", fields: [selectedCadId], references: [id])
  thread_master    thread_master?    @relation(fields: [threadId], references: [id])
  zipper_master    zipper_master?    @relation(fields: [zipperId], references: [id])

  // NEW: Relations for sourcing strategy fields
  greige    greige_master?       @relation("bom_item_greige", fields: [greigeId], references: [id])
  processor suppliers?           @relation("bom_item_processor", fields: [processorId], references: [id])
  rateCard  processor_rate_card? @relation("bom_item_rate_card", fields: [rateCardId], references: [id])

  @@index([orderBomId])
  @@index([materialType])
  @@index([greigeId])
  @@index([processorId])
}

model color_master {
  id                        String                      @id @default(cuid())
  colorCode                 String
  colorName                 String
  hexCode                   String?
  colorFamily               String?
  description               String?
  isActive                  Boolean                     @default(true)
  sortOrder                 Int                         @default(0)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  color_options             color_options[]
  fabric_master             fabric_master[]
  fabricCadBatchGroups      fabric_width_cad[]          @relation("fabric_cad_batch_color")
  lab_dips                  lab_dips[]
  // Thread module relations
  thread_master             thread_master[]
  order_thread_requirements order_thread_requirements[]

  @@index([colorFamily])
  @@index([colorName])
  @@index([isActive])
}

model season_master {
  id         String        @id @default(cuid())
  code       String        @unique // "SS26", "AW26"
  name       String // "Spring/Summer 2026"
  year       Int // 2026
  seasonType SeasonType // SS or AW
  sortOrder  Int           @default(0) // For chronological sorting
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  styles     styles[]
  moodBoards mood_boards[]

  @@index([year, seasonType])
  @@index([isActive])
  @@index([sortOrder])
}

model color_options {
  id                           String                         @id
  styleId                      String
  colorName                    String
  colorCode                    String?
  sortOrder                    Int                            @default(0)
  isActive                     Boolean                        @default(true)
  colorMasterId                String?
  asn_skus                     asn_skus[]
  carton_skus                  carton_skus[]
  color_master                 color_master?                  @relation(fields: [colorMasterId], references: [id])
  styles                       styles                         @relation(fields: [styleId], references: [id], onDelete: Cascade)
  cutting_batch_skus           cutting_batch_skus[]
  cutting_lay_skus             cutting_lay_skus[]
  delivery_note_items          delivery_note_items[]
  finished_goods_stock         finished_goods_stock[]
  finishing_issue_skus         finishing_issue_skus[]
  finishing_output_skus        finishing_output_skus[]
  garment_physical_tests       garment_physical_tests[]
  order_item_breakup           order_item_breakup[]
  polybag_skus                 polybag_skus[]
  sample_colorways             sample_colorways[]
  sample_size_sets             sample_size_sets[]
  stage_receipt_skus           stage_receipt_skus[]
  stitching_issue_skus         stitching_issue_skus[]
  stitching_output_skus        stitching_output_skus[]
  style_variants               style_variants[]
  transfer_slip_skus           transfer_slip_skus[]
  work_order_breakup           work_order_breakup[]
  stock_production_order_items stock_production_order_items[]
  sale_order_items             sale_order_items[]

  @@index([styleId])
  @@index([colorMasterId])
}

model customers {
  id                             String                           @id @default(uuid())
  code                           String
  name                           String
  type                           CustomerType
  category                       CustomerCategory
  businessType                   BusinessType                     @default(B2B)
  market                         MarketType                       @default(DOMESTIC)
  contactPerson                  String?
  email                          String?
  phone                          String?
  billingAddress                 String?
  shippingAddress                String?
  gstNumber                      String?
  creditLimit                    Decimal?                         @db.Decimal(10, 2)
  creditDays                     Int?
  paymentTermsId                 String?
  currencyCode                   String?
  defaultAccessoriesConfig       Json?
  isActive                       Boolean                          @default(true)
  createdById                    String
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  brandNames                     String?
  categories                     String?
  buyerApprovesGPT               Boolean                          @default(false)
  defaultTestingLabId            String?
  fptBlocksProduction            Boolean                          @default(false)
  fptTemplateId                  String?
  gptBlocksShipment              Boolean                          @default(true)
  gptTemplateId                  String?
  requiresFPT                    Boolean                          @default(false)
  requiresGPT                    Boolean                          @default(false)
  buyerApprovesFPT               Boolean                          @default(false)
  billingName                    String?
  billingCityId                  String?
  billingPincode                 String?
  billingStateId                 String?
  shippingCityId                 String?
  shippingPincode                String?
  shippingStateId                String?
  brand_categories               brand_categories[]
  customer_accessories_presets   customer_accessories_presets[]
  customer_gst_numbers           customer_gst_numbers[]
  customer_size_category_presets customer_size_category_presets[]
  billingCity                    indian_cities?                   @relation("CustomerBillingCity", fields: [billingCityId], references: [id])
  billingState                   indian_states?                   @relation("CustomerBillingState", fields: [billingStateId], references: [id])
  users                          users                            @relation(fields: [createdById], references: [id])
  currencies                     currencies?                      @relation(fields: [currencyCode], references: [currencyCode])
  defaultLab                     testing_labs?                    @relation(fields: [defaultTestingLabId], references: [id])
  fptTemplate                    test_templates?                  @relation("CustomerFPTTemplate", fields: [fptTemplateId], references: [id])
  gptTemplate                    test_templates?                  @relation("CustomerGPTTemplate", fields: [gptTemplateId], references: [id])
  payment_terms                  payment_terms?                   @relation(fields: [paymentTermsId], references: [id])
  shippingCity                   indian_cities?                   @relation("CustomerShippingCity", fields: [shippingCityId], references: [id])
  shippingState                  indian_states?                   @relation("CustomerShippingState", fields: [shippingStateId], references: [id])
  agentId                        String?
  agentCommissionPercent         Decimal?                         @db.Decimal(5, 2)
  agencyId                       String?
  agent                          agents?                          @relation(fields: [agentId], references: [id])
  agency                         agencies?                        @relation(fields: [agencyId], references: [id])
  delivery_notes                 delivery_notes[]
  fabric_physical_tests          fabric_physical_tests[]
  garment_physical_tests         garment_physical_tests[]
  invoices                       invoices[]
  labels                         label_master[]
  orders                         orders[]
  packaging                      packaging_master[]
  quotations                     quotations[]
  samples                        samples[]
  credit_notes                   credit_notes[]
  sale_orders                    sale_orders[]

  @@index([code])
  @@index([name])
  @@index([billingName])
  @@index([brandNames])
  @@index([isActive])
  @@index([type])
  @@index([paymentTermsId])
  @@index([currencyCode])
  @@index([fptTemplateId])
  @@index([gptTemplateId])
  @@index([defaultTestingLabId])
  @@index([billingStateId])
  @@index([shippingStateId])
  @@index([agentId])
  @@index([agencyId])
}

model agencies {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  agents    agents[]
  customers customers[]

  @@index([code])
  @@index([name])
  @@index([isActive])
}

model agents {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  phone     String?
  email     String?
  address   String?
  agencyId  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  agency    agencies?   @relation(fields: [agencyId], references: [id])
  customers customers[]

  @@index([code])
  @@index([name])
  @@index([isActive])
  @@index([agencyId])
}

model brand_categories {
  id                String                   @id @default(uuid())
  customerId        String
  brandName         String
  category          String
  subCategory       String?
  subSubCategory    String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  productCategoryId String?
  customer          customers                @relation(fields: [customerId], references: [id])
  productCategory   product_category_master? @relation(fields: [productCategoryId], references: [id])
  labels            label_master[]
  packaging         packaging_master[]
  styles            styles[]

  @@unique([customerId, brandName, category, subCategory, subSubCategory])
  @@index([customerId])
  @@index([brandName])
  @@index([productCategoryId])
}

model customer_gst_numbers {
  id             String         @id @default(uuid())
  customerId     String
  stateName      String
  stateCode      String
  gstNumber      String
  billingAddress String?
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  stateId        String?
  billingCityId  String?
  billingPincode String?
  billing_city   indian_cities? @relation("customer_gst_billing_city", fields: [billingCityId], references: [id])
  customer       customers      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  state          indian_states? @relation(fields: [stateId], references: [id])

  @@unique([customerId, gstNumber])
  @@index([customerId])
  @@index([gstNumber])
  @@index([stateId])
  @@index([billingCityId])
}

model supplier_gst_numbers {
  id             String         @id @default(uuid())
  supplierId     String
  stateId        String?
  stateName      String
  stateCode      String
  gstNumber      String
  billingAddress String?
  isPrimary      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  billingCityId  String?
  billingPincode String?
  billing_city   indian_cities? @relation("supplier_gst_billing_city", fields: [billingCityId], references: [id])
  state          indian_states? @relation(fields: [stateId], references: [id])
  supplier       suppliers      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, gstNumber])
  @@index([supplierId])
  @@index([gstNumber])
  @@index([stateId])
  @@index([billingCityId])
}

model indian_states {
  id                         String                 @id @default(uuid())
  stateName                  String                 @unique
  stateCode                  String                 @unique
  stateType                  StateType
  sortOrder                  Int                    @default(0)
  isActive                   Boolean                @default(true)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  customer_gst_numbers       customer_gst_numbers[]
  customers_billing          customers[]            @relation("CustomerBillingState")
  customers_shipping         customers[]            @relation("CustomerShippingState")
  cities                     indian_cities[]
  invoices_place_of_supply   invoices[]             @relation("InvoicePlaceOfSupply")
  quotations_place_of_supply quotations[]           @relation("QuotationPlaceOfSupply")
  supplier_gst_numbers       supplier_gst_numbers[]
  suppliers_billing          suppliers[]            @relation("supplier_billing_state")
  suppliers_shipping         suppliers[]            @relation("supplier_shipping_state")

  @@index([stateCode])
  @@index([isActive])
}

model indian_cities {
  id                   String                 @id @default(uuid())
  stateId              String
  cityName             String
  tier                 CityTier
  sortOrder            Int                    @default(0)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  customer_gst_billing customer_gst_numbers[] @relation("customer_gst_billing_city")
  customers_billing    customers[]            @relation("CustomerBillingCity")
  customers_shipping   customers[]            @relation("CustomerShippingCity")
  state                indian_states          @relation(fields: [stateId], references: [id])
  supplier_gst_billing supplier_gst_numbers[] @relation("supplier_gst_billing_city")
  suppliers_billing    suppliers[]            @relation("supplier_billing_city")
  suppliers_shipping   suppliers[]            @relation("supplier_shipping_city")

  @@unique([stateId, cityName])
  @@index([stateId])
  @@index([isActive])
}

model customer_accessories_presets {
  id          String                              @id @default(uuid())
  customerId  String
  presetName  String
  description String?
  isDefault   Boolean                             @default(false)
  isActive    Boolean                             @default(true)
  createdAt   DateTime                            @default(now())
  updatedAt   DateTime                            @updatedAt
  items       customer_accessories_preset_items[]
  customer    customers                           @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, presetName])
  @@index([customerId])
  @@index([isDefault])
}

model customer_accessories_preset_items {
  id              String                       @id @default(uuid())
  presetId        String
  materialType    MaterialType
  materialId      String?
  quantity        Decimal?                     @db.Decimal(10, 3)
  usageCategory   String?
  sortOrder       Int                          @default(0)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  componentName   String?
  extraPercentage Decimal?                     @default(5) @db.Decimal(5, 2)
  labelId         String?
  label           label_master?                @relation(fields: [labelId], references: [id], onDelete: Restrict)
  material        materials?                   @relation("PresetMaterials", fields: [materialId], references: [id], onDelete: Restrict)
  preset          customer_accessories_presets @relation(fields: [presetId], references: [id], onDelete: Cascade)

  @@index([presetId])
  @@index([materialId])
  @@index([labelId])
  @@index([materialType])
}

model customer_size_category_presets {
  id             String          @id @default(uuid())
  customerId     String
  presetName     String
  description    String?
  sizeCategoryId String
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       customers       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sizeCategory   size_categories @relation(fields: [sizeCategoryId], references: [id])

  @@unique([customerId, presetName])
  @@index([customerId])
  @@index([sizeCategoryId])
  @@index([isDefault])
}

model delivery_note_items {
  id               String            @id
  deliveryNoteId   String
  orderItemId      String?
  saleOrderItemId  String?
  styleId          String
  colorId          String
  sizeId           String
  variantId        String?
  quantity         Int
  cartons          Int?
  remarks          String?
  color_options    color_options     @relation(fields: [colorId], references: [id])
  delivery_notes   delivery_notes    @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  order_items      order_items?      @relation(fields: [orderItemId], references: [id])
  sale_order_items sale_order_items? @relation(fields: [saleOrderItemId], references: [id])
  size_options     size_options      @relation(fields: [sizeId], references: [id])
  styles           styles            @relation(fields: [styleId], references: [id])
  style_variants   style_variants?   @relation(fields: [variantId], references: [id])

  @@index([deliveryNoteId])
  @@index([orderItemId])
  @@index([saleOrderItemId])
}

model delivery_notes {
  id                  String                @id
  deliveryNumber      String
  orderId             String?
  saleOrderId         String?
  customerId          String
  deliveryDate        DateTime              @default(now())
  vehicleNumber       String?
  driverName          String?
  driverPhone         String?
  status              DeliveryStatus        @default(PENDING)
  remarks             String?
  createdById         String
  createdAt           DateTime              @default(now())
  isActive            Boolean               @default(true)
  delivery_note_items delivery_note_items[]
  users               users                 @relation(fields: [createdById], references: [id])
  customers           customers             @relation(fields: [customerId], references: [id])
  orders              orders?               @relation(fields: [orderId], references: [id])
  sale_orders         sale_orders?          @relation(fields: [saleOrderId], references: [id])
  delivery_notes_ext  delivery_notes_ext?

  @@index([deliveryNumber])
  @@index([orderId])
  @@index([saleOrderId])
  @@index([createdById])
  @@index([customerId])
}

model finished_goods_stock {
  id                   String                 @id
  styleId              String
  colorId              String
  sizeId               String
  variantId            String?
  quantity             Int
  locationId           String
  workOrderId          String?
  receivedDate         DateTime               @default(now())
  lastUpdated          DateTime               @default(now())
  color_options        color_options          @relation(fields: [colorId], references: [id])
  locations            locations              @relation(fields: [locationId], references: [id])
  size_options         size_options           @relation(fields: [sizeId], references: [id])
  styles               styles                 @relation(fields: [styleId], references: [id])
  style_variants       style_variants?        @relation(fields: [variantId], references: [id])
  work_orders          work_orders?           @relation(fields: [workOrderId], references: [id])
  fg_stock_allocations fg_stock_allocations[]

  @@unique([styleId, colorId, sizeId, locationId])
  @@index([locationId])
  @@index([styleId])
}

model goods_receiving_notes {
  id                                              String            @id
  grnNumber                                       String            @unique
  poId                                            String
  supplierId                                      String
  warehouseId                                     String?
  receivingDate                                   DateTime          @default(now())
  invoiceNumber                                   String?
  invoiceDate                                     DateTime?
  status                                          GRNStatus         @default(PENDING_QC)
  remarks                                         String?
  receivedById                                    String
  approvedById                                    String?
  createdAt                                       DateTime          @default(now())
  users_goods_receiving_notes_approvedByIdTousers users?            @relation("goods_receiving_notes_approvedByIdTousers", fields: [approvedById], references: [id])
