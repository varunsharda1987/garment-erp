{
  "permissions": {
    "allow": [
      "Bash(pm2 list)",
      "Bash(pm2 ls)",
      "Bash(pm2 status)",
      "Bash(pm2 jlist)",
      "Bash(pm2 prettylist)",
      "Bash(pm2 describe *)",
      "Bash(pm2 show *)",
      "Bash(pm2 pid *)",
      "Bash(pm2 logs *)",
      "Bash(npm run ship:status)",
      "Bash(npm run ship:wait)",
      "Bash(npm run ship:wait *)",
      "mcp__playwright__browser_snapshot",
      "mcp__playwright__browser_navigate",
      "mcp__playwright__browser_take_screenshot",
      "mcp__playwright__browser_wait_for",
      "mcp__playwright__browser_console_messages",
      "mcp__playwright__browser_network_requests",
      "mcp__playwright__browser_tabs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/NEW/garment-erp/scripts/hooks/claude-guard.js\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the shared-folder guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/NEW/garment-erp/scripts/hooks/session-claims.js\" record",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/NEW/garment-erp/scripts/hooks/notices.js\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/NEW/garment-erp/scripts/hooks/notices.js\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/NEW/garment-erp/scripts/hooks/session-claims.js\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
