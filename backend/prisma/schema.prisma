/// Style Costing Thread Items - Thread items in cost sheets (default ₹4 per garment, editable)
model style_costing_thread_items {
  id                  String               @id @default(uuid())
  costingId           String
  threadId            String? // Optional: can add generic thread without specific master
  threadName          String
  ply                 ThreadPly?
  materialComposition ThreadMaterial?
  colorName           String?
  packagingType       ThreadPackagingType?

  // Costing (DEFAULT ₹4, but editable)
  costPerGarment Decimal @default(4.00) @db.Decimal(10, 2)
  totalCost      Decimal @db.Decimal(10, 2) // = costPerGarment (no qty multiplier for flat cost)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costing style_costing  @relation(fields: [costingId], references: [id], onDelete: Cascade)
  thread  thread_master? @relation(fields: [threadId], references: [id])

  @@index([costingId])
  @@index([threadId])
}

/// Order Thread Requirements - Order-level thread requirements (multi-line per order)
model order_thread_requirements {
  id       String @id @default(uuid())
  orderId  String
  threadId String

  // Attributes (snapshot at order time)
  ply                 ThreadPly
  materialComposition ThreadMaterial
  colorId             String
  colorName           String // Snapshot for display
  packagingType       ThreadPackagingType

  // Quantity entry (user enters ONE of these)
  inputType    ThreadQuantityInput // UNITS | BOXES
  unitsOrdered Decimal?            @db.Decimal(10, 2)
  boxesOrdered Decimal?            @db.Decimal(10, 2)

  // Auto-calculated conversions
  totalUnits  Decimal @db.Decimal(10, 2)
  totalBoxes  Decimal @db.Decimal(10, 2)
  totalMeters Decimal @db.Decimal(10, 2)

  // Procurement pricing (actual vendor cost, not ₹4 flat)
  unitPrice Decimal? @db.Decimal(10, 2)
  totalCost Decimal? @db.Decimal(10, 2)

  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order       orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  thread      thread_master @relation(fields: [threadId], references: [id])
  colorMaster color_master  @relation(fields: [colorId], references: [id])

  @@index([orderId])
  @@index([threadId])
}

