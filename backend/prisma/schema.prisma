/// Sample Measurements - Track measurements for FIT/PP/Size Set samples
model sample_measurements {
  id               String        @id @default(uuid())
  sampleId         String
  sizeId           String?
  measurementPoint String
  specValue        Decimal       @db.Decimal(10, 2)
  actualValue      Decimal?      @db.Decimal(10, 2)
  tolerance        Decimal       @db.Decimal(5, 2)
  status           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sample           samples       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  size             size_options? @relation(fields: [sizeId], references: [id])

  @@index([sampleId])
}

/// Sample Colorways - For PP samples with multiple colorways
model sample_colorways {
  id        String        @id @default(uuid())
  sampleId  String
  colorId   String
  sizeId    String?
  fabricLot String?
  qtySent   Int           @default(1)
  status    String        @default("PENDING")
  color     color_options @relation(fields: [colorId], references: [id])
  sample    samples       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  size      size_options? @relation(fields: [sizeId], references: [id])

  @@index([sampleId])
}

/// Sample Size Set - For Size Set samples with jumping sizes
model sample_size_sets {
  id       String        @id @default(uuid())
  sampleId String
  sizeId   String
  colorId  String
  qty      Int           @default(1)
  status   String        @default("PENDING")
  color    color_options @relation(fields: [colorId], references: [id])
  sample   samples       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  size     size_options  @relation(fields: [sizeId], references: [id])

  @@unique([sampleId, sizeId, colorId])
  @@index([sampleId])
}

/// Cutting Batch - Track cutting batches per work order
model cutting_batches {
  id                         String                       @id @default(uuid())
  batchNumber                String                       @unique
  workOrderId                String
  componentId                String?
  cuttingDate                DateTime
  fabricStockId              String
  actualFabricWidth          Decimal                      @db.Decimal(10, 2)
  cadAverageUsed             Decimal                      @db.Decimal(10, 4)
  cadWidthUsed               Decimal                      @db.Decimal(10, 2)
  layersPerLay               Int
  numberOfLays               Int
  fabricConsumed             Decimal                      @db.Decimal(10, 2)
  cuttingTableId             String?
  cuttingOperatorId          String?
  status                     CuttingBatchStatus           @default(PENDING)
  startedAt                  DateTime?
  completedAt                DateTime?
  actualAverage              Decimal?                     @db.Decimal(10, 4)
  varianceFromCad            Decimal?                     @db.Decimal(10, 4)
  variancePercent            Decimal?                     @db.Decimal(5, 2)
  wastageMeters              Decimal?                     @db.Decimal(10, 2)
  wastagePercent             Decimal?                     @db.Decimal(5, 2)
  fabricIssued               Decimal?                     @db.Decimal(10, 2)
  fabricReturned             Decimal?                     @db.Decimal(10, 2)
  actualConsumption          Decimal?                     @db.Decimal(10, 2)
  returnChallanId            String?                      @unique
  remarks                    String?
  createdById                String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  isActive                   Boolean                      @default(true)
  defects                    cutting_batch_defects[]
  lays                       cutting_lays[]
  skuOutputs                 cutting_batch_skus[]
  component                  style_components?            @relation(fields: [componentId], references: [id])
  createdBy                  users                        @relation("CuttingBatchCreator", fields: [createdById], references: [id])
  cuttingOperator            users?                       @relation("CuttingOperator", fields: [cuttingOperatorId], references: [id])
  fabricStock                fabric_stock                 @relation(fields: [fabricStockId], references: [id])
  returnChallan              challans?                    @relation("CuttingReturnChallan", fields: [returnChallanId], references: [id])
  workOrder                  work_orders                  @relation(fields: [workOrderId], references: [id])
  transferSlips              transfer_slips[]
  additionalFabrics          cutting_batch_fabrics[]
  external_process_send_outs external_process_send_outs[] @relation("ExternalProcessCuttingBatch")
  rejectDispositions         reject_dispositions[]        @relation("reject_disposition_cutting")

  @@index([workOrderId])
  @@index([componentId])
  @@index([fabricStockId])
  @@index([status])
  @@index([cuttingDate])
  // Performance: composite index for work order cutting queries
  @@index([workOrderId, status])
}

/// Cutting Batch Fabrics - junction table for multi-fabric batches
model cutting_batch_fabrics {
  id                String                @id @default(uuid())
  batchId           String
  fabricStockId     String
  cadAvgUsed        Decimal?              @db.Decimal(10, 4)
  cadWidthUsed      Decimal?              @db.Decimal(10, 2)
  actualWidth       Decimal?              @db.Decimal(10, 2)
  fabricConsumed    Decimal               @default(0) @db.Decimal(10, 2)
  fabricIssued      Decimal?              @db.Decimal(10, 2)
  fabricReturned    Decimal?              @db.Decimal(10, 2)
  actualConsumption Decimal?              @db.Decimal(10, 2)
  createdAt         DateTime              @default(now())
  batch             cutting_batches       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fabricStock       fabric_stock          @relation(fields: [fabricStockId], references: [id])
  lays              cutting_lays[]        @relation("LegacyLayFabric")
  layFabrics        cutting_lay_fabrics[]

  @@unique([batchId, fabricStockId])
  @@map("cutting_batch_fabrics")
}

/// Cutting Batch SKU - SKU-wise output per cutting batch
model cutting_batch_skus {
  id             String          @id @default(uuid())
  cuttingBatchId String
  colorId        String?
  sizeId         String
  orderQty       Int
  extraAllowed   Int             @default(0)
  maxCuttable    Int
  toCut          Int
  cutQty         Int             @default(0)
  rejectedQty    Int             @default(0)
  goodPcs        Int             @default(0)
  color          color_options?  @relation(fields: [colorId], references: [id])
  cuttingBatch   cutting_batches @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)
  size           size_options    @relation(fields: [sizeId], references: [id])

  @@unique([cuttingBatchId, colorId, sizeId])
  @@index([cuttingBatchId])
}

/// Cutting Batch Defects - Track defects during cutting
model cutting_batch_defects {
  id             String          @id @default(uuid())
  cuttingBatchId String
  colorId        String?
  sizeId         String
  defectType     String
  defectQty      Int
  remarks        String?
  cuttingBatch   cutting_batches @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)

  @@index([cuttingBatchId])
}

/// Cutting Lay - Individual cutting event (lay) within a batch
model cutting_lays {
  id                   String   @id @default(uuid())
  cuttingBatchId       String
  layDate              DateTime
  layNumber            Int
  layerLength          Decimal  @db.Decimal(10, 2)
  numberOfLayers       Int      @default(1)
  totalPieces          Int      @default(0)
  remarks              String?
  createdById          String
  cuttingBatchFabricId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  skuOutputs   cutting_lay_skus[]
  layFabrics   cutting_lay_fabrics[]
  cuttingBatch cutting_batches        @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)
  createdBy    users                  @relation("CuttingLayCreator", fields: [createdById], references: [id])
  batchFabric  cutting_batch_fabrics? @relation("LegacyLayFabric", fields: [cuttingBatchFabricId], references: [id])

  @@index([cuttingBatchId])
  @@index([layDate])
}

/// Cutting Lay Fabrics - Per-fabric layer length within a lay
model cutting_lay_fabrics {
  id                   String                @id @default(uuid())
  cuttingLayId         String
  cuttingBatchFabricId String
  layerLength          Decimal               @db.Decimal(10, 2)
  cuttingLay           cutting_lays          @relation(fields: [cuttingLayId], references: [id], onDelete: Cascade)
  batchFabric          cutting_batch_fabrics @relation(fields: [cuttingBatchFabricId], references: [id])

  @@unique([cuttingLayId, cuttingBatchFabricId])
  @@map("cutting_lay_fabrics")
}

/// Cutting Lay SKU - Per-size pieces in a cutting lay
model cutting_lay_skus {
  id           String  @id @default(uuid())
  cuttingLayId String
  colorId      String?
  sizeId       String
  pieces       Int

  cuttingLay cutting_lays   @relation(fields: [cuttingLayId], references: [id], onDelete: Cascade)
  color      color_options? @relation(fields: [colorId], references: [id])
  size       size_options   @relation(fields: [sizeId], references: [id])

  @@unique([cuttingLayId, colorId, sizeId])
  @@index([cuttingLayId])
}

/// Transfer Slip - Movement between production stages
model transfer_slips {
  id               String               @id @default(uuid())
  slipNumber       String               @unique // duplicate slips double-counted FG stock (bug-hunt production-8); partial per-source uniques live in the migration SQL
  workOrderId      String
  componentId      String?
  fromStage        String
  toStage          String
  fromDepartment   String
  toDepartment     String
  transferDate     DateTime             @default(now())
  status           TransferSlipStatus   @default(CREATED)
  cuttingBatchId   String?
  stitchingIssueId String?
  finishingIssueId String?
  totalGoodPieces  Int
  issuedToId       String?
  preparedById     String
  receivedById     String?
  receivedDate     DateTime?
  remarks          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  isActive         Boolean              @default(true)
  receipts         stage_receipts[]
  skuBreakdown     transfer_slip_skus[]
  component        style_components?    @relation(fields: [componentId], references: [id])
  cuttingBatch     cutting_batches?     @relation(fields: [cuttingBatchId], references: [id])
  issuedTo         suppliers?           @relation("TransferIssuedTo", fields: [issuedToId], references: [id])
  preparedBy       users                @relation("TransferPreparedBy", fields: [preparedById], references: [id])
  receivedBy       users?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  workOrder        work_orders          @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@index([fromStage, toStage])
  @@index([status])
}

/// Transfer Slip SKU - SKU breakdown per transfer slip
model transfer_slip_skus {
  id             String         @id @default(uuid())
  transferSlipId String
  colorId        String?
  sizeId         String
  quantity       Int
  color          color_options? @relation(fields: [colorId], references: [id])
  size           size_options?  @relation(fields: [sizeId], references: [id])
  transferSlip   transfer_slips @relation(fields: [transferSlipId], references: [id], onDelete: Cascade)

  @@unique([transferSlipId, colorId, sizeId])
  @@index([transferSlipId])
}

/// Stage Receipt - Receipt verification at each production stage
model stage_receipts {
  id              String               @id @default(uuid())
  workOrderId     String
  stage           String
  transferSlipId  String
  receivedDate    DateTime
  receivedById    String
  hasDeviation    Boolean              @default(false)
  deviationReason String?
  remarks         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  skuReceipts     stage_receipt_skus[]
  receivedBy      users                @relation(fields: [receivedById], references: [id])
  transferSlip    transfer_slips       @relation(fields: [transferSlipId], references: [id])
  workOrder       work_orders          @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, stage])
  @@index([transferSlipId])
}

/// Stage Receipt SKU - SKU verification per receipt
model stage_receipt_skus {
  id             String         @id @default(uuid())
  stageReceiptId String
  colorId        String
  sizeId         String
  expectedQty    Int
  receivedQty    Int
  deviation      Int            @default(0)
  color          color_options  @relation(fields: [colorId], references: [id])
  size           size_options   @relation(fields: [sizeId], references: [id])
  stageReceipt   stage_receipts @relation(fields: [stageReceiptId], references: [id], onDelete: Cascade)

  @@unique([stageReceiptId, colorId, sizeId])
  @@index([stageReceiptId])
}

/// Stitching Issue - Issue to stitching manager
model stitching_issues {
  id                         String                       @id @default(uuid())
  issueNumber                String                       @unique
  workOrderId                String
  issueDate                  DateTime
  managerId                  String?
  contractorId               String?
  expectedCompletionDate     DateTime?
  status                     StitchingIssueStatus         @default(PENDING_RECEIPT)
  remarks                    String?
  startDate                  DateTime?
  endDate                    DateTime?
  createdById                String
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  isActive                   Boolean                      @default(true)
  dailyOutputs               stitching_daily_outputs[]
  components                 stitching_issue_components[]
  skuBreakdown               stitching_issue_skus[]
  contractor                 suppliers?                   @relation("StitchingContractor", fields: [contractorId], references: [id])
  createdBy                  users                        @relation("StitchingIssueCreator", fields: [createdById], references: [id])
  manager                    users?                       @relation("StitchingManager", fields: [managerId], references: [id])
  workOrder                  work_orders                  @relation(fields: [workOrderId], references: [id])
  external_process_send_outs external_process_send_outs[] @relation("ExternalProcessStitchingIssue")

  @@index([workOrderId])
  @@index([managerId])
  @@index([contractorId])
  @@index([status])
  // Performance: composite index for work order queries
  @@index([workOrderId, status])
}

/// Stitching Issue Component - Components assigned to manager
model stitching_issue_components {
  id               String           @id @default(uuid())
  stitchingIssueId String
  componentId      String
  component        style_components @relation(fields: [componentId], references: [id])
  stitchingIssue   stitching_issues @relation(fields: [stitchingIssueId], references: [id], onDelete: Cascade)

  @@unique([stitchingIssueId, componentId])
}

/// Stitching Issue SKU - SKU breakdown issued to manager
model stitching_issue_skus {
  id               String           @id @default(uuid())
  stitchingIssueId String
  colorId          String?
  sizeId           String
  availableQty     Int
  issuedQty        Int
  color            color_options?   @relation(fields: [colorId], references: [id])
  size             size_options     @relation(fields: [sizeId], references: [id])
  stitchingIssue   stitching_issues @relation(fields: [stitchingIssueId], references: [id], onDelete: Cascade)

  @@unique([stitchingIssueId, colorId, sizeId])
  @@index([stitchingIssueId])
}

/// Stitching Daily Output - Daily production tracking
model stitching_daily_outputs {
  id               String                  @id @default(uuid())
  stitchingIssueId String
  componentId      String?
  outputDate       DateTime
  remarks          String?
  createdById      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  component        style_components?       @relation(fields: [componentId], references: [id])
  createdBy        users                   @relation(fields: [createdById], references: [id])
  stitchingIssue   stitching_issues        @relation(fields: [stitchingIssueId], references: [id], onDelete: Cascade)
  skuOutputs       stitching_output_skus[]

  @@index([stitchingIssueId])
  @@index([outputDate])
}

/// Stitching Output SKU - SKU breakdown per daily output
model stitching_output_skus {
  id            String                  @id @default(uuid())
  dailyOutputId String
  colorId       String
  sizeId        String
  goodQty       Int                     @default(0)
  defectQty     Int                     @default(0)
  color         color_options           @relation(fields: [colorId], references: [id])
  dailyOutput   stitching_daily_outputs @relation(fields: [dailyOutputId], references: [id], onDelete: Cascade)
  size          size_options            @relation(fields: [sizeId], references: [id])

  @@unique([dailyOutputId, colorId, sizeId])
  @@index([dailyOutputId])
}

/// Finishing Issue - Issue to finishing contractor
model finishing_issues {
  id                     String                       @id @default(uuid())
  issueNumber            String
  workOrderId            String
  issueDate              DateTime
  managerId              String?
  contractorId           String?
  expectedCompletionDate DateTime?
  status                 FinishingStatus              @default(PENDING_RECEIPT)
  remarks                String?
  startDate              DateTime?
  endDate                DateTime?
  createdById            String
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  isActive               Boolean                      @default(true)
  cartons                carton_packings[]
  dailyOutputs           finishing_daily_outputs[]
  components             finishing_issue_components[]
  skuBreakdown           finishing_issue_skus[]
  contractor             suppliers?                   @relation("FinishingContractor", fields: [contractorId], references: [id])
  createdBy              users                        @relation("FinishingIssueCreator", fields: [createdById], references: [id])
  manager                users?                       @relation("FinishingManager", fields: [managerId], references: [id])
  workOrder              work_orders                  @relation(fields: [workOrderId], references: [id])
  polybagEntries         polybag_entries[]
  inspections            quality_inspections_mfg[]

  @@index([workOrderId])
  @@index([managerId])
  @@index([contractorId])
  @@index([status])
  // Performance: composite index for work order queries
  @@index([workOrderId, status])
}

/// Finishing Issue Component - Components assigned to manager
model finishing_issue_components {
  id               String           @id @default(uuid())
  finishingIssueId String
  componentId      String
  component        style_components @relation(fields: [componentId], references: [id])
  finishingIssue   finishing_issues @relation(fields: [finishingIssueId], references: [id], onDelete: Cascade)

  @@unique([finishingIssueId, componentId])
}

/// Finishing Issue SKU - SKU breakdown issued to manager
model finishing_issue_skus {
  id               String           @id @default(uuid())
  finishingIssueId String
  colorId          String?
  sizeId           String
  availableQty     Int
  issuedQty        Int
  color            color_options?   @relation(fields: [colorId], references: [id])
  finishingIssue   finishing_issues @relation(fields: [finishingIssueId], references: [id], onDelete: Cascade)
  size             size_options     @relation(fields: [sizeId], references: [id])

  @@unique([finishingIssueId, colorId, sizeId])
  @@index([finishingIssueId])
}

/// Finishing Daily Output - Daily finishing tracking
model finishing_daily_outputs {
  id               String                  @id @default(uuid())
  finishingIssueId String
  componentId      String?
  outputDate       DateTime
  remarks          String?
  createdById      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  component        style_components?       @relation(fields: [componentId], references: [id])
  createdBy        users                   @relation(fields: [createdById], references: [id])
  finishingIssue   finishing_issues        @relation(fields: [finishingIssueId], references: [id], onDelete: Cascade)
