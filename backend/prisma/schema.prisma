// ============================================
// PERMISSION MANAGEMENT
// ============================================

/// Stores the permission matrix - which role has access to which permission
model role_permissions {
  id            String   @id @default(uuid())
  role          UserRole
  permissionKey String   @db.VarChar(100)
  allowed       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  updatedById   String?
  updatedBy     users?   @relation("RolePermissionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([role, permissionKey])
  @@index([role])
  @@index([permissionKey])
  @@map("role_permissions")
}

/// Permission metadata - display names, descriptions, grouping
model permission_definitions {
  id            String   @id @default(uuid())
  permissionKey String   @unique @db.VarChar(100)
  displayName   String   @db.VarChar(100)
  description   String?  @db.VarChar(500)
  moduleGroup   String   @db.VarChar(50)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([moduleGroup])
  @@index([isActive])
  @@map("permission_definitions")
}

model work_order_breakup {
  id                String         @id
  workOrderId       String
  colorId           String?
  sizeId            String
  plannedQuantity   Int
  completedQuantity Int            @default(0)
  color_options     color_options? @relation(fields: [colorId], references: [id])
  size_options      size_options   @relation(fields: [sizeId], references: [id])
  work_orders       work_orders    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, colorId, sizeId])
  @@index([workOrderId])
}

model work_orders {
  id                                    String                            @id
  workOrderNumber                       String
  orderId                               String?
  orderItemId                           String?
  stockProductionOrderId                String?
  stockProductionOrderItemId            String?
  styleId                               String
  warehouseId                           String?
  plannedStartDate                      DateTime
  plannedEndDate                        DateTime
  actualStartDate                       DateTime?
  actualEndDate                         DateTime?
  totalQuantity                         Int
  completedQuantity                     Int                               @default(0)
  status                                OrderStatus                       @default(PENDING)
  priority                              Priority                          @default(MEDIUM)
  remarks                               String?
  createdById                           String
  approvedById                          String?
  createdAt                             DateTime                          @default(now())
  updatedAt                             DateTime                          @updatedAt
  userId                                String?
  isActive                              Boolean                           @default(true)
  // Production Run splitting fields
  parentRunId                           String? // Self-FK for split tracking
  fabricLotInfo                         Json? // Which fabric lot this run uses
  splitReason                           String? // Why it was split
  carton_packings                       carton_packings[]
  cutting_batches                       cutting_batches[]
  finished_goods_stock                  finished_goods_stock[]
  finishing_issues                      finishing_issues[]
  garment_physical_tests                garment_physical_tests[]
  material_requisitions                 material_requisitions[]
  production_tracking                   production_tracking[]
  quality_inspections                   quality_inspections[]
  quality_inspections_mfg               quality_inspections_mfg[]
  stage_receipts                        stage_receipts[]
  stageTransitionOverrides              stage_transition_overrides[]
  stitching_issues                      stitching_issues[]
  transfer_slips                        transfer_slips[]
  work_order_breakup                    work_order_breakup[]
  work_order_service_requirements       work_order_service_requirements[]
  embroidery_send_outs                  embroidery_send_out[]             @relation("EmbroideryForWorkOrder")
  external_process_send_outs            external_process_send_outs[]      @relation("ExternalProcessWorkOrder")
  job_work_orders                       job_work_orders[]                 @relation("JobWorkForWorkOrder")
  processing_batches                    processing_batch[]                @relation("ProcessingForWorkOrder")
  users_work_orders_approvedByIdTousers users?                            @relation("work_orders_approvedByIdTousers", fields: [approvedById], references: [id])
  users_work_orders_createdByIdTousers  users                             @relation("work_orders_createdByIdTousers", fields: [createdById], references: [id])
  warehouses                            warehouses?                       @relation(fields: [warehouseId], references: [id])
  orders                                orders?                           @relation(fields: [orderId], references: [id])
  order_items                           order_items?                      @relation(fields: [orderItemId], references: [id])
  stock_production_orders               stock_production_orders?          @relation(fields: [stockProductionOrderId], references: [id])
  stock_production_order_items          stock_production_order_items?     @relation(fields: [stockProductionOrderItemId], references: [id])
  styles                                styles                            @relation(fields: [styleId], references: [id])
  users_work_orders_userIdTousers       users?                            @relation("work_orders_userIdTousers", fields: [userId], references: [id])
  // Service POs linked to this work order
  servicePurchaseOrders                 purchase_orders[]                 @relation("PO_ServiceWorkOrder")
  // Production Run split self-relation
  parentRun                             work_orders?                      @relation("ProductionRunSplit", fields: [parentRunId], references: [id])
  childRuns                             work_orders[]                     @relation("ProductionRunSplit")
  // Challans linked to this production run
  challans                              challans[]
  // PO source links where this production run is the source
  poSourceLinks                         po_source_links[]                 @relation("POSourceProductionRun")
  // P6.2.3 Reject dispositions - track what happens to defective pieces
  rejectDispositions                    reject_dispositions[]             @relation("reject_disposition_wo")

  @@index([warehouseId])
  @@index([orderId])
  @@index([status])
  @@index([workOrderNumber])
  @@index([parentRunId])
  // Performance: composite indexes for common query patterns
  @@index([orderId, status])
  @@index([styleId, status])
  @@index([stockProductionOrderId])
}

// ============================================
// STOCK PRODUCTION ORDERS (Make-to-Stock)
// ============================================

/// Stock Production Order - Triggers production without a customer
model stock_production_orders {
  id            String                     @id @default(uuid())
  spoNumber     String                     @unique
  styleId       String
  totalQuantity Int
  targetDate    DateTime?
  status        StockProductionOrderStatus @default(DRAFT)
  priority      Priority                   @default(MEDIUM)
  remarks       String?
  createdById   String
  approvedById  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  isActive      Boolean                    @default(true)

  style       styles                         @relation(fields: [styleId], references: [id])
  createdBy   users                          @relation("spo_createdBy", fields: [createdById], references: [id])
  approvedBy  users?                         @relation("spo_approvedBy", fields: [approvedById], references: [id])
  items       stock_production_order_items[]
  work_orders work_orders[]

  @@index([styleId])
  @@index([status])
  @@index([spoNumber])
}

/// Stock Production Order Items - Size/color breakdown for stock production
model stock_production_order_items {
  id                     String  @id @default(uuid())
  stockProductionOrderId String
  colorId                String?
  sizeId                 String
  quantity               Int
  completedQuantity      Int     @default(0)

  stockProductionOrder stock_production_orders @relation(fields: [stockProductionOrderId], references: [id], onDelete: Cascade)
  color                color_options?          @relation(fields: [colorId], references: [id])
  size                 size_options            @relation(fields: [sizeId], references: [id])
  work_orders          work_orders[]

  @@unique([stockProductionOrderId, colorId, sizeId])
  @@index([stockProductionOrderId])
}

// ============================================
// SALE ORDERS (Sell from Stock)
// ============================================

/// Sale Order - Sell from existing FG Stock without triggering production
model sale_orders {
  id               String          @id @default(uuid())
  saleOrderNumber  String          @unique
  buyerPoNumber    String? // Buyer's (House of Kasya) purchase-order number — the B2B tracking key
  customerId       String
  styleId          String? // Primary style for the order (optional - multi-style orders leave null)
  saleDate         DateTime        @default(now())
  expectedShipDate DateTime? // Factory's planned ship date
  buyerDeadline    DateTime? // Buyer's required completion date
  orderDate        DateTime? // Buyer's PO/order date (saleDate is the ERP creation timestamp)
  deliveryDate     DateTime? // Agreed delivery date
  paymentTerms     String?
  deliveryAddress  String?
  status           SaleOrderStatus @default(DRAFT)
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal         @default(0) @db.Decimal(12, 2)
  remarks          String?
  createdById      String
  approvedById     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  isActive         Boolean         @default(true)

  customer         customers          @relation(fields: [customerId], references: [id])
  style            styles?            @relation("so_primaryStyle", fields: [styleId], references: [id])
  createdBy        users              @relation("so_createdBy", fields: [createdById], references: [id])
  approvedBy       users?             @relation("so_approvedBy", fields: [approvedById], references: [id])
  items            sale_order_items[]
  delivery_notes   delivery_notes[]
  invoices         invoices[]
  productionOrders orders[]

  @@index([customerId])
  @@index([styleId])
  @@index([status])
  @@index([saleOrderNumber])
  @@index([buyerPoNumber])
}

/// Sale Order Items - Line items with FG stock allocation tracking
model sale_order_items {
  id            String  @id @default(uuid())
  saleOrderId   String
  styleId       String
  colorId       String?
  sizeId        String
  quantity      Int
  unitPrice     Decimal @default(0) @db.Decimal(10, 2)
  totalPrice    Decimal @default(0) @db.Decimal(12, 2)
  allocatedQty  Int     @default(0)
  dispatchedQty Int     @default(0)
  remarks       String?

  saleOrder           sale_orders            @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  style               styles                 @relation(fields: [styleId], references: [id])
  color               color_options?         @relation(fields: [colorId], references: [id])
  size                size_options           @relation(fields: [sizeId], references: [id])
  allocations         fg_stock_allocations[]
  delivery_note_items delivery_note_items[]

  @@unique([saleOrderId, styleId, colorId, sizeId])
  @@index([saleOrderId])
  @@index([styleId])
}

/// FG Stock Allocations - Reserve finished goods for sale order items
model fg_stock_allocations {
  id              String   @id @default(uuid())
  saleOrderItemId String
  fgStockId       String
  allocatedQty    Int
  status          String   @default("ALLOCATED")
  allocatedAt     DateTime @default(now())
  allocatedById   String

  saleOrderItem sale_order_items     @relation(fields: [saleOrderItemId], references: [id], onDelete: Cascade)
  fgStock       finished_goods_stock @relation(fields: [fgStockId], references: [id])
  allocatedBy   users                @relation("fg_allocation_allocatedBy", fields: [allocatedById], references: [id])

  @@index([saleOrderItemId])
  @@index([fgStockId])
}

/// Work Order Service Requirements - Track service requirements at work order level
model work_order_service_requirements {
  id          String      @id @default(uuid())
  workOrderId String
  workOrder   work_orders @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  // Service identification
  serviceType  ServiceType
  processId    String?
  styleProcess style_processes? @relation(fields: [processId], references: [id])

  // Quantity
  quantityRequired Decimal @db.Decimal(10, 2)
  unit             String

  // Processor allocation
  preferredProcessorId String?
  preferredProcessor   suppliers? @relation("ServiceRequirementPreferredProcessor", fields: [preferredProcessorId], references: [id])
  assignedProcessorId  String?
  assignedProcessor    suppliers? @relation("ServiceRequirementAssignedProcessor", fields: [assignedProcessorId], references: [id])

  // Cost estimation
  estimatedRate  Decimal? @db.Decimal(10, 2)
  estimatedTotal Decimal? @db.Decimal(10, 2)

  // Status
  status ServiceRequirementStatus @default(PENDING)

  // Linkages
  purchaseOrderId     String?
  purchaseOrder       purchase_orders?     @relation(fields: [purchaseOrderId], references: [id])
  jobWorkOrderId      String?
  jobWorkOrder        job_work_orders?     @relation(fields: [jobWorkOrderId], references: [id])
  embroiderySendOutId String?
  embroiderySendOut   embroidery_send_out? @relation(fields: [embroiderySendOutId], references: [id])
  processingBatchId   String?
  processingBatch     processing_batch?    @relation(fields: [processingBatchId], references: [id])

  // Links
  serviceRequirementPoLinks service_requirement_po_links[]
  po_source_links           po_source_links[]
  challanItems              challan_items[]
  jwoLinks                  service_requirement_jwo_links[]

  // Audit
  source                     RequirementSource
  notes                      String?                      @db.Text
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  createdById                String
  createdBy                  users                        @relation("WorkOrderServiceRequirementCreator", fields: [createdById], references: [id])
  external_process_send_outs external_process_send_outs[] @relation("ExternalProcessServiceReq")

  @@index([workOrderId])
  @@index([serviceType])
  @@index([status])
  @@index([preferredProcessorId])
  @@map("work_order_service_requirements")
}

/// Service Requirement PO Links - M:N relationship between service requirements and PO items
model service_requirement_po_links {
  id                   String                          @id @default(uuid())
  serviceRequirementId String
  serviceRequirement   work_order_service_requirements @relation(fields: [serviceRequirementId], references: [id], onDelete: Cascade)
  purchaseOrderItemId  String
  purchaseOrderItem    purchase_order_items            @relation("ServiceRequirementPOLink", fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  quantityLinked       Decimal                         @db.Decimal(10, 2)
  createdAt            DateTime                        @default(now())

  @@unique([serviceRequirementId, purchaseOrderItemId])
  @@index([serviceRequirementId])
  @@index([purchaseOrderItemId])
  @@map("service_requirement_po_links")
}

/// Warehouse Master - Multiple warehouse/location management
model warehouses {
  id                     String                  @id @default(uuid())
  warehouseCode          String
  warehouseName          String
  warehouseType          WarehouseType
  address                String?
  city                   String?
  state                  String?
  pincode                String?
  contactPerson          String?
  contactPhone           String?
  capacity               Decimal?                @db.Decimal(10, 2)
  isActive               Boolean                 @default(true)
  createdById            String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  contactEmail           String?
  country                String?
  isVirtual              Boolean                 @default(false)
  supplierId             String?                 @db.VarChar(50)
  goods_receiving_notes  goods_receiving_notes[]
  stock_counts           stock_counts[]
  stock_levels           stock_levels[]
  stock_movements        stock_movements[]
  stock_reservations     stock_reservations[]
  work_orders            work_orders[]
  users                  users                   @relation(fields: [createdById], references: [id])
  supplier               suppliers?              @relation("WarehouseSupplier", fields: [supplierId], references: [id])
  // POs to be delivered here
  deliveryPurchaseOrders purchase_orders[]       @relation("PO_DeliveryWarehouse")

  // Specialized stock relations
  greigeStock        greige_stock[]         @relation("GreigeStockWarehouse")
  fabricStock        fabric_stock[]         @relation("FabricStockWarehouse")
  laceStock          lace_stock[]           @relation("LaceStockWarehouse")
  threadStock        thread_stock[]         @relation("ThreadStockWarehouse")
  buttonStock        button_stock[]         @relation("ButtonStockWarehouse")
  zipperStock        zipper_stock[]         @relation("ZipperStockWarehouse")
  elasticStock       elastic_stock[]        @relation("ElasticStockWarehouse")
  labelStock         label_stock[]          @relation("LabelStockWarehouse")
  packagingStock     packaging_stock[]      @relation("PackagingStockWarehouse")
  machinePartStock   machine_part_stock[]   @relation("MachinePartStockWarehouse")
  otherMaterialStock other_material_stock[] @relation("OtherMaterialStockWarehouse")

  @@index([warehouseCode])
  @@index([warehouseType])
  @@index([createdById])
  @@index([supplierId])
}

/// Stock Levels - Current stock balance per material per warehouse
model stock_levels {
  id            String     @id @default(uuid())
  materialId    String
  warehouseId   String
  quantity      Decimal    @db.Decimal(10, 3)
  unit          Unit
  reorderLevel  Decimal?   @db.Decimal(10, 3)
  maxLevel      Decimal?   @db.Decimal(10, 3)
  minLevel      Decimal?   @db.Decimal(10, 3)
  lastUpdated   DateTime   @default(now())
  valuationRate Decimal?   @db.Decimal(10, 2)
  stockValue    Decimal?   @db.Decimal(12, 2)
  materials     materials  @relation(fields: [materialId], references: [id])
  warehouses    warehouses @relation(fields: [warehouseId], references: [id])

  @@unique([materialId, warehouseId])
  @@index([materialId])
  @@index([warehouseId])
  @@index([quantity])
}

/// T2-1 derived-inventory: slim per-(material,warehouse) config that must persist independently of the
/// per-lot tables once on-hand quantity becomes DERIVED. Holds policy (reorder/min/max) + weighted-avg
/// valuationRate. Backfilled 1:1 from stock_levels. stockValue is NOT stored (derived = quantity x rate).
model stock_settings {
  id            String   @id @default(uuid())
  materialId    String
  warehouseId   String
  reorderLevel  Decimal? @db.Decimal(10, 3)
  minLevel      Decimal? @db.Decimal(10, 3)
  maxLevel      Decimal? @db.Decimal(10, 3)
  valuationRate Decimal? @db.Decimal(10, 2)
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([materialId, warehouseId])
  @@index([materialId])
}

/// Stock Movements - Transaction log for all stock movements
model stock_movements {
  id              String       @id @default(uuid())
  movementType    MovementType
  materialId      String
  warehouseId     String
  supplierId      String? // Direct supplier reference
  quantity        Decimal      @db.Decimal(10, 3)
  unit            Unit
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  fromLocation    String?
  toLocation      String?
  rate            Decimal?     @db.Decimal(10, 2)
  value           Decimal?     @db.Decimal(12, 2)
  foldLengthCm    Decimal?     @db.Decimal(5, 2) // "L" - fold length in cm (for fabric/greige)
  thanCount       Int? // Number of thans (folded bundles)
  remarks         String?
  performedById   String
  movementDate    DateTime     @default(now())
  createdAt       DateTime     @default(now())

  // Invoice tracking
  invoiceNumber String?
  invoiceDate   DateTime?

  materials  materials  @relation(fields: [materialId], references: [id])
  warehouses warehouses @relation(fields: [warehouseId], references: [id])
  suppliers  suppliers? @relation(fields: [supplierId], references: [id])

  @@index([materialId])
  @@index([warehouseId])
  @@index([supplierId])
  @@index([movementType])
  @@index([movementDate])
  @@index([referenceType, referenceId])
}

/// Stock Transactions - Detailed ledger for stock valuation (FIFO/LIFO/Weighted Average)
model stock_transactions {
  id              String               @id @default(uuid())
  materialId      String
  warehouseId     String
  transactionType StockTransactionType
  quantity        Decimal              @db.Decimal(10, 3)
  unit            Unit
  rate            Decimal              @db.Decimal(10, 2)
  value           Decimal              @db.Decimal(12, 2)
  balanceQuantity Decimal              @db.Decimal(10, 3)
  balanceValue    Decimal              @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  transactionDate DateTime             @default(now())
  createdAt       DateTime             @default(now())
  materials       materials            @relation("stockTransactions", fields: [materialId], references: [id])

  @@index([materialId])
  @@index([warehouseId])
  @@index([transactionType])
  @@index([transactionDate])
}

/// Stock Reservations - Reserve stock for orders/work orders
model stock_reservations {
  id               String            @id @default(uuid())
  materialId       String
  warehouseId      String
  reservationType  ReservationType
  referenceType    String
  referenceId      String
  referenceNumber  String?
  reservedQuantity Decimal           @db.Decimal(10, 3)
  consumedQuantity Decimal           @default(0) @db.Decimal(10, 3)
  unit             Unit
  status           ReservationStatus @default(ACTIVE)
  expiryDate       DateTime?
  remarks          String?
  reservedById     String
  reservedAt       DateTime          @default(now())
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  materials        materials         @relation(fields: [materialId], references: [id])
  warehouses       warehouses        @relation(fields: [warehouseId], references: [id])

  @@index([materialId])
  @@index([warehouseId])
  @@index([status])
  @@index([referenceType, referenceId])
}

/// Stock Counts - Physical inventory count management
model stock_counts {
  id                String              @id @default(uuid())
  countNumber       String              @unique
  warehouseId       String
  countType         CountType
  countDate         DateTime            @default(now())
  status            CountStatus         @default(DRAFT)
  totalItems        Int                 @default(0)
  countedItems      Int                 @default(0)
  varianceItems     Int                 @default(0)
  remarks           String?
  countedById       String
  verifiedById      String?
  verifiedAt        DateTime?
  approvedById      String?
  approvedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  stock_count_items stock_count_items[]
  warehouses        warehouses          @relation(fields: [warehouseId], references: [id])

  @@index([countNumber])
  @@index([warehouseId])
  @@index([status])
  @@index([countDate])
}

/// Stock Count Items - Line items for physical counts
model stock_count_items {
  id               String       @id @default(uuid())
  stockCountId     String
  materialId       String
  systemQuantity   Decimal      @db.Decimal(10, 3)
  physicalQuantity Decimal?     @db.Decimal(10, 3)
  variance         Decimal?     @db.Decimal(10, 3)
  unit             Unit
  remarks          String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  materials        materials    @relation(fields: [materialId], references: [id])
  stock_counts     stock_counts @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@unique([stockCountId, materialId])
  @@index([stockCountId])
  @@index([materialId])
}

/// Material Requirement - Core MRP entity for tracking material needs per order
model material_requirements {
  id                  String                    @id @default(uuid())
  requirementNumber   String                    @unique
  source              RequirementSource
  orderId             String?
  orderItemId         String?
  materialId          String
  orderQuantity       Int
  quantityPerUnit     Decimal                   @db.Decimal(10, 4)
  wastagePercent      Decimal                   @db.Decimal(5, 2)
  totalRequired       Decimal                   @db.Decimal(12, 3)
  unit                Unit
  availableStock      Decimal                   @default(0) @db.Decimal(12, 3)
  allocatedFromStock  Decimal                   @default(0) @db.Decimal(12, 3)
  shortfall           Decimal                   @db.Decimal(12, 3)
  preferredSupplierId String?
  status              MaterialRequirementStatus @default(PENDING)
  requiredDate        DateTime
  calculatedAt        DateTime                  @default(now())
  createdById         String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  orderBomId          String?
  cadId               String?
  fabricWidth         Decimal?                  @db.Decimal(10, 2)
  splitFromId         String?

  // NEW: Processing support fields
  requirementType      String   @default("MATERIAL") // 'MATERIAL' | 'PROCESSING'
  processorId          String? // FK to suppliers (for PROCESSING type)
  linkedRequirementId  String? // Links PROCESSING to its parent GREIGE requirement
  processingCost       Decimal? @db.Decimal(12, 2)
  printingType         String?
  // MRP-48f: audit of the shrinkage actually used to inflate totalRequired, and where it came
  // from (RATE_CARD | RATE_CARD_RESOLVED | GREIGE_MASTER_FALLBACK | NONE). Without these the
  // percentage was baked into the quantity with no record, so a planner could not tell whether a
  // number came from the processor's commitment or from a fallback average.
  shrinkagePercentUsed Decimal? @db.Decimal(5, 2)
  shrinkageSource      String? // PrintingType: PIGMENT, PROCIAN, DISCHARGE, PIGMENT_DISCHARGE
  colorName            String? // Dye/processing color — differentiates same greige with different colors
  componentName        String? // Garment component (Top, Shirt) — for traceability through PO/GRN

  // Price snapshot from the approved Order BOM (single source of truth for PO pricing).
  // null unitPrice = legacy/manual requirement → PO generation falls back to live rate resolution.
  unitPrice      Decimal? @db.Decimal(12, 4)
  rateSource     String? // 'ORDER_BOM' | 'COST_SHEET' | 'SUPPLIER_PRICE' | 'RATE_CARD' | 'MANUAL'
  orderBomItemId String? // provenance: the exact BOM line this price/consumption came from

  createdBy             users                   @relation("mrp_requirement_createdBy", fields: [createdById], references: [id])
  materials             materials               @relation(fields: [materialId], references: [id])
  orderBom              order_bom?              @relation(fields: [orderBomId], references: [id])
  orders                orders?                 @relation(fields: [orderId], references: [id])
  order_items           order_items?            @relation(fields: [orderItemId], references: [id])
  preferredSupplier     suppliers?              @relation("mrp_requirement_supplier", fields: [preferredSupplierId], references: [id])
  splitFrom             material_requirements?  @relation("mrp_split", fields: [splitFromId], references: [id])
  splitChildren         material_requirements[] @relation("mrp_split")
  requirement_po_links  requirement_po_links[]
  requirement_jwo_links requirement_jwo_links[]
  po_source_links       po_source_links[]

  // NEW: Processing relations
  processor         suppliers?              @relation("mrp_requirement_processor", fields: [processorId], references: [id])
  linkedRequirement material_requirements?  @relation("mrp_linked", fields: [linkedRequirementId], references: [id])
  childRequirements material_requirements[] @relation("mrp_linked")
  challanItems      challan_items[]
  orderBomItem      order_bom_items?        @relation("mrp_requirement_bom_item", fields: [orderBomItemId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([materialId])
  @@index([status])
  @@index([requiredDate])
  @@index([splitFromId])
  // Performance: composite index for MRP dashboard queries
  @@index([orderId, status, requiredDate])
  @@index([status, requiredDate])
  @@index([preferredSupplierId, status])
  @@index([requirementType])
  @@index([processorId])
  @@index([linkedRequirementId])
  @@index([orderBomItemId])
}

/// Links Requirements to PO Items (many-to-many for consolidation)
model requirement_po_links {
  id                    String                @id @default(uuid())
  requirementId         String
  purchaseOrderId       String
  purchaseOrderItemId   String
  allocatedQuantity     Decimal               @db.Decimal(12, 3)
  receivedQuantity      Decimal               @default(0) @db.Decimal(12, 3)
  createdAt             DateTime              @default(now())
  purchase_orders       purchase_orders       @relation(fields: [purchaseOrderId], references: [id])
  purchase_order_items  purchase_order_items  @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  material_requirements material_requirements @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, purchaseOrderItemId])
  @@index([purchaseOrderId])
  @@index([requirementId])
}

/// Phase 4a: Links PROCESSING Requirements to Job Work Orders (JWO IS the PO endgame).
/// Written alongside requirement_po_links while the PO shadow exists; becomes the sole
/// procurement link for processing in Phase 4c. receivedQuantity stays 0 until Phase 4b
/// moves the receipt bridge off purchase_order_items.
model requirement_jwo_links {
  id                    String                @id @default(uuid())
  requirementId         String
  jobWorkOrderId        String
  allocatedQuantity     Decimal               @db.Decimal(12, 3)
  receivedQuantity      Decimal               @default(0) @db.Decimal(12, 3)
  createdAt             DateTime              @default(now())
  material_requirements material_requirements @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  job_work_orders       job_work_orders       @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)

  @@unique([requirementId, jobWorkOrderId])
  @@index([jobWorkOrderId])
  @@index([requirementId])
}

/// Phase 5a: work-order service requirement ↔ JWO allocation (mirror of requirement_jwo_links).
/// Carries the qty math for the single fulfilment track (updateWosrReceivedQuantity).
model service_requirement_jwo_links {
  id                              String                          @id @default(uuid())
  serviceRequirementId            String
  jobWorkOrderId                  String
  allocatedQuantity               Decimal                         @db.Decimal(12, 3)
  receivedQuantity                Decimal                         @default(0) @db.Decimal(12, 3)
  createdAt                       DateTime                        @default(now())
  work_order_service_requirements work_order_service_requirements @relation(fields: [serviceRequirementId], references: [id], onDelete: Cascade)
  job_work_orders                 job_work_orders                 @relation(fields: [jobWorkOrderId], references: [id], onDelete: Cascade)

  @@unique([serviceRequirementId, jobWorkOrderId])
  @@index([jobWorkOrderId])
  @@index([serviceRequirementId])
}

/// Universal PO Source Links - Tracks origin of PO items from any source
model po_source_links {
  id                  String   @id @default(uuid())
  purchaseOrderId     String
  purchaseOrderItemId String
  sourceType          POSource

  // Polymorphic source references (only one populated based on sourceType)
  costSheetGenerationId String? // For COST_SHEET source
  materialRequirementId String? // For MRP source
  serviceRequirementId  String? // For SERVICE_REQUIREMENT source
  productionRunId       String? // For PRODUCTION_RUN source

  quantityLinked Decimal  @db.Decimal(12, 3)
  createdAt      DateTime @default(now())

  // Relations
  purchaseOrder       purchase_orders                  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderItem   purchase_order_items             @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  costSheetGeneration cost_sheet_po_generation?        @relation(fields: [costSheetGenerationId], references: [id])
  materialRequirement material_requirements?           @relation(fields: [materialRequirementId], references: [id])
  serviceRequirement  work_order_service_requirements? @relation(fields: [serviceRequirementId], references: [id])
  productionRun       work_orders?                     @relation("POSourceProductionRun", fields: [productionRunId], references: [id])

  @@index([purchaseOrderId])
  @@index([purchaseOrderItemId])
  @@index([sourceType])
  @@index([materialRequirementId])
  @@index([serviceRequirementId])
  @@index([costSheetGenerationId])
  @@index([productionRunId])
  @@map("po_source_links")
}

/// Chart of Accounts Master - Core accounting structure
model chart_of_accounts {
  id              String              @id @default(uuid())
  accountCode     String
  accountName     String
  accountType     AccountType
  accountGroup    AccountGroup
  parentAccountId String?
  description     String?
  isActive        Boolean             @default(true)
  isSystem        Boolean             @default(false)
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  users           users               @relation(fields: [createdById], references: [id])
  parentAccount   chart_of_accounts?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts   chart_of_accounts[] @relation("AccountHierarchy")
  expense_types   expense_types[]

  @@index([accountCode])
  @@index([accountType])
  @@index([parentAccountId])
}

/// Cost Center Master - Track costs by department/location/project
model cost_centers {
  id             String     @id @default(uuid())
  costCenterCode String
  costCenterName String
  costCenterType String
  departmentId   String?
  locationId     String?
  budgetAmount   Decimal?   @db.Decimal(12, 2)
  description    String?
  isActive       Boolean    @default(true)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  users          users      @relation(fields: [createdById], references: [id])
  locations      locations? @relation(fields: [locationId], references: [id])

  @@index([costCenterCode])
  @@index([locationId])
}

/// Expense Type Master - Categorize expenses
model expense_types {
  id                String             @id @default(uuid())
  expenseCode       String
  expenseName       String
  expenseCategory   ExpenseCategory
  accountId         String?
  isRecurring       Boolean            @default(false)
  description       String?
  isActive          Boolean            @default(true)
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  chart_of_accounts chart_of_accounts? @relation(fields: [accountId], references: [id])
  users             users              @relation(fields: [createdById], references: [id])

  @@index([expenseCode])
  @@index([accountId])
}

/// Tax Master - GST/VAT/Duties management
model tax_masters {
  id             String    @id @default(uuid())
  taxCode        String
  taxName        String
  taxType        TaxType
  taxRate        Decimal   @db.Decimal(5, 2)
  hsnSacCode     String?
  description    String?
  applicableFrom DateTime
  applicableTo   DateTime?
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  users          users     @relation(fields: [createdById], references: [id])

  @@index([taxCode])
  @@index([taxType])
  @@index([applicableFrom])
}

/// HSN/SAC Master - Harmonized System Nomenclature (goods) and Service Accounting Codes
model hsn_sac_masters {
  id             String     @id @default(uuid())
  code           String     @unique
  type           HSNSACType
  description    String
  chapter        String? // First 2 digits of code (e.g., "62" for garments)
  section        String? // Broad category (e.g., "Apparel & Clothing")
  defaultGstRate Decimal    @db.Decimal(5, 2)
  unit           String? // Default unit (PCS, MTR, KG, etc.)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([code])
  @@index([type])
  @@index([chapter])
}

/// Payment Terms Master - Standardize payment terms
model payment_terms {
  id              String      @id @default(uuid())
  termCode        String
  termName        String
  description     String?
  daysCount       Int?
  paymentSchedule Json?
  discountPercent Decimal?    @db.Decimal(5, 2)
  isActive        Boolean     @default(true)
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  customers       customers[]
  users           users       @relation(fields: [createdById], references: [id])
  suppliers       suppliers[]

  @@index([termCode])
}

/// Component Master - Standardize garment component names (Blouse, Top, Pajama, etc.)
model component_masters {
  id                String                        @id @default(uuid())
  name              String                        @unique
  description       String?
  componentCategory String?
  isActive          Boolean                       @default(true)
  sortOrder         Int                           @default(0)
  createdById       String
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  componentGroupId  String?                       @map("component_group_id")
  categoryDefaults  category_component_defaults[]
  componentGroup    component_group_master?       @relation(fields: [componentGroupId], references: [id])
  users             users                         @relation(fields: [createdById], references: [id])
  patternParts      component_pattern_parts[]
  styleComponents   style_components[]

  @@index([isActive])
  @@index([componentCategory])
  @@index([componentGroupId])
  @@map("component_masters")
}

/// Bridge table linking Product Categories to default Component Masters
/// Defines which components are typical for each product category
model category_component_defaults {
  id                String                  @id @default(uuid())
  productCategoryId String                  @map("product_category_id")
  componentMasterId String                  @map("component_master_id")
  isRequired        Boolean                 @default(false)
  sortOrder         Int                     @default(0)
  defaultCount      Int                     @default(1)
  notes             String?
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  componentMaster   component_masters       @relation(fields: [componentMasterId], references: [id], onDelete: Cascade)
  productCategory   product_category_master @relation(fields: [productCategoryId], references: [id], onDelete: Cascade)

  @@unique([productCategoryId, componentMasterId])
  @@index([productCategoryId])
  @@index([componentMasterId])
  @@map("category_component_defaults")
}

/// Component Group Master - Broad grouping of components (TOP, BOTTOM, OUTER, etc.)
/// User-manageable master for organizing components by physical garment placement
model component_group_master {
  id                String                @id @default(uuid())
  code              String
  name              String
  description       String?
  sortOrder         Int                   @default(0)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  components        component_masters[]
  patternPartGroups pattern_part_groups[]

  @@index([isActive])
  @@index([sortOrder])
  @@map("component_group_master")
}

/// Pattern Part Master - Specific garment pattern pieces (SLEEVE, COLLAR, CUFF, etc.)
/// For future use in pattern making, cutting, and fabric consumption tracking
model pattern_part_master {
  id                    String                    @id @default(uuid())
  code                  String
  name                  String
  description           String?
  sortOrder             Int                       @default(0)
  isActive              Boolean                   @default(true)
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  componentPatternParts component_pattern_parts[]
  fabricWidthCads       fabric_width_cad[]        @relation("cad_pattern_part")
  fabricStocks          fabric_stock[]            @relation("fabric_stock_pattern_part")
  patternPartGroups     pattern_part_groups[]
  stylePatternParts     style_pattern_parts[]     @relation("style_pattern_parts")
  cadPatternParts       cad_pattern_parts[]       @relation("cad_part_assignments")

  @@index([isActive])
  @@index([sortOrder])
  @@map("pattern_part_master")
}

/// Bridge table - Many-to-many relationship between CAD rows and Pattern Parts
/// Enables multi-part selection per CAD row (e.g., SLEEVE + COLLAR in one row)
model cad_pattern_parts {
  id            String   @id @default(uuid())
  cadId         String   @map("cad_id")
  patternPartId String   @map("pattern_part_id")
  createdAt     DateTime @default(now()) @map("created_at")

  cad         fabric_width_cad    @relation("cad_multi_parts", fields: [cadId], references: [id], onDelete: Cascade)
  patternPart pattern_part_master @relation("cad_part_assignments", fields: [patternPartId], references: [id], onDelete: Cascade)

  @@unique([cadId, patternPartId])
  @@index([cadId])
  @@index([patternPartId])
  @@map("cad_pattern_parts")
}

/// Bridge table - Many-to-many relationship between Pattern Parts and Component Groups
/// Example: "POCKET" pattern part can belong to TOP, BOTTOM, OUTER groups
model pattern_part_groups {
  id               String                 @id @default(uuid())
  patternPartId    String                 @map("pattern_part_id")
  componentGroupId String                 @map("component_group_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  componentGroup   component_group_master @relation(fields: [componentGroupId], references: [id], onDelete: Cascade)
  patternPart      pattern_part_master    @relation(fields: [patternPartId], references: [id], onDelete: Cascade)

  @@unique([patternPartId, componentGroupId])
  @@index([patternPartId])
  @@index([componentGroupId])
  @@map("pattern_part_groups")
}

/// Bridge table - Many-to-many relationship between Components and Pattern Parts
/// Example: "Blouse" component can have BODY_FRONT, BODY_BACK, SLEEVE, COLLAR, CUFF
model component_pattern_parts {
  id            String              @id @default(uuid())
  componentId   String              @map("component_id")
  patternPartId String              @map("pattern_part_id")
  quantity      Int                 @default(1)
  isRequired    Boolean             @default(true)
  notes         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  component     component_masters   @relation(fields: [componentId], references: [id], onDelete: Cascade)
  patternPart   pattern_part_master @relation(fields: [patternPartId], references: [id], onDelete: Cascade)

  @@unique([componentId, patternPartId])
  @@index([componentId])
  @@index([patternPartId])
  @@map("component_pattern_parts")
}

/// Bank Account Master - Track multiple bank accounts
model bank_accounts {
  id                String          @id @default(uuid())
  accountNumber     String
  bankName          String
  branchName        String
  ifscCode          String?
  swiftCode         String?
  accountType       BankAccountType
  accountHolderName String
  openingBalance    Decimal         @db.Decimal(12, 2)
  currentBalance    Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  isActive          Boolean         @default(true)
  isPrimaryAccount  Boolean         @default(false)
  createdById       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  users             users           @relation(fields: [createdById], references: [id])

  @@index([accountNumber])
  @@index([bankName])
}

/// Currency Master - Multi-currency support
model currencies {
  id              String            @id @default(uuid())
  currencyCode    String            @unique
  currencyName    String
  currencySymbol  String
  isBaseCurrency  Boolean           @default(false)
  decimalPlaces   Int               @default(2)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  customers       customers[]
  exchange_rates  exchange_rates[]
  materialMasters material_master[]
