# Kashaya Fabs ERP - Environment Variables
# DO NOT commit this file to Git (.gitignore is configured)

# Database Configuration
# Local PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garment_erp"

# JWT Configuration
JWT_SECRET="a9K2mP2vL8nQ4wR6xY0zA3bC5dE7fG9hI1jK3lM5nO7pQ9rS1tU3vW5xY7zA9bX"
JWT_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# CORS Configuration (frontend URL - LAN access)
FRONTEND_URL="http://192.168.1.23:5173"

# Debugging
DEBUG_TRANSFORM="false"

# GST Configuration
# Company's registered state ID from indian_states table
# This is used for automatic GST calculation (intrastate vs interstate)
# Example: For Maharashtra, find the ID from indian_states where stateCode = '27'
COMPANY_STATE_ID="ab30a49e-6927-4593-8f14-c33c141a5a56"

# ============================================
# AI Provider Configuration
# ============================================
# Enable/disable AI features (true/false)
AI_ENABLED="true"

# AI Provider Type
# Options: openai, anthropic, google, ollama
# - openai: GPT-4, GPT-3.5 (requires OpenAI API key)
# - anthropic: Claude 3.5 Sonnet, Claude 3 Opus (requires Anthropic API key)
# - google: Gemini 1.5 Pro, Gemini 1.5 Flash (requires Google API key)
# - ollama: Local models like Llama 3, Mistral (free, requires local Ollama installation)
AI_PROVIDER="ollama"

# API Key (required for cloud providers: openai, anthropic, google)
# Get your API key from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google: https://makersuite.google.com/app/apikey
AI_API_KEY=""

# Model (optional, defaults to provider's recommended model)
# OpenAI models: gpt-4-turbo, gpt-4, gpt-3.5-turbo
# Anthropic models: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# Google models: gemini-1.5-pro, gemini-1.5-flash
# Ollama models: llama3, mistral, phi, codellama (any model you have installed)
AI_MODEL="llama3"

# Base URL (required only for Ollama local installations)
# Default Ollama URL: http://localhost:11434
AI_BASE_URL="http://localhost:11434"

# Example configurations:
# ----------------------
# OpenAI (GPT-4):
#   AI_ENABLED="true"
#   AI_PROVIDER="openai"
#   AI_API_KEY="sk-..."
#   AI_MODEL="gpt-4-turbo"
#
# Anthropic (Claude):
#   AI_ENABLED="true"
#   AI_PROVIDER="anthropic"
#   AI_API_KEY="sk-ant-..."
#   AI_MODEL="claude-3-5-sonnet-20241022"
#
# Google (Gemini):
#   AI_ENABLED="true"
#   AI_PROVIDER="google"
#   AI_API_KEY="AIza..."
#   AI_MODEL="gemini-1.5-pro"
#
# Ollama (Local - Free):
#   AI_ENABLED="true"
#   AI_PROVIDER="ollama"
#   AI_BASE_URL="http://localhost:11434"
#   AI_MODEL="llama3"
