/// Style Pattern Parts - Links pattern parts to style fabrics during CAD planning
/// Allows marking specific parts for embroidery (separate CAD calculation)
model style_pattern_parts {
  id               String              @id @default(uuid())
  styleFabricId    String              @map("style_fabric_id")
  patternPartId    String              @map("pattern_part_id")
  quantity         Int                 @default(1)
  goesToEmbroidery Boolean             @default(false)
  notes            String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  patternPart      pattern_part_master @relation("style_pattern_parts", fields: [patternPartId], references: [id], onDelete: Cascade)
  styleFabric      style_fabrics       @relation(fields: [styleFabricId], references: [id], onDelete: Cascade)

  @@unique([styleFabricId, patternPartId])
  @@index([styleFabricId])
  @@index([patternPartId])
  @@map("style_pattern_parts")
}

/// Embroidery Part CAD - Separate CAD calculation for parts going to embroidery
/// Created when style_pattern_parts have goesToEmbroidery = true
model embroidery_part_cad {
  id                String                          @id @default(uuid())
  styleFabricId     String                          @unique @map("style_fabric_id")
  fabricWidthCadId  String?                         @map("fabric_width_cad_id")
  embroideryId      String?                         @map("embroidery_id")
  cadMeters         Decimal?                        @db.Decimal(10, 4)
  cadYards          Decimal?                        @db.Decimal(10, 4)
  cadWastagePercent Decimal                         @default(5) @db.Decimal(5, 2)
  layerMarginMeters Decimal?                        @db.Decimal(10, 4)
  piecesPerMarker   Int?
  markerEfficiency  Decimal?                        @db.Decimal(5, 2)
  printDirection    PrintDirection                  @default(TWO_WAY)
  isApproved        Boolean                         @default(false)
  notes             String?
  createdAt         DateTime                        @default(now()) @map("created_at")
  updatedAt         DateTime                        @updatedAt @map("updated_at")
  sizeBreakdowns    embroidery_cad_size_breakdown[]
  embroidery        embroidery_master?              @relation("embroidery_part_cad_embroidery", fields: [embroideryId], references: [id])
  fabricWidthCad    fabric_width_cad?               @relation("embroidery_part_cad_width", fields: [fabricWidthCadId], references: [id])
  styleFabric       style_fabrics                   @relation(fields: [styleFabricId], references: [id], onDelete: Cascade)

  @@index([styleFabricId])
  @@index([fabricWidthCadId])
  @@index([embroideryId])
  @@map("embroidery_part_cad")
}

/// Embroidery CAD Size Breakdown - Size-wise piece counts for embroidery CAD calculation
model embroidery_cad_size_breakdown {
  id              String              @id @default(uuid())
  embroideryCadId String              @map("embroidery_cad_id")
  sizeName        String
  sizeId          String?             @map("size_id")
  quantity        Int
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  embroideryCad   embroidery_part_cad @relation(fields: [embroideryCadId], references: [id], onDelete: Cascade)
  size            size_options?       @relation(fields: [sizeId], references: [id])

  @@unique([embroideryCadId, sizeName])
  @@index([embroideryCadId])
  @@index([sizeId])
  @@map("embroidery_cad_size_breakdown")
}

// ==========================================
// LACE PROCESSING SUPPORT TABLES
// ==========================================

/// Lace Stock - Tracks lace inventory with style origin and dye lot info
model lace_stock {
  id String @id @default(uuid())

  // Core Identification
  laceId       String // Links to lace_master
  lotNumber    String? // Physical lot/roll identifier
  rollNumbers  String? // Physical rolls (e.g., "R001, R002")
  dyeLotNumber String? // Dye batch for shade matching

  // Origin Tracking (CRITICAL for traceability)
  originStyleId     String? // Which style produced this excess
  originOrderId     String? // Which order this came from
  originStyleCode   String? // Denormalized for easy display
  procurementId     String? // Purchase order reference
  processingBatchId String? // Links to processing_batch (greige→finished)

  // Location
  warehouseLocation String?
  rackNumber        String?

  // Stock details
  quantityAvailable Decimal @db.Decimal(10, 2)
  quantityReserved  Decimal @default(0) @db.Decimal(10, 2)
  quantityConsumed  Decimal @default(0) @db.Decimal(10, 2)
  unit              String  @default("meters")

  // Cost tracking
  weightedAvgCost Decimal @db.Decimal(10, 2) // WAC for valuation
  purchaseCost    Decimal @db.Decimal(10, 2) // Original cost

  // Quality & Status
  qualityGrade String @default("A") // A | B | DEFECT
  status       String @default("AVAILABLE") // AVAILABLE | RESERVED | ISSUED | PENDING_RETURN
  stockType    String @default("PLANNED_STOCK") // PLANNED_STOCK | EXCESS | EXCESS_MOQ | RETURNED

  // Dates
  receivedDate     DateTime
  lastConsumedDate DateTime?
  agingDays        Int       @default(0)

  // Return handling (for order cancellation)
  returnStatus        String? // PENDING_RETURN | RETURNED | RETURN_REJECTED
  returnReason        String?
  returnRequestDate   DateTime?
  returnConfirmedDate DateTime?
  restockingFee       Decimal?  @db.Decimal(10, 2)

  // Shade info
  shadeNote String? // Shade description for matching

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  // Relations
  laceMaster      lace_master                @relation(fields: [laceId], references: [id])
  originStyle     styles?                    @relation("lace_stock_origin_style", fields: [originStyleId], references: [id])
  originOrder     orders?                    @relation("lace_stock_origin_order", fields: [originOrderId], references: [id])
  processingBatch processing_batch?          @relation("lace_stock_from_processing", fields: [processingBatchId], references: [id])
  createdBy       users?                     @relation("lace_stock_creator", fields: [createdById], references: [id])
  allocations     lace_stock_allocation[]
  transactions    lace_stock_transaction[]
  costingItems    style_costing_lace_items[] @relation("lace_costing_stock_lot")
  issueNotes      lace_issue_note[]
  challanItems    challan_items[]

  @@index([laceId])
  @@index([originStyleId])
  @@index([originOrderId])
  @@index([processingBatchId])
  @@index([status])
  @@index([qualityGrade])
  @@index([dyeLotNumber])
}

/// Lace Stock Allocation - Tracks allocations/transfers between styles
model lace_stock_allocation {
  id      String @id @default(uuid())
  stockId String // Which stock lot

  // Current allocation
  orderId   String // Allocated to which order
  styleId   String // For which style
  styleCode String? // Denormalized for display

  // Origin tracking (maintains history)
  originalStyleId   String? // Original style that created this stock
  originalStyleCode String? // Denormalized: "ST2024001"
  originalOrderId   String? // Original order reference

  // Transfer info
  allocationType         String    @default("SAME_STYLE") // SAME_STYLE | CROSS_STYLE_REUSE | INTER_ORDER_TRANSFER | GENERIC_STOCK
  transferredFromStyleId String? // If this was a transfer, from which style
  transferDate           DateTime? // When transferred
  transferNotes          String? // Reason for transfer

  // Quantities
  quantityAllocated Decimal @db.Decimal(10, 2)
  quantityConsumed  Decimal @default(0) @db.Decimal(10, 2)
  quantityReturned  Decimal @default(0) @db.Decimal(10, 2)

  // Status
  allocationStatus String @default("RESERVED") // RESERVED | IN_USE | CONSUMED | RETURNED | TRANSFERRED

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  stock         lace_stock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  order         orders     @relation("lace_allocation_order", fields: [orderId], references: [id])
  style         styles     @relation("lace_allocation_style", fields: [styleId], references: [id])
  originalStyle styles?    @relation("lace_allocation_original_style", fields: [originalStyleId], references: [id])
  originalOrder orders?    @relation("lace_allocation_original_order", fields: [originalOrderId], references: [id])
  createdBy     users      @relation("lace_allocation_creator", fields: [createdById], references: [id])

  @@index([stockId])
  @@index([orderId])
  @@index([styleId])
  @@index([allocationStatus])
}

/// Lace Stock Transaction - Full audit trail for stock movements
model lace_stock_transaction {
  id              String @id @default(uuid())
  stockId         String
  transactionType String // STOCK_IN | TRANSFER_OUT | TRANSFER_IN | ALLOCATION | CONSUMPTION | RETURN | ADJUSTMENT | QUALITY_DOWNGRADE

  quantity     Decimal @db.Decimal(10, 2)
  balanceAfter Decimal @db.Decimal(10, 2)

  // Transfer-specific fields
  fromStyleId   String?
  toStyleId     String?
  fromStyleCode String? // "ST2024001"
  toStyleCode   String? // "ST2024050"

  // Quality change tracking
  qualityGradeFrom String?
  qualityGradeTo   String?

  referenceType String? // ORDER | ALLOCATION | MANUAL | PROCESSING_BATCH | GRN
  referenceId   String?
  notes         String?

  transactionDate DateTime @default(now())
  performedById   String

  // Relations
  stock       lace_stock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  performedBy users      @relation("lace_transaction_performer", fields: [performedById], references: [id])

  @@index([stockId])
  @@index([transactionType])
  @@index([transactionDate])
}

/// Lace Lab Dip - Lab dip approval workflow for greige lace dyeing
model lace_lab_dip {
  id           String @id @default(uuid())
  labDipNumber String @unique // LD-LACE-2024-0001

  // Lace & Color
  greigeLaceId String
  targetColor  String // Color name/code
  colorRecipe  String? // Processor's dye recipe

  // Processor
  processorId    String
  sampleQuantity Decimal @db.Decimal(10, 2)

  // Tracking dates
