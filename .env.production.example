# ============================================
# GARMENT ERP - PRODUCTION ENVIRONMENT
# ============================================
# Copy this file to .env and fill in the values
# DO NOT commit the .env file to version control!
# ============================================

# ============================================
# DATABASE (DigitalOcean Managed PostgreSQL)
# ============================================
# Get this from DigitalOcean Database dashboard
DATABASE_URL=postgresql://doadmin:PASSWORD@db-postgresql-blr1-xxxxx-do-user-xxxxx-0.c.db.ondigitalocean.com:25060/garment_erp?sslmode=require

# ============================================
# AUTHENTICATION
# ============================================
# Generate with: openssl rand -hex 32
JWT_SECRET=your-64-character-random-string-here-change-this-in-production
JWT_EXPIRES_IN=7d

# ============================================
# URLS
# ============================================
FRONTEND_URL=https://erp.yourcompany.com
VITE_API_URL=https://erp.yourcompany.com/api

# ============================================
# STORAGE (DigitalOcean Spaces)
# ============================================
STORAGE_PROVIDER=spaces

# Get these from DigitalOcean Spaces dashboard
DO_SPACES_ENDPOINT=blr1.digitaloceanspaces.com
DO_SPACES_BUCKET=garment-erp-uploads
DO_SPACES_REGION=blr1
DO_SPACES_KEY=your-spaces-access-key
DO_SPACES_SECRET=your-spaces-secret-key

# CDN URL (enable CDN in Spaces settings)
DO_SPACES_CDN_URL=https://garment-erp-uploads.blr1.cdn.digitaloceanspaces.com

# ============================================
# AI CONFIGURATION
# ============================================
AI_ENABLED=true

# Provider: kimi | anthropic | openai | google | ollama
AI_PROVIDER=kimi

# API Key (from https://platform.moonshot.cn for Kimi)
AI_API_KEY=your-kimi-api-key

# Model (for Kimi: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k)
AI_MODEL=moonshot-v1-32k

# ============================================
# EMBEDDING CONFIGURATION (for RAG)
# ============================================
# Provider: ollama | openai
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# If using Ollama locally on the server
OLLAMA_BASE_URL=http://localhost:11434

# If using OpenAI for embeddings (alternative)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key

# ============================================
# ERROR TRACKING (Optional)
# ============================================
# Get from https://sentry.io
SENTRY_DSN=

# ============================================
# DOCKER PORTS (usually don't change these)
# ============================================
BACKEND_PORT=5000
FRONTEND_PORT=80

# ============================================
# SECURITY CHECKLIST
# ============================================
# Before going live, ensure:
# [ ] JWT_SECRET is a unique random string (64+ chars)
# [ ] DATABASE_URL uses SSL (sslmode=require)
# [ ] All API keys are valid and not expired
# [ ] FRONTEND_URL matches your actual domain
# [ ] Spaces bucket has CDN enabled
# [ ] Firewall only allows ports 22, 80, 443
