  buckle          buckle_master?           @relation("trim_costing_buckle", fields: [buckleId], references: [id])
  belt            belt_master?             @relation("trim_costing_belt", fields: [beltId], references: [id])
  velcro          velcro_master?           @relation("trim_costing_velcro", fields: [velcroId], references: [id])
  drawstring      drawstring_master?       @relation("trim_costing_drawstring", fields: [drawstringId], references: [id])
  ribbon          ribbon_master?           @relation("trim_costing_ribbon", fields: [ribbonId], references: [id])
  sequin          sequin_master?           @relation("trim_costing_sequin", fields: [sequinId], references: [id])
