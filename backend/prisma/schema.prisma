// ============================================
// QUALITY INSPECTION (Manufacturing)
// ============================================

/// Quality Inspection for Manufacturing - Inline/Midline/Final QC
model quality_inspections_mfg {
  id               String  @id @default(uuid())
  inspectionNumber String  @unique // INL/MID/FQC-{WO#}-{Seq}
  workOrderId      String
  finishingIssueId String?

  inspectionType String // INLINE, MIDLINE, FINAL_QC
  inspectionDate DateTime
  inspectorId    String

  stage      String? // For inline - which operation
  sampleSize Int
  passQty    Int
  failQty    Int

  defectNotes    String?          @db.Text
  actionTaken    String?          @db.Text
  status         InspectionStatus
  reworkRequired Int?             @default(0)

  approvedById String?

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workOrder      work_orders       @relation(fields: [workOrderId], references: [id])
  finishingIssue finishing_issues? @relation(fields: [finishingIssueId], references: [id])
  inspector      users             @relation("QCInspector", fields: [inspectorId], references: [id])
  approvedBy     users?            @relation("QCApprover", fields: [approvedById], references: [id])

  @@index([workOrderId])
  @@index([inspectionType])
  @@index([inspectionDate])
}

// ============================================
// PACKING
// ============================================

/// Polybag Entry - Polybag packing tracking
model polybag_entries {
  id               String   @id @default(uuid())
  finishingIssueId String
  componentId      String?
  packingDate      DateTime

  totalPolybags Int
  remarks       String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  finishingIssue finishing_issues  @relation(fields: [finishingIssueId], references: [id])
  component      style_components? @relation(fields: [componentId], references: [id])
  createdBy      users             @relation(fields: [createdById], references: [id])
  skuBreakdown   polybag_skus[]

  @@index([finishingIssueId])
}

/// Polybag SKU - SKU breakdown per polybag entry
model polybag_skus {
  id             String @id @default(uuid())
  polybagEntryId String
  colorId        String
  sizeId         String
  packedQty      Int

  // Relations
  polybagEntry polybag_entries @relation(fields: [polybagEntryId], references: [id], onDelete: Cascade)
  color        color_options   @relation(fields: [colorId], references: [id])
  size         size_options    @relation(fields: [sizeId], references: [id])

  @@unique([polybagEntryId, colorId, sizeId])
  @@index([polybagEntryId])
}

/// Carton Packing - Carton-wise packing
model carton_packings {
  id               String  @id @default(uuid())
  cartonNumber     String  @unique // CTN-{WO#}-{Seq}
  workOrderId      String
  finishingIssueId String?
  componentId      String?

  cartonDate   DateTime
  packingType  PackingType // SOLID or ASSORTED
  pcsPerCarton Int

  // Optional Details
  cartonDimensions String? // L x W x H
  grossWeight      Decimal? @db.Decimal(10, 2)
  netWeight        Decimal? @db.Decimal(10, 2)

  status String @default("PACKED") // PACKED, DISPATCHED

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workOrder      work_orders        @relation(fields: [workOrderId], references: [id])
  finishingIssue finishing_issues?  @relation(fields: [finishingIssueId], references: [id])
  component      style_components?  @relation(fields: [componentId], references: [id])
  createdBy      users              @relation(fields: [createdById], references: [id])
  skuBreakdown   carton_skus[]
  dispatchItems  dispatch_cartons[]

  @@index([workOrderId])
  @@index([finishingIssueId])
  @@index([status])
}

/// Carton SKU - SKU breakdown per carton
model carton_skus {
  id       String @id @default(uuid())
  cartonId String
  colorId  String
  sizeId   String
  quantity Int

  // Relations
  carton carton_packings @relation(fields: [cartonId], references: [id], onDelete: Cascade)
  color  color_options   @relation(fields: [colorId], references: [id])
  size   size_options    @relation(fields: [sizeId], references: [id])

  @@unique([cartonId, colorId, sizeId])
  @@index([cartonId])
}

// ============================================
// PRINTING & DYEING (Job Work)
// ============================================

/// Lab Dip - Lab dip tracking for printing/dyeing
model lab_dips {
  id           String @id @default(uuid())
  labDipNumber String @unique // LD-{Type}-{Style}-{Seq}
  processType  String // PRINTING or DYEING

  styleId  String
  fabricId String

  // For Printing
  designArtwork  String? // File reference
  printMethod    PrintMethod?
  printChemistry PrintChemistry?

  // For Dyeing
  targetColorId  String?
  colorReference String? // Pantone code

  millId String // Supplier

  submissionDate DateTime
  expectedDate   DateTime?
  receivedDate   DateTime?

  status LabDipStatus @default(PENDING)

  // Approval
  approvedById     String?
  approvalDate     DateTime?
  approvedSampleNo String?
  rejectionReason  String?   @db.Text
  colorMatchRating String? // Excellent, Good, Acceptable (for dyeing)

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  style         styles            @relation(fields: [styleId], references: [id])
  fabric        fabric_master     @relation(fields: [fabricId], references: [id])
  targetColor   color_master?     @relation(fields: [targetColorId], references: [id])
  mill          suppliers         @relation("LabDipMill", fields: [millId], references: [id])
  approvedBy    users?            @relation("LabDipApprover", fields: [approvedById], references: [id])
  createdBy     users             @relation("LabDipCreator", fields: [createdById], references: [id])
  jobWorkOrders job_work_orders[]

  @@index([styleId])
  @@index([processType])
  @@index([status])
}

/// Job Work Order - Print/Dye job work tracking
model job_work_orders {
  id            String @id @default(uuid())
  jobWorkNumber String @unique // PJ/DJ-{Style}-{Seq}
  processType   String // PRINTING or DYEING

  labDipId String
  styleId  String
  fabricId String
  millId   String

  // Fabric Sent
  fabricStockLotId String
  fabricType       String // GREIGE, RFD, DYED, FINISHED
  reprocessReason  String? @db.Text // If reprocessing

  qtySentMeters   Decimal   @db.Decimal(10, 2)
  sentWidthInches Decimal   @db.Decimal(10, 2)
  sentDate        DateTime?
  challanNumber   String?
  vehicleNumber   String?

  expectedReturnDate DateTime?
  expectedShrinkage  Decimal?  @db.Decimal(5, 2)
  agreedRatePerMeter Decimal   @db.Decimal(10, 2)

  // Receipt
  qtyReceivedMeters   Decimal?  @db.Decimal(10, 2)
  receivedWidthInches Decimal?  @db.Decimal(10, 2)
  receivedDate        DateTime?
  receivedChallan     String?
  invoiceNumber       String?

  // Calculated
  actualShrinkage Decimal? @db.Decimal(5, 2)
  widthVariance   Decimal? @db.Decimal(10, 2)

  // Quality
  qualityGrade     String? // A, B, Reject
  colorMatchStatus String? // Match, Slight Variation, Mismatch
  defectMeters     Decimal? @db.Decimal(10, 2)
  defectType       String?
  actualRate       Decimal? @db.Decimal(10, 2)

  status JobWorkStatus @default(READY_TO_SEND)

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  labDip         lab_dips      @relation(fields: [labDipId], references: [id])
  style          styles        @relation(fields: [styleId], references: [id])
  fabric         fabric_master @relation(fields: [fabricId], references: [id])
  mill           suppliers     @relation("JobWorkMill", fields: [millId], references: [id])
  fabricStockLot fabric_stock  @relation(fields: [fabricStockLotId], references: [id])
  createdBy      users         @relation(fields: [createdById], references: [id])

  @@index([labDipId])
  @@index([styleId])
  @@index([millId])
  @@index([status])
  @@index([processType])
}

// ============================================
// DISPATCH MODULE
// ============================================

/// ASN Application - Advance Shipping Notice
model asn_applications {
  id        String @id @default(uuid())
  asnNumber String @unique // ASN-{Order#}-{Seq}
  orderId   String

  // Planned
  plannedDispatchQty Int
  cartonsPlanned     Int
  requestedShipDate  DateTime
  applicationDate    DateTime @default(now())

  // Approval
  status          ASNStatus @default(PENDING)
  appointmentDate DateTime?
  appointmentTime String?
  buyerRefNumber  String?
  approvedQty     Int?
  rejectionReason String?   @db.Text
  rescheduleDate  DateTime?

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  order         orders               @relation(fields: [orderId], references: [id])
  createdBy     users                @relation(fields: [createdById], references: [id])
  skuBreakdown  asn_skus[]
  deliveryNotes delivery_notes_ext[]

  @@index([orderId])
  @@index([status])
}

/// ASN SKU - SKU breakdown per ASN application
model asn_skus {
  id         String @id @default(uuid())
  asnId      String
  colorId    String
  sizeId     String
  plannedQty Int

  // Relations
  asn   asn_applications @relation(fields: [asnId], references: [id], onDelete: Cascade)
  color color_options    @relation(fields: [colorId], references: [id])
  size  size_options     @relation(fields: [sizeId], references: [id])

  @@unique([asnId, colorId, sizeId])
  @@index([asnId])
}

/// Delivery Notes Extended - Extension of existing delivery_notes
model delivery_notes_ext {
  id              String    @id @default(uuid())
  deliveryNoteId  String    @unique // Links to existing delivery_notes.id
  asnId           String?
  appointmentDate DateTime?
  shipFrom        String?
  billingAddress  String?
  totalCartons    Int?
  totalPieces     Int?

  // Relations
  deliveryNote delivery_notes       @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  asn          asn_applications?    @relation(fields: [asnId], references: [id])
  cartons      dispatch_cartons[]
  documents    dispatch_documents[]
  transport    dispatch_transports?
  pod          dispatch_pods?

  @@index([deliveryNoteId])
  @@index([asnId])
}

/// Dispatch Carton - Cartons included in dispatch
model dispatch_cartons {
  id                String @id @default(uuid())
  deliveryNoteExtId String
  cartonId          String

  // Relations
  deliveryNoteExt delivery_notes_ext @relation(fields: [deliveryNoteExtId], references: [id], onDelete: Cascade)
  carton          carton_packings    @relation(fields: [cartonId], references: [id])

  @@unique([deliveryNoteExtId, cartonId])
  @@index([deliveryNoteExtId])
}

/// Dispatch Document - Documents for dispatch
model dispatch_documents {
  id                String   @id @default(uuid())
  deliveryNoteExtId String
  documentType      String // CHALLAN, PACKING_LIST, INVOICE, EWAY_BILL
  documentNumber    String
  documentDate      DateTime

  // E-way Bill specific
  validUntil    DateTime?
  distanceKm    Int?
  transportMode String? // Road, Rail, Air, Ship
  vehicleType   String? // Regular, ODC

  // Invoice specific
  subtotal   Decimal? @db.Decimal(12, 2)
  cgst       Decimal? @db.Decimal(10, 2)
  sgst       Decimal? @db.Decimal(10, 2)
  igst       Decimal? @db.Decimal(10, 2)
  grandTotal Decimal? @db.Decimal(12, 2)

  documentUrl String? // File storage reference
  status      String  @default("GENERATED") // GENERATED, CANCELLED, EXPIRED

  // Audit
  createdById String
  createdAt   DateTime @default(now())

  // Relations
  deliveryNoteExt delivery_notes_ext @relation(fields: [deliveryNoteExtId], references: [id], onDelete: Cascade)
  createdBy       users              @relation(fields: [createdById], references: [id])

  @@index([deliveryNoteExtId])
  @@index([documentType])
}

/// Dispatch Transport - Transport details
model dispatch_transports {
  id                String @id @default(uuid())
  deliveryNoteExtId String @unique

  transporterName  String
  transporterGstin String?
  vehicleNumber    String
  vehicleType      String? // Truck, Tempo, Container
  driverName       String
  driverPhone      String?
  driverLicense    String?

  lrNumber String?
  lrDate   DateTime?

  freightCharges Decimal? @db.Decimal(10, 2)
  freightPaidBy  String? // Prepaid, To Pay, FOB

  dispatchDate         DateTime?
  expectedDeliveryDate DateTime?

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  deliveryNoteExt delivery_notes_ext @relation(fields: [deliveryNoteExtId], references: [id])
  createdBy       users              @relation(fields: [createdById], references: [id])
}

/// Dispatch POD - Proof of Delivery
model dispatch_pods {
  id                String @id @default(uuid())
  deliveryNoteExtId String @unique

  deliveryDate DateTime
  deliveryTime String?
  receivedBy   String
  designation  String?

  customerSignOff Boolean @default(false)
  podDocumentUrl  String? // Uploaded POD scan

  deliveryStatus  DeliveryConfirmation
  shortageQty     Int?
  rejectionReason String?              @db.Text

  // Customer GRN details (when customer receives goods)
  customerGrnNumber String?
  customerGrnDate   DateTime?

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  deliveryNoteExt delivery_notes_ext @relation(fields: [deliveryNoteExtId], references: [id])
  createdBy       users              @relation(fields: [createdById], references: [id])
}

// ============================================
// TESTING MODULE
// ============================================

/// Testing Labs Master - External testing labs
model testing_labs {
  id                       String   @id @default(uuid())
  labCode                  String   @unique  // "LAB-001"
  labName                  String   // "SGS India Pvt Ltd"
  contactPerson            String?
  contactEmail             String?
  contactPhone             String?
  address                  String?
  city                     String?
  state                    String?
  pincode                  String?

  // SLA Tracking
  averageTurnaroundDays    Int      @default(7)  // Expected turnaround

  // Accreditation
  accreditations           String?  // JSON array: ["NABL", "ISO 17025"]

  // Status
  isActive                 Boolean  @default(true)

  // Audit
  createdById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  createdBy                users                     @relation("LabCreator", fields: [createdById], references: [id])
  fabricTests              fabric_physical_tests[]
  garmentTests             garment_physical_tests[]
  customerDefaults         customers[]

  @@index([labCode])
  @@index([isActive])
}

/// Test Templates - Buyer-specific testing configurations
model test_templates {
  id                       String            @id @default(uuid())
  templateCode             String            @unique  // "FPT-COTTON-BASIC"
  templateName             String            // "Cotton Fabric Standard Testing"
  templateType             TestTemplateType  // FPT or GPT

  // Test Parameters Configuration (JSON)
  requiredParams           Json   // ["gsm", "construction", "count", "shrinkage"]
  optionalParams           Json?  // ["tensileStrength", "tearStrength", "pilling"]
  toleranceRanges          Json?  // {"gsm": {"min": -5, "max": 5, "unit": "%"}}

  // Description
  description              String?
  testingStandards         String?  // "AATCC, ASTM, ISO"

  // Status
  isActive                 Boolean  @default(true)

  // Audit
  createdById              String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  // Relations
  createdBy                users       @relation("TemplateCreator", fields: [createdById], references: [id])
  customersFPT             customers[] @relation("CustomerFPTTemplate")
  customersGPT             customers[] @relation("CustomerGPTTemplate")

  @@index([templateCode])
  @@index([templateType])
  @@index([isActive])
}

/// Fabric Physical Tests - FPT records
model fabric_physical_tests {
  id                       String      @id @default(uuid())
  testNumber               String      @unique  // "FPT-{Style}-{Seq}"

  // Fabric Linkage
  fabricId                 String?     // Link to fabric_master
  fabricProcurementId      String?     // Link to specific procurement batch
  fabricStockLotId         String?     // Link to specific stock lot
  styleId                  String?     // Context: tested for which style
  customerId               String?     // Customer who requires this test

  // Test Sending
  sentToLabDate            DateTime?
  testingLabId             String?
  sampleQuantity           Decimal?    @db.Decimal(10,2)
  batchNumber              String?     // Fabric batch/roll number

  // Expected Parameters (from greige/fabric specs or template)
  expectedGSM              Int?
  expectedConstruction     String?     // "133x72"
  expectedCount            String?     // "40x40"
  toleranceGSM             Decimal?    @db.Decimal(5,2)  // ±5%

  // Test Results - Core Parameters (MANDATORY)
  testReportNumber         String?     // Lab report number
  testResultReceivedDate   DateTime?

  // GSM Test
  testedGSM                Int?
  gsmTestResult            TestResult? @default(PENDING)
  gsmVariance              Decimal?    @db.Decimal(5,2)

  // Construction Test
  testedConstruction       String?
  constructionTestResult   TestResult? @default(PENDING)

  // Count Test
  testedCount              String?
  countTestResult          TestResult? @default(PENDING)

  // Additional Physical Tests (OPTIONAL - can be null)
  tensileStrengthWarp      Decimal?    @db.Decimal(10,2)
  tensileStrengthWeft      Decimal?    @db.Decimal(10,2)
  tearStrengthWarp         Decimal?    @db.Decimal(10,2)
  tearStrengthWeft         Decimal?    @db.Decimal(10,2)
  shrinkageLength          Decimal?    @db.Decimal(5,2)  // %
  shrinkageWidth           Decimal?    @db.Decimal(5,2)  // %
  colorFastness            String?     // Grade (4-5, 3-4, etc.)
  pilling                  String?     // Grade
  spirality                Decimal?    @db.Decimal(5,2)  // % twist

  // Test Report Upload
  testReportUrl            String?     // PDF/image upload

  // Overall Status
  overallTestResult        TestResult  @default(PENDING)
  failureReason            String?     // Why did test fail?
  remarks                  String?

  // Retesting
  isRetest                 Boolean     @default(false)
  originalTestId           String?     // If this is a retest
  retestReason             String?
  retestCount              Int         @default(0)

  // Approval
  approvedById             String?
  approvedDate             DateTime?
  adminOverride            Boolean     @default(false)  // Did admin override FAIL result?
  overrideReason           String?

  // Audit
  createdById              String
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  // Relations
  fabric                   fabric_master?              @relation(fields: [fabricId], references: [id])
  procurement              fabric_procurement?         @relation(fields: [fabricProcurementId], references: [id])
  stockLot                 fabric_stock?               @relation(fields: [fabricStockLotId], references: [id])
  style                    styles?                     @relation(fields: [styleId], references: [id])
  customer                 customers?                  @relation(fields: [customerId], references: [id])
  testingLab               testing_labs?               @relation(fields: [testingLabId], references: [id])
  originalTest             fabric_physical_tests?      @relation("FPTRetests", fields: [originalTestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  retests                  fabric_physical_tests[]     @relation("FPTRetests")
  createdBy                users                       @relation("FPTCreator", fields: [createdById], references: [id])
  approvedBy               users?                      @relation("FPTApprover", fields: [approvedById], references: [id])

  @@index([testNumber])
  @@index([fabricId])
  @@index([fabricProcurementId])
  @@index([fabricStockLotId])
  @@index([styleId])
  @@index([customerId])
  @@index([testingLabId])
  @@index([overallTestResult])
  @@index([sentToLabDate])
  @@index([createdAt])
}

/// Garment Physical Tests - GPT records
model garment_physical_tests {
  id                       String      @id @default(uuid())
  testNumber               String      @unique  // "GPT-{WO#}-{Seq}"

  // Garment Linkage
  workOrderId              String
  styleId                  String
  customerId               String?
  sizeId                   String?     // Which size was tested
  colorId                  String?     // Which color was tested

  // Test Sending
  sentToLabDate            DateTime?
  testingLabId             String?
  sampleQuantity           Int?        // Number of garments sent

  // Test Results - Core (MANDATORY)
  testReportNumber         String?
  testResultReceivedDate   DateTime?

  // Dimensional Stability (Shrinkage after wash) - OPTIONAL
  prewashLength            Decimal?    @db.Decimal(10,2)
  prewashWidth             Decimal?    @db.Decimal(10,2)
  prewashChest             Decimal?    @db.Decimal(10,2)
  postwashLength           Decimal?    @db.Decimal(10,2)
  postwashWidth            Decimal?    @db.Decimal(10,2)
  postwashChest            Decimal?    @db.Decimal(10,2)
  lengthShrinkage          Decimal?    @db.Decimal(5,2)  // % calculated
  widthShrinkage           Decimal?    @db.Decimal(5,2)  // % calculated
  shrinkageTestResult      TestResult? @default(PENDING)

  // Seam Strength - OPTIONAL
  seamStrength             Decimal?    @db.Decimal(10,2)  // in kg or lbs
  seamTestResult           TestResult? @default(PENDING)

  // Color Fastness - OPTIONAL
  colorFastnessWash        String?     // Grade (4-5, 3-4, etc.)
  colorFastnessRub         String?     // Grade
  colorFastnessLight       String?     // Grade
  colorTestResult          TestResult? @default(PENDING)

  // Fabric Tests on Finished Garment - OPTIONAL
  pilling                  String?     // Grade after wash
  spirality                Decimal?    @db.Decimal(5,2)  // % twist
  apparenceAfterWash       String?     // Visual grade

  // Test Report Upload
  testReportUrl            String?

  // Overall Status
  overallTestResult        TestResult  @default(PENDING)
  failureReason            String?
  remarks                  String?

  // Retesting
  isRetest                 Boolean     @default(false)
  originalTestId           String?
  retestReason             String?
  retestCount              Int         @default(0)

  // Internal Approval
  approvedById             String?
  approvedDate             DateTime?
  adminOverride            Boolean     @default(false)
  overrideReason           String?

  // Buyer Approval (CRITICAL FOR SHIPMENT)
  buyerApprovalRequired    Boolean     @default(false)
  buyerApprovedDate        DateTime?
  buyerApprovedBy          String?     // Buyer contact person name
  buyerRemarks             String?

  // Audit
  createdById              String
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  // Relations
  workOrder                work_orders                 @relation(fields: [workOrderId], references: [id])
  style                    styles                      @relation(fields: [styleId], references: [id])
  customer                 customers?                  @relation(fields: [customerId], references: [id])
  size                     size_options?               @relation(fields: [sizeId], references: [id])
  color                    color_options?              @relation(fields: [colorId], references: [id])
  testingLab               testing_labs?               @relation(fields: [testingLabId], references: [id])
  originalTest             garment_physical_tests?     @relation("GPTRetests", fields: [originalTestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  retests                  garment_physical_tests[]    @relation("GPTRetests")
  createdBy                users                       @relation("GPTCreator", fields: [createdById], references: [id])
  approvedBy               users?                      @relation("GPTApprover", fields: [approvedById], references: [id])

  @@index([testNumber])
  @@index([workOrderId])
  @@index([styleId])
  @@index([customerId])
  @@index([testingLabId])
  @@index([overallTestResult])
  @@index([sentToLabDate])
  @@index([createdAt])
}
