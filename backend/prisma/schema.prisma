/// Payment Terms Master - Standardize payment terms
model payment_terms {
  id              String   @id @default(uuid())
  termCode        String   @unique
  termName        String
  description     String?
  daysCount       Int?
  paymentSchedule Json? // For complex payment schedules
  discountPercent Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

