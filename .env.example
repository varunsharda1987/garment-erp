# Kashaya Fabs ERP - Root Environment Variables Template
# This file is for top-level database configuration
# Copy this file to .env and update with your actual values

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string (used by tools like Prisma Studio)
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://username:password@localhost:5432/garment_erp"

# ============================================
# Production Security Checklist
# ============================================
# [ ] Change username and password to strong credentials
# [ ] Use SSL/TLS connection in production (?sslmode=require)
# [ ] Ensure database user has minimal required permissions
# [ ] Configure database firewall rules
# [ ] Setup regular automated backups
# [ ] Enable database audit logging

# ============================================
# Example Production Connection String
# ============================================
# DATABASE_URL="postgresql://prod_user:strong_password@db.example.com:5432/garment_erp?sslmode=require"
