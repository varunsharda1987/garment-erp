generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model audit_logs {
  id         String   @id
  userId     String
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  timestamp  DateTime @default(now())
  users      users    @relation(fields: [userId], references: [id])

  @@index([entityType])
  @@index([timestamp])
  @@index([userId])
}

model bill_of_materials {
  id                                          String      @id @default(uuid())
  styleId                                     String
  version                                     Int         @default(1)
  isActive                                    Boolean     @default(true)
  totalCost                                   Decimal?    @db.Decimal(10, 2)
  createdById                                 String
  approvedById                                String?
  approvedAt                                  DateTime?
  createdAt                                   DateTime    @default(now())
  updatedAt                                   DateTime    @updatedAt
  users_bill_of_materials_approvedByIdTousers users?      @relation("bill_of_materials_approvedByIdTousers", fields: [approvedById], references: [id])
  users_bill_of_materials_createdByIdTousers  users       @relation("bill_of_materials_createdByIdTousers", fields: [createdById], references: [id])
  styles                                      styles      @relation(fields: [styleId], references: [id])
  bom_items                                   bom_items[]

  @@unique([styleId, version])
  @@index([styleId])
}

model bom_items {
  id              String  @id @default(uuid())
  bomId           String
  materialId      String
  quantityPerUnit Decimal @db.Decimal(10, 3)
  unit            Unit
  wastagePercent  Decimal @default(0) @db.Decimal(5, 2)
  costPerUnit     Decimal @db.Decimal(10, 2)
  notes           String?

  // Fabric CAD Integration - Optional reference to specific CAD width
  fabricCADId String? // References fabric_width_cad for fabric materials
  fabricCAD   fabric_width_cad? @relation(fields: [fabricCADId], references: [id])

  // Relations
  bill_of_materials bill_of_materials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  materials         materials         @relation(fields: [materialId], references: [id])

  @@index([bomId])
  @@index([materialId])
  @@index([fabricCADId])
}

model color_options {
  id                   String                 @id
  styleId              String
  colorName            String
  colorCode            String?
  sortOrder            Int                    @default(0)
  isActive             Boolean                @default(true)
  styles               styles                 @relation(fields: [styleId], references: [id], onDelete: Cascade)
  delivery_note_items  delivery_note_items[]
  finished_goods_stock finished_goods_stock[]
  order_item_breakup   order_item_breakup[]
  work_order_breakup   work_order_breakup[]
  style_variants       style_variants[]

  @@index([styleId])
}

model customers {
  id                          String                           @id @default(uuid())
  code                        String                           @unique
  name                        String
  type                        CustomerType
  category                    CustomerCategory
  businessType                BusinessType                     @default(B2B) // B2B or B2C
  market                      MarketType                       @default(DOMESTIC) // International (INT) or Domestic (DOM)
  contactPerson               String?
  email                       String?
  phone                       String?
  billingAddress              String?
  shippingAddress             String?
  gstNumber                   String?
  creditLimit                 Decimal?                         @db.Decimal(10, 2)
  creditDays                  Int?
  paymentTermsId              String?
  currencyCode                String?
  defaultAccessoriesConfig    Json?                            // NEW: Default accessories configuration
  isActive                    Boolean                          @default(true)
  createdById                 String
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  brandNames                  String?
  categories                  String?
  users                       users                            @relation(fields: [createdById], references: [id])
  payment_terms               payment_terms?                   @relation(fields: [paymentTermsId], references: [id])
  currencies                  currencies?                      @relation(fields: [currencyCode], references: [currencyCode])
  delivery_notes              delivery_notes[]
  invoices                    invoices[]
  orders                      orders[]
  quotations                  quotations[]
  samples                     samples[]
  brand_categories            brand_categories[]
  customer_gst_numbers        customer_gst_numbers[]
  customer_accessories_presets customer_accessories_presets[] // NEW: Accessory presets relation

  @@index([code])
  @@index([paymentTermsId])
  @@index([currencyCode])
}

model brand_categories {
  id             String    @id @default(uuid())
  customerId     String
  brandName      String
  category       String
  subCategory    String?
  subSubCategory String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       customers @relation(fields: [customerId], references: [id], onDelete: Cascade)
  styles         styles[]

  @@unique([customerId, brandName, category, subCategory, subSubCategory])
  @@index([customerId])
  @@index([brandName])
}

model customer_gst_numbers {
  id             String    @id @default(uuid())
  customerId     String
  stateName      String
  stateCode      String
  gstNumber      String
  billingAddress String?
  isPrimary      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       customers @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, gstNumber])
  @@index([customerId])
  @@index([gstNumber])
}

model customer_accessories_presets {
  id          String   @id @default(uuid())
  customerId  String
  presetName  String // "Standard", "Premium", "Export"
  description String?

  // Accessory Items Configuration
  // JSON structure: [{materialType: "LABEL", materialId: "uuid", quantity: 1, usageCategory: "PACKAGING"}, ...]
  accessoryItems Json

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer customers @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, presetName])
  @@index([customerId])
  @@index([isDefault])
}

model delivery_note_items {
  id             String          @id
  deliveryNoteId String
  orderItemId    String
  styleId        String
  colorId        String
  sizeId         String
  variantId      String?
  quantity       Int
  cartons        Int?
  remarks        String?
  color_options  color_options   @relation(fields: [colorId], references: [id])
  delivery_notes delivery_notes  @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  order_items    order_items     @relation(fields: [orderItemId], references: [id])
  size_options   size_options    @relation(fields: [sizeId], references: [id])
  styles         styles          @relation(fields: [styleId], references: [id])
  style_variants style_variants? @relation(fields: [variantId], references: [id])

  @@index([deliveryNoteId])
  @@index([orderItemId])
}

model delivery_notes {
  id                  String                @id
  deliveryNumber      String                @unique
  orderId             String
  customerId          String
  deliveryDate        DateTime              @default(now())
  vehicleNumber       String?
  driverName          String?
  driverPhone         String?
  status              DeliveryStatus        @default(PENDING)
  remarks             String?
  createdById         String
  createdAt           DateTime              @default(now())
  delivery_note_items delivery_note_items[]
  users               users                 @relation(fields: [createdById], references: [id])
  customers           customers             @relation(fields: [customerId], references: [id])
  orders              orders                @relation(fields: [orderId], references: [id])

  @@index([deliveryNumber])
  @@index([orderId])
}

model finished_goods_stock {
  id             String          @id
  styleId        String
  colorId        String
  sizeId         String
  variantId      String?
  quantity       Int
  locationId     String
  workOrderId    String?
  receivedDate   DateTime        @default(now())
  lastUpdated    DateTime        @default(now())
  color_options  color_options   @relation(fields: [colorId], references: [id])
  locations      locations       @relation(fields: [locationId], references: [id])
  size_options   size_options    @relation(fields: [sizeId], references: [id])
  styles         styles          @relation(fields: [styleId], references: [id])
  work_orders    work_orders?    @relation(fields: [workOrderId], references: [id])
  style_variants style_variants? @relation(fields: [variantId], references: [id])

  @@unique([styleId, colorId, sizeId, locationId])
  @@index([locationId])
  @@index([styleId])
}

model goods_receiving_notes {
  id                                              String          @id
  grnNumber                                       String          @unique
  poId                                            String
  supplierId                                      String
  receivingDate                                   DateTime        @default(now())
  invoiceNumber                                   String?
  invoiceDate                                     DateTime?
  status                                          GRNStatus       @default(PENDING_QC)
  remarks                                         String?
  receivedById                                    String
  approvedById                                    String?
  createdAt                                       DateTime        @default(now())
  users_goods_receiving_notes_approvedByIdTousers users?          @relation("goods_receiving_notes_approvedByIdTousers", fields: [approvedById], references: [id])
  purchase_orders                                 purchase_orders @relation(fields: [poId], references: [id])
  users_goods_receiving_notes_receivedByIdTousers users           @relation("goods_receiving_notes_receivedByIdTousers", fields: [receivedById], references: [id])
  suppliers                                       suppliers       @relation(fields: [supplierId], references: [id])
  grn_items                                       grn_items[]

  @@index([grnNumber])
  @@index([poId])
}

model grn_items {
  id                    String                @id
  grnId                 String
  poItemId              String
  materialId            String
  orderedQuantity       Decimal               @db.Decimal(10, 3)
  receivedQuantity      Decimal               @db.Decimal(10, 3)
  acceptedQuantity      Decimal               @default(0) @db.Decimal(10, 3)
  rejectedQuantity      Decimal               @default(0) @db.Decimal(10, 3)
  unit                  Unit
  remarks               String?
  goods_receiving_notes goods_receiving_notes @relation(fields: [grnId], references: [id], onDelete: Cascade)
  materials             materials             @relation(fields: [materialId], references: [id])
  purchase_order_items  purchase_order_items  @relation(fields: [poItemId], references: [id])

  @@index([grnId])
  @@index([poItemId])
}

model inventory_stock {
  id          String    @id
  materialId  String
  locationId  String
  quantity    Decimal   @db.Decimal(10, 3)
  unit        Unit
  lastUpdated DateTime  @default(now())
  locations   locations @relation(fields: [locationId], references: [id])
  materials   materials @relation(fields: [materialId], references: [id])

  @@unique([materialId, locationId])
  @@index([locationId])
  @@index([materialId])
}

model invoices {
  id            String        @id
  invoiceNumber String        @unique
  orderId       String
  customerId    String
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(PENDING)
  subtotal      Decimal       @db.Decimal(12, 2)
  taxAmount     Decimal       @db.Decimal(12, 2)
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal       @db.Decimal(12, 2)
  remarks       String?
  createdById   String
  createdAt     DateTime      @default(now())
  users         users         @relation(fields: [createdById], references: [id])
  customers     customers     @relation(fields: [customerId], references: [id])
  orders        orders        @relation(fields: [orderId], references: [id])
  payments      payments[]

  @@index([customerId])
  @@index([invoiceNumber])
  @@index([orderId])
}

model locations {
  id                   String                 @id
  locationCode         String                 @unique
  locationName         String
  locationType         LocationType
  address              String?
  capacity             Int?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  finished_goods_stock finished_goods_stock[]
  inventory_stock      inventory_stock[]
  work_orders          work_orders[]
  cost_centers         cost_centers[]

  @@index([locationCode])
}

model material_categories {
  id               String                @id
  name             String                @unique
  description      String?
  parentCategoryId String?
  level            Int                   @default(1)
  sortOrder        Int                   @default(0)
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  materials        materials[]
  parent           material_categories?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children         material_categories[] @relation("CategoryHierarchy")

  @@index([parentCategoryId])
  @@index([level])
}

model material_requisition_items {
  id                    String                @id
  requisitionId         String
  materialId            String
  requiredQuantity      Decimal               @db.Decimal(10, 3)
  issuedQuantity        Decimal               @default(0) @db.Decimal(10, 3)
  unit                  Unit
  remarks               String?
  materials             materials             @relation(fields: [materialId], references: [id])
  material_requisitions material_requisitions @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([requisitionId])
}

model material_requisitions {
  id                                              String                       @id
  requisitionNumber                               String                       @unique
  workOrderId                                     String
  requisitionDate                                 DateTime                     @default(now())
  issuedById                                      String
  receivedById                                    String?
  status                                          RequisitionStatus            @default(PENDING)
  remarks                                         String?
  createdAt                                       DateTime                     @default(now())
  material_requisition_items                      material_requisition_items[]
  users_material_requisitions_issuedByIdTousers   users                        @relation("material_requisitions_issuedByIdTousers", fields: [issuedById], references: [id])
  users_material_requisitions_receivedByIdTousers users?                       @relation("material_requisitions_receivedByIdTousers", fields: [receivedById], references: [id])
  work_orders                                     work_orders                  @relation(fields: [workOrderId], references: [id])

  @@index([requisitionNumber])
  @@index([workOrderId])
}

model materials {
  id             String   @id
  code           String   @unique
  name           String
  categoryId     String
  description    String?
  specifications String?
  unit           Unit
  reorderLevel   Int?
  image          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  categoryData   Json?

  // Polymorphic Material Type Support
  materialType MaterialType @default(GENERIC)
  greigeId     String? // For GREIGE_FABRIC type
  fabricId     String? // For FINISHED_FABRIC type
  laceId       String? // For LACE type - Phase 1
  buttonId     String? // For BUTTON type - Phase 1
  threadId     String? // For THREAD type - Phase 1
  zipperId     String? // For ZIPPER type - Phase 1B
  elasticId    String? // For ELASTIC type - Phase 1B
  labelId      String? // For LABEL type - Phase 1B
  packagingId  String? // For PACKAGING type - Phase 1B

  // Relations
  bom_items                  bom_items[]
  grn_items                  grn_items[]
  inventory_stock            inventory_stock[]
  material_requisition_items material_requisition_items[]
  material_categories        material_categories          @relation(fields: [categoryId], references: [id])
  purchase_order_items       purchase_order_items[]
  stock_transactions         stock_transactions[]         @relation("stockTransactions")

  // Polymorphic fabric/greige references
  greige_master greige_master? @relation(fields: [greigeId], references: [id])
  fabric_master fabric_master? @relation(fields: [fabricId], references: [id])

  // Phase 1: Material Master References
  lace_master   lace_master?   @relation(fields: [laceId], references: [id])
  button_master button_master? @relation(fields: [buttonId], references: [id])
  thread_master thread_master? @relation(fields: [threadId], references: [id])

  // Phase 1B: Additional Material Master References
  zipper_master    zipper_master?    @relation(fields: [zipperId], references: [id])
  elastic_master   elastic_master?   @relation(fields: [elasticId], references: [id])
  label_master     label_master?     @relation(fields: [labelId], references: [id])
  packaging_master packaging_master? @relation(fields: [packagingId], references: [id])

  // Phase 3: Inventory Management Relations
  stock_levels       stock_levels[]
  stock_movements    stock_movements[]
  stock_reservations stock_reservations[]
  stock_count_items  stock_count_items[]

  // Multi-supplier support
  suppliers material_suppliers[]

  // Phase 2: Style BOM Integration
  style_material_bom style_material_bom[]

  @@index([categoryId])
  @@index([code])
  @@index([materialType])
  @@index([greigeId])
  @@index([fabricId])
  @@index([laceId])
  @@index([buttonId])
  @@index([threadId])
  @@index([zipperId])
  @@index([elasticId])
  @@index([labelId])
  @@index([packagingId])
}

model notifications {
  id               String           @id
  userId           String
  notificationType NotificationType
  title            String
  message          String
  referenceType    String?
  referenceId      String?
  isRead           Boolean          @default(false)
  sentAt           DateTime         @default(now())
  readAt           DateTime?
  users            users            @relation(fields: [userId], references: [id])

  @@index([isRead])
  @@index([userId])
}

model order_item_breakup {
  id             String          @id
  orderItemId    String
  colorId        String
  sizeId         String
  variantId      String?
  quantity       Int
  color_options  color_options   @relation(fields: [colorId], references: [id])
  order_items    order_items     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  size_options   size_options    @relation(fields: [sizeId], references: [id])
  style_variants style_variants? @relation(fields: [variantId], references: [id])

  @@unique([orderItemId, colorId, sizeId])
  @@index([orderItemId])
}

model order_items {
  id                  String                @id
  orderId             String
  styleId             String
  itemDescription     String?
  totalQuantity       Int
  unitPrice           Decimal               @db.Decimal(10, 2)
  totalPrice          Decimal               @db.Decimal(12, 2)
  deliveryDate        DateTime?
  status              OrderStatus           @default(PENDING)
  remarks             String?
  delivery_note_items delivery_note_items[]
  order_item_breakup  order_item_breakup[]
  orders              orders                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  styles              styles                @relation(fields: [styleId], references: [id])
  work_orders         work_orders[]

  @@index([orderId])
  @@index([styleId])
}

model orders {
  id                               String           @id
  orderNumber                      String           @unique
  customerId                       String
  orderDate                        DateTime         @default(now())
  expectedDeliveryDate             DateTime
  status                           OrderStatus      @default(PENDING)
  priority                         Priority         @default(MEDIUM)
  totalQuantity                    Int
  totalAmount                      Decimal          @db.Decimal(12, 2)
  paymentTerms                     String?
  shippingAddress                  String?
  remarks                          String?
  createdById                      String
  approvedById                     String?
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime @updatedAt
  delivery_notes                   delivery_notes[]
  invoices                         invoices[]
  order_items                      order_items[]
  users_orders_approvedByIdTousers users?           @relation("orders_approvedByIdTousers", fields: [approvedById], references: [id])
  users_orders_createdByIdTousers  users            @relation("orders_createdByIdTousers", fields: [createdById], references: [id])
  customers                        customers        @relation(fields: [customerId], references: [id])
  work_orders                      work_orders[]

  // Phase 1B: Procurement & Stock Management Relations
  procurementOrigins fabric_procurement[]      @relation("ProcurementOriginOrder")
  stockOrigins       fabric_stock[]            @relation("StockOriginOrder")
  stockAllocations   fabric_stock_allocation[] @relation("AllocationOrder")

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
}

model payments {
  id              String        @id
  invoiceId       String
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  referenceNumber String?
  remarks         String?
  receivedById    String
  createdAt       DateTime      @default(now())
  invoices        invoices      @relation(fields: [invoiceId], references: [id])
  users           users         @relation(fields: [receivedById], references: [id])

  @@index([invoiceId])
  @@index([paymentDate])
}

model production_plans {
  id           String      @id
  planNumber   String      @unique
  planDate     DateTime    @default(now())
  startDate    DateTime
  endDate      DateTime
  status       OrderStatus @default(PENDING)
  remarks      String?
  createdById  String
  approvedById String?
  createdAt    DateTime    @default(now())

  @@index([planNumber])
}

model production_tracking {
  id                String          @id
  workOrderId       String
  productionStage   ProductionStage
  updateDate        DateTime        @default(now())
  quantityCompleted Int
  remarks           String?
  updatedById       String
  createdAt         DateTime        @default(now())
  users             users           @relation(fields: [updatedById], references: [id])
  work_orders       work_orders     @relation(fields: [workOrderId], references: [id])

  @@index([productionStage])
  @@index([updateDate])
  @@index([workOrderId])
}

model purchase_order_items {
  id               String          @id
  poId             String
  materialId       String
  orderedQuantity  Decimal         @db.Decimal(10, 3)
  receivedQuantity Decimal         @default(0) @db.Decimal(10, 3)
  unit             Unit
  unitPrice        Decimal         @db.Decimal(10, 2)
  totalPrice       Decimal         @db.Decimal(12, 2)
  remarks          String?
  grn_items        grn_items[]
  materials        materials       @relation(fields: [materialId], references: [id])
  purchase_orders  purchase_orders @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([poId])
}

model purchase_orders {
  id                                        String                  @id
  poNumber                                  String                  @unique
  supplierId                                String
  poDate                                    DateTime                @default(now())
  expectedDeliveryDate                      DateTime
  status                                    PurchaseOrderStatus     @default(DRAFT)
  totalAmount                               Decimal?                @db.Decimal(12, 2)
  paymentTerms                              String?
  remarks                                   String?
  createdById                               String
  approvedById                              String?
  createdAt                                 DateTime                @default(now())
  userId                                    String?
  goods_receiving_notes                     goods_receiving_notes[]
  purchase_order_items                      purchase_order_items[]
  users_purchase_orders_approvedByIdTousers users?                  @relation("purchase_orders_approvedByIdTousers", fields: [approvedById], references: [id])
  users_purchase_orders_createdByIdTousers  users                   @relation("purchase_orders_createdByIdTousers", fields: [createdById], references: [id])
  suppliers                                 suppliers               @relation(fields: [supplierId], references: [id])
  users_purchase_orders_userIdTousers       users?                  @relation("purchase_orders_userIdTousers", fields: [userId], references: [id])

  @@index([poNumber])
  @@index([supplierId])
}

model quality_defects {
  id                  String              @id
  inspectionId        String
  defectType          String
  defectDescription   String?
  severity            Severity
  quantity            Int
  image               String?
  actionTaken         String?
  quality_inspections quality_inspections @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@index([inspectionId])
}

model quality_inspections {
  id                                             String            @id
  inspectionNumber                               String            @unique
  inspectionType                                 InspectionType
  workOrderId                                    String?
  styleId                                        String
  inspectionDate                                 DateTime          @default(now())
  inspectedQuantity                              Int
  passedQuantity                                 Int
  failedQuantity                                 Int
  reworkQuantity                                 Int
  status                                         QualityStatus
  remarks                                        String?
  inspectedById                                  String
  approvedById                                   String?
  createdAt                                      DateTime          @default(now())
  userId                                         String?
  quality_defects                                quality_defects[]
  users_quality_inspections_approvedByIdTousers  users?            @relation("quality_inspections_approvedByIdTousers", fields: [approvedById], references: [id])
  users_quality_inspections_inspectedByIdTousers users             @relation("quality_inspections_inspectedByIdTousers", fields: [inspectedById], references: [id])
  styles                                         styles            @relation(fields: [styleId], references: [id])
  users_quality_inspections_userIdTousers        users?            @relation("quality_inspections_userIdTousers", fields: [userId], references: [id])
  work_orders                                    work_orders?      @relation(fields: [workOrderId], references: [id])

  @@index([inspectionNumber])
  @@index([workOrderId])
}

model quotation_items {
  id            String     @id
  quotationId   String
  styleId       String
  description   String?
  totalQuantity Int
  unitPrice     Decimal    @db.Decimal(10, 2)
  totalPrice    Decimal    @db.Decimal(12, 2)
  deliveryDays  Int?
  remarks       String?
  quotations    quotations @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  styles        styles     @relation(fields: [styleId], references: [id])

  @@index([quotationId])
  @@index([styleId])
}

model quotations {
  id                                   String            @id
  quotationNumber                      String            @unique
  customerId                           String
  quotationDate                        DateTime          @default(now())
  validUntil                           DateTime
  status                               QuotationStatus   @default(DRAFT)
  totalAmount                          Decimal?          @db.Decimal(12, 2)
  remarks                              String?
  termsAndConditions                   String?
  createdById                          String
  approvedById                         String?
  createdAt                            DateTime          @default(now())
  updatedAt                            DateTime @updatedAt
  quotation_items                      quotation_items[]
