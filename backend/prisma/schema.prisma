model credit_notes {
  id                 String           @id @default(uuid())
  creditNoteNumber   String           @unique
  invoiceId          String
  customerId         String
  creditNoteDate     DateTime         @default(now())
  reason             CreditNoteReason
  subtotal           Decimal          @db.Decimal(12, 2)
  cgstAmount         Decimal          @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal          @default(0) @db.Decimal(12, 2)
  igstAmount         Decimal          @default(0) @db.Decimal(12, 2)
  totalTax           Decimal          @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal          @db.Decimal(12, 2)
  isInterstate       Boolean          @default(false)
  status             DocumentStatus   @default(DRAFT)
  remarks            String?
  createdById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  // Tally push fields
  tallyPushedAt      DateTime?
  tallyVoucherNumber String?
  tallyLastError     String?          @db.Text

  invoice   invoices            @relation(fields: [invoiceId], references: [id])
  customer  customers           @relation(fields: [customerId], references: [id])
  createdBy users               @relation(fields: [createdById], references: [id])
  items     credit_note_items[]

  @@index([invoiceId])
  @@index([customerId])
  @@index([creditNoteNumber])
  @@index([status])
}

model credit_note_items {
  id            String   @id @default(uuid())
  creditNoteId  String
  invoiceItemId String?
  description   String
  hsnCode       String?
  quantity      Int
  unitPrice     Decimal  @db.Decimal(10, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  gstRate       Decimal? @db.Decimal(5, 2)
  cgstAmount    Decimal? @db.Decimal(12, 2)
  sgstAmount    Decimal? @db.Decimal(12, 2)
  igstAmount    Decimal? @db.Decimal(12, 2)
  taxAmount     Decimal? @db.Decimal(12, 2)

  creditNote credit_notes @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
}

model debit_notes {
  id                 String          @id @default(uuid())
  debitNoteNumber    String          @unique
  poId               String?
  jobWorkOrderId     String? // Phase 4a: debit note raised against a Job Work Order (abnormal loss recovery)
  supplierId         String
  debitNoteDate      DateTime        @default(now())
  reason             DebitNoteReason
  subtotal           Decimal         @db.Decimal(12, 2)
  cgstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  igstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  totalTax           Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal         @db.Decimal(12, 2)
  isInterstate       Boolean         @default(false)
  status             DocumentStatus  @default(DRAFT)
  remarks            String?
  createdById        String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  // Tally push fields
  tallyPushedAt      DateTime?
  tallyVoucherNumber String?
  tallyLastError     String?         @db.Text

  purchaseOrder purchase_orders?   @relation(fields: [poId], references: [id])
  jobWorkOrder  job_work_orders?   @relation("DebitNoteJobWorkOrder", fields: [jobWorkOrderId], references: [id])
  supplier      suppliers          @relation(fields: [supplierId], references: [id])
  createdBy     users              @relation(fields: [createdById], references: [id])
  items         debit_note_items[]

  @@index([poId])
  @@index([jobWorkOrderId])
  @@index([supplierId])
  @@index([debitNoteNumber])
  @@index([status])
}

model debit_note_items {
  id          String   @id @default(uuid())
