// ============================================
// CHALLAN - Material Movement Documents
// ============================================

/// Challan - Tracks material movement (internal & external)
model challans {
  id            String      @id @default(uuid())
  challanNumber String      @unique
  challanType   ChallanType
  challanDate   DateTime    @default(now())

  // Source context
  orderId            String?
  productionRunId    String? // work_orders.id
  purchaseOrderId    String? // Linked PO (for outsourced work)
  fabricProcessingId String? // FK to fabric_processing (greige→processor→fabric tracking)

  // From/To
  fromType String // WAREHOUSE, DEPARTMENT, VENDOR
  fromId   String? // supplierId or department identifier
  fromName String // Display name
  toType   String // WAREHOUSE, DEPARTMENT, VENDOR
  toId     String?
  toName   String

  // Transport
  vehicleNumber String?
  driverName    String?
  driverPhone   String?
  lrNumber      String? // Lorry Receipt number

  // Status
  status ChallanStatus @default(DRAFT)

  // Dates
  issuedDate   DateTime?
  expectedDate DateTime?
  receivedDate DateTime?

  // Quantities (summary)
  totalItems       Int      @default(0)
  totalQuantity    Decimal  @db.Decimal(12, 3)
  receivedQuantity Decimal? @db.Decimal(12, 3)
  unit             String   @default("PCS")

  // Audit
  remarks      String?
  issuedById   String
  receivedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  order                orders?               @relation(fields: [orderId], references: [id])
  productionRun        work_orders?          @relation(fields: [productionRunId], references: [id])
  purchaseOrder        purchase_orders?      @relation(fields: [purchaseOrderId], references: [id])
  fabricProcessing     fabric_processing?    @relation("ChallanProcessing", fields: [fabricProcessingId], references: [id])
  issuedBy             users                 @relation("ChallanIssuedBy", fields: [issuedById], references: [id])
  receivedBy           users?                @relation("ChallanReceivedBy", fields: [receivedById], references: [id])
  items                challan_items[]
  // Back-references from existing models
  jobWorkOutward       job_work_orders[]     @relation("JobWorkOutwardChallan")
  jobWorkInward        job_work_orders[]     @relation("JobWorkInwardChallan")
  processingMovements  processing_movement[]
  processingDeliveries processing_delivery[]

  @@index([orderId])
  @@index([productionRunId])
  @@index([purchaseOrderId])
  @@index([fabricProcessingId])
  @@index([challanType])
  @@index([status])
  @@index([challanDate])
  @@map("challans")
}

/// Challan Items - Individual line items on a challan
model challan_items {
  id        String @id @default(uuid())
  challanId String

  // What is being moved
  itemType    String // FABRIC, TRIM, CUT_PIECE, STITCHED_PIECE, GREIGE, LACE, etc.
  materialId  String? // FK to material_master (for trims)
  fabricId    String? // FK to fabric_master (for fabric)
  description String // Human-readable description

  // Quantities
  quantity    Decimal  @db.Decimal(12, 3)
  receivedQty Decimal? @db.Decimal(12, 3)
  damagedQty  Decimal? @db.Decimal(12, 3)
  unit        String   @default("PCS")

  // SKU detail (for garments)
  colorId String?
  sizeId  String?

  // Rate (if applicable, for reference)
  rate Decimal? @db.Decimal(10, 2)

  // Component & color traceability
  componentName         String? // Garment component (Top, Shirt) — for material movement tracking
  colorName             String? // Dye/processing color — for material movement tracking

  // Stock & MRP traceability
  greigeStockId         String? // FK to greige_stock (for OUTWARD greige challan auto-deduction)
  fabricStockId         String? // FK to fabric_stock (for fabric challan auto-deduction)
  laceStockId           String? // FK to lace_stock (for lace challan auto-deduction)
  materialRequirementId String? // FK to material_requirements (MRP traceability)
  serviceRequirementId  String? // FK to work_order_service_requirements (process/service traceability)

  remarks String?

  challan             challans                         @relation(fields: [challanId], references: [id], onDelete: Cascade)
  greigeStock         greige_stock?                    @relation(fields: [greigeStockId], references: [id])
  fabricStock         fabric_stock?                    @relation(fields: [fabricStockId], references: [id])
  laceStock           lace_stock?                      @relation(fields: [laceStockId], references: [id])
  materialRequirement material_requirements?           @relation(fields: [materialRequirementId], references: [id])
  serviceRequirement  work_order_service_requirements? @relation(fields: [serviceRequirementId], references: [id])

  @@index([challanId])
  @@index([itemType])
  @@index([greigeStockId])
  @@index([fabricStockId])
  @@index([laceStockId])
  @@index([materialRequirementId])
  @@index([serviceRequirementId])
  @@map("challan_items")
}

