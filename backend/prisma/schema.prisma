/// Stores quantity slab definitions (column headers) for each processor
/// Each processor can have different slab ranges for DYEING and PRINTING
model processor_quantity_slabs {
  id             String                @id @default(uuid())
  processorId    String
  processingType String
  slabOrder      Int
  minQuantity    Decimal               @db.Decimal(10, 2)
  maxQuantity    Decimal               @db.Decimal(10, 2)
  slabLabel      String?
  isActive       Boolean               @default(true)
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      users                 @relation("quantity_slab_creator", fields: [createdById], references: [id])
  processor      suppliers             @relation("processor_quantity_slabs", fields: [processorId], references: [id], onDelete: Cascade)
  rateEntries    processor_rate_card[] @relation("rate_card_slab")

  @@unique([processorId, processingType, slabOrder])
  @@index([processorId, processingType])
  @@index([isActive])
}

/// Stores fabric processing rates from dyeing/printing mills
/// Matrix structure: greige (row) x slab (column) = rate
/// For PRINTING: also includes printingType dimension (PIGMENT, PROCIAN, DISCHARGE, PIGMENT_DISCHARGE)
model processor_rate_card {
  id                  String        @id @default(uuid())
  processorId         String
  processingType      String
  ratePerMeter        Decimal       @db.Decimal(10, 2)
  isActive            Boolean       @default(true)
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  greigeId            String?
  slabId              String?
  printingType        PrintingType?
  shrinkagePercent    Decimal?      @db.Decimal(5, 2)
  screenCostPerScreen Decimal?      @db.Decimal(10, 2)
  screenType          String?

  // Lace support (greigeId and laceId are mutually exclusive)
  laceId String? // For lace dyeing rates (greige lace reference)

  // Relations
  createdBy          users                        @relation("processor_rate_card_creator", fields: [createdById], references: [id])
  greige             greige_master?               @relation("greige_rate_cards", fields: [greigeId], references: [id], onDelete: Cascade)
  processor          suppliers                    @relation("processor_rate_cards", fields: [processorId], references: [id], onDelete: Cascade)
  slab               processor_quantity_slabs?    @relation("rate_card_slab", fields: [slabId], references: [id], onDelete: Cascade)
  lace               lace_master?                 @relation("lace_rate_cards", fields: [laceId], references: [id], onDelete: Cascade)
  fabricCostingItems style_costing_fabric_items[] @relation("fabric_costing_rate_card")
  laceCostingItems   style_costing_lace_items[]   @relation("lace_costing_rate_card")
  orderBomItems      order_bom_items[]            @relation("bom_item_rate_card")

  @@unique([processorId, processingType, printingType, greigeId, laceId, slabId], name: "unique_rate_card_v3")
  @@index([processorId, processingType])
  @@index([processorId, processingType, printingType])
  @@index([greigeId])
  @@index([laceId])
  @@index([slabId])
  @@index([isActive])
}

/// Junction table: Greige to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which greige fabrics
model greige_suppliers {
  id          String        @id @default(uuid())
  greigeId    String
  supplierId  String
  isPreferred Boolean       @default(false)
  isActive    Boolean       @default(true)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  greige      greige_master @relation(fields: [greigeId], references: [id], onDelete: Cascade)
  supplier    suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([greigeId, supplierId])
  @@index([greigeId])
  @@index([supplierId])
}

/// Junction table: Fabric to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which finished fabrics
model fabric_suppliers {
  id          String        @id @default(uuid())
  fabricId    String
  supplierId  String
  isPreferred Boolean       @default(false)
  isActive    Boolean       @default(true)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  fabric      fabric_master @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  supplier    suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([fabricId, supplierId])
  @@index([fabricId])
  @@index([supplierId])
}

/// Junction table: Material to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which materials
model material_suppliers {
  id            String    @id @default(uuid())
  materialId    String
  supplierId    String
  isPreferred   Boolean   @default(false)
  isActive      Boolean   @default(true)
  notes         String?
  supplierPrice Decimal?  @db.Decimal(15, 2)
  leadTimeDays  Int?
  moq           Decimal?  @db.Decimal(15, 4)
  moqUnit       String?
  isPrimary     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  material      materials @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier      suppliers @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([materialId, supplierId])
  @@index([materialId])
  @@index([supplierId])
}

