/// NEW: Relational fabric costing (replaces JSON fabricDetails)
/// Provides proper structure for fabric cost breakdown in style costing
model style_costing_fabric_items {
  id          String  @id @default(uuid())
  costingId   String
  fabricId    String
  fabricCADId String?

  // Fabric Details (snapshot at costing time)
  fabricName String
  colorName  String?
  width      Decimal @db.Decimal(10, 2)

  // CAD & Consumption
  cadMeters         Decimal @db.Decimal(10, 4)
  cadWastagePercent Decimal @default(5) @db.Decimal(5, 2)
  effectiveCad      Decimal @db.Decimal(10, 4) // CAD including wastage

  // Pricing
  costPerMeter Decimal @db.Decimal(10, 2)
  totalCost    Decimal @db.Decimal(10, 2) // effectiveCad * costPerMeter

  // Metadata
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  costing   style_costing     @relation(fields: [costingId], references: [id], onDelete: Cascade)
  fabric    fabric_master     @relation(fields: [fabricId], references: [id])
  fabricCAD fabric_width_cad? @relation(fields: [fabricCADId], references: [id])

  @@index([costingId])
  @@index([fabricId])
  @@index([fabricCADId])
}

model style_fabrics {
  id          String @id @default(uuid())
  componentId String

  // Generic fabric name (selected at style creation, before specific fabric_master is chosen)
  genericFabricName String? // e.g., "Voile", "Shentun", "Georgette"

  // Proper fabric reference (populated during CAD planning)
  fabricId    String? // Reference to fabric_master - Optional during migration
  fabricCADId String? // Optional: Specific CAD width override for this component

  // Fabric finish type and CAD grouping
  fabricFinishType FabricFinishType? // DYED, PRINTED, YARN_DYED, RAW
  cadGroupKey      String? // For grouping fabrics during CAD planning (e.g., "Cambric-DYED-63")

  // === EMBROIDERY SUPPORT ===
  hasEmbroidery Boolean            @default(false)
  embroideryId  String?
  embroidery    embroidery_master? @relation(fields: [embroideryId], references: [id])

  // === WIDTH TRACKING (RENAMED: usableWidth → cutableWidth) ===
  cutableWidth Decimal? @map("cutableWidth") @db.Decimal(10, 2) // Cuttable width after all processing (inches)

  // === NEW: CAD PLANNING FIELDS ===
  averagingMode    String?        @default("COMBINED") // COMBINED | SEPARATE
  selectedGreigeId String? // Reference to selected greige for this fabric group
  selectedGreige   greige_master? @relation("style_fabrics_selectedGreige", fields: [selectedGreigeId], references: [id], onDelete: SetNull)

  // === COST TRACKING ===
  fabricCostPerMeter     Decimal? @db.Decimal(10, 2) // From fabric_master or manual entry
  embroideryCostPerMeter Decimal? @db.Decimal(10, 2) // From embroidery_master
  totalCostPerMeter      Decimal? @db.Decimal(10, 2) // Computed: fabric + embroidery

  // === CAD CONTROL ===
  allowCombinedCutting Boolean @default(true) // Can this be combined in marker with other components?

  // DEPRECATED: Keep temporarily for migration, will be removed
  fabricName       String? // DEPRECATED: Use fabric.fabricName instead
  fabricType       String? // DEPRECATED: Use fabric.finishType instead
  fabricColor      String? // DEPRECATED: Use fabric.colorName instead
  fabricGSM        String? // DEPRECATED: Use fabric.actualGSM instead
  cadAverageMeters Decimal? @db.Decimal(10, 3) // DEPRECATED: Use fabricCAD.cadMeters instead
  cadAverageYards  Decimal? @db.Decimal(10, 3) // DEPRECATED: Use fabricCAD.cadYards instead
  supplierName     String? // DEPRECATED: Use fabric.supplier.name instead
  greigeName       String? // DEPRECATED: Use fabric.greige.greigeName instead

  // Component-specific overrides (keep these)
  quantityNeeded Decimal? @db.Decimal(10, 4) // Quantity needed for this component
  unitPrice      Decimal? @db.Decimal(10, 2) // Override price if different from fabric master
  notes          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  style_components style_components  @relation(fields: [componentId], references: [id], onDelete: Cascade)
  fabric           fabric_master?    @relation(fields: [fabricId], references: [id])
  fabricCAD        fabric_width_cad? @relation(fields: [fabricCADId], references: [id])

  @@index([componentId])
  @@index([fabricId])
  @@index([fabricCADId])
  @@index([cadGroupKey])
  @@index([embroideryId])
  @@index([selectedGreigeId])
}

// ============================================================================
// EMBROIDERY MASTER
// ============================================================================
// Stores embroidery designs as master data. Style-specific but transferable.
// Each design defines the stitch pattern, cost, and width impact.

model embroidery_master {
  id             String  @id @default(cuid())
  embroideryCode String  @unique // Auto-generated: EMB-YYYYMM-XXXX
  designName     String
  description    String? @db.Text

  // Design Specifications
  designFile   String? // URL to design file (EMB, DST, etc.)
  designImage  String? // Preview image URL
  stitchCount  Int? // Total stitch count
  threadColors Int? // Number of thread colors used
  repeatWidth  Decimal? @db.Decimal(10, 2) // Pattern repeat width in inches
  repeatHeight Decimal? @db.Decimal(10, 2) // Pattern repeat height in inches

  // Width Impact (RENAMED: usableWidthAfter → cutableWidth, DELETED: minFabricWidth)
  cutableWidth Decimal @map("cutableWidth") @db.Decimal(10, 2) // Cuttable width after embroidery (inches)

  // Costing
  costPerMeter Decimal? @db.Decimal(10, 2) // Embroidery cost per meter of fabric (optional)

  // Supplier
  supplierId   String?
  supplier     suppliers? @relation(fields: [supplierId], references: [id])
  leadTimeDays Int? // Expected lead time in days

  // Origin Tracking
  originalStyleId String? // Style this design was originally created for

  // Metadata
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  style_fabrics            style_fabrics[]
  embroidered_fabric_stock fabric_stock[] // Stock of embroidered fabric
  embroidery_send_outs     embroidery_send_out[] // Send-out records for this design

  @@index([embroideryCode])
  @@index([supplierId])
  @@index([isActive])
}

// ============================================================================
// EMBROIDERY SEND-OUT TRACKING
// ============================================================================
// Tracks fabric sent out for embroidery and received back.
// Creates embroidered fabric stock upon receipt.

model embroidery_send_out {
  id String @id @default(uuid())

  // Source Stock Reference
  sourceFabricStockId String // Plain fabric being sent
  sourceFabricStock   fabric_stock @relation("EmbroiderySourceStock", fields: [sourceFabricStockId], references: [id])

  // Embroidery Design
  embroideryId String
  embroidery   embroidery_master @relation(fields: [embroideryId], references: [id])

  // Supplier (embroidery vendor)
  supplierId String
  supplier   suppliers @relation(fields: [supplierId], references: [id])

  // Quantity Tracking
  quantitySent     Decimal  @db.Decimal(10, 2) // Meters sent
  quantityReceived Decimal? @db.Decimal(10, 2) // Meters received back
  quantityDamaged  Decimal? @db.Decimal(10, 2) // Meters damaged/rejected
  unit             String   @default("meters")

  // Width Tracking (RENAMED: sentWidth → sentFinishedWidth, receivedWidth → receivedCutableWidth)
  sentFinishedWidth    Decimal  @map("sentFinishedWidth") @db.Decimal(10, 2) // Finished width when sent (inches)
  receivedCutableWidth Decimal? @map("receivedCutableWidth") @db.Decimal(10, 2) // Cutable width after embroidery (inches)

  // Dates
  sendDate           DateTime
  expectedReturnDate DateTime?
  actualReturnDate   DateTime?

  // Cost Tracking
  agreedRate    Decimal   @db.Decimal(10, 2) // Agreed embroidery rate per meter
  actualCost    Decimal?  @db.Decimal(10, 2) // Final cost after receipt
  invoiceNumber String?
  invoiceDate   DateTime?

  // Status
  status  String  @default("SENT") // SENT, IN_PROGRESS, RECEIVED, PARTIALLY_RECEIVED, CANCELLED
  remarks String? @db.Text

  // Result Stock (created when received)
  resultFabricStockId String?       @unique // The embroidered fabric stock created
  resultFabricStock   fabric_stock? @relation("EmbroideryResultStock", fields: [resultFabricStockId], references: [id])

  // Style/Order Context
  forStyleId String? // Style this embroidery is for
  forOrderId String? // Order this embroidery is for
  forStyle   styles? @relation("EmbroideryForStyle", fields: [forStyleId], references: [id])
  forOrder   orders? @relation("EmbroideryForOrder", fields: [forOrderId], references: [id])

  // Audit
  createdById String
  createdBy   users    @relation("embroidery_send_out_createdBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sourceFabricStockId])
  @@index([embroideryId])
  @@index([supplierId])
  @@index([status])
  @@index([sendDate])
  @@index([forStyleId])
  @@index([forOrderId])
}

