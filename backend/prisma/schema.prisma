  elasticId     String
  supplierId    String
  isPreferred   Boolean        @default(false)
  isActive      Boolean        @default(true)
  notes         String?
  pricePerMeter Decimal?       @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  elastic       elastic_master @relation(fields: [elasticId], references: [id], onDelete: Cascade)
  supplier      suppliers      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([elasticId, supplierId])
  @@index([elasticId])
  @@index([supplierId])
