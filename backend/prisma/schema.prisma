  batchNumber           String
  materialType          String // GREIGE | FABRIC | LACE
  greigeId              String?
  fabricId              String?
  totalQuantitySent     Decimal  @db.Decimal(10, 2)
  totalQuantityReceived Decimal  @default(0) @db.Decimal(10, 2)
  quantityInProcess     Decimal  @db.Decimal(10, 2)
  quantityInTransit     Decimal  @default(0) @db.Decimal(10, 2)
  quantityRejected      Decimal  @default(0) @db.Decimal(10, 2)
  overallStatus         String   @default("ACTIVE")
  totalCostIncurred     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String
  isActive              Boolean  @default(true)

  // Lace processing support
  laceId                   String? // For lace processing batches
  colorToApply             String? // Target color for lace dyeing
  dyeLotNumber             String? // Assigned dye lot
  shadeNote                String? // Shade description
  finishedLaceId           String? // Created finished lace reference
  expectedShrinkagePercent Decimal? @db.Decimal(5, 2)
  workOrderId              String? // Link to work order

  // Relations
  createdBy           users                             @relation(fields: [createdById], references: [id])
  fabricMaster        fabric_master?                    @relation(fields: [fabricId], references: [id])
  greigeMaster        greige_master?                    @relation(fields: [greigeId], references: [id])
  laceMaster          lace_master?                      @relation("lace_processing_batch", fields: [laceId], references: [id])
  workOrder           work_orders?                      @relation("ProcessingForWorkOrder", fields: [workOrderId], references: [id])
  deliveries          processing_delivery[]
  movements           processing_movement[]
  stages              processing_stage[]
  laceStock           lace_stock[]                      @relation("lace_stock_from_processing")
  serviceRequirements work_order_service_requirements[]

  @@index([batchNumber])
  @@index([overallStatus])
  @@index([greigeId])
  @@index([fabricId])
  @@index([laceId])
  @@index([createdById])
  @@index([workOrderId])
}

/// Processing Stage - Individual processing step in the chain
model processing_stage {
  id                     String                @id @default(uuid())
  batchId                String
  stageNumber            Int
  processorId            String
  processorFacility      String?
  processingType         String
  quantitySent           Decimal               @db.Decimal(10, 2)
  quantityReceived       Decimal               @default(0) @db.Decimal(10, 2)
  quantityInProcess      Decimal               @db.Decimal(10, 2)
  processSpecifications  String?
  expectedOutputSpecs    Json?
  actualOutputSpecs      Json?
  status                 String                @default("PENDING")
  sentDate               DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  processingCost         Decimal               @db.Decimal(10, 2)
  qualityNotes           String?
  reworkReason           String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deliveries             processing_delivery[]
  movements              processing_movement[]
  batch                  processing_batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  processor              suppliers             @relation(fields: [processorId], references: [id])

  @@index([batchId, stageNumber])
  @@index([processorId, status])
  @@index([status])
}

/// Processing Movement - Transit tracking between locations
model processing_movement {
  id                   String            @id @default(uuid())
  batchId              String
  stageId              String?
  movementType         String
  fromLocation         String
  toLocation           String
  quantity             Decimal           @db.Decimal(10, 2)
  status               String            @default("IN_TRANSIT")
  vehicleNumber        String?
  driverName           String?
  lrNumber             String?
  dispatchDate         DateTime
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  challanNumber        String?
  challanId            String? // FK to new challans table
  documents            Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  performedById        String
  batch                processing_batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  performedBy          users             @relation(fields: [performedById], references: [id])
  stage                processing_stage? @relation(fields: [stageId], references: [id])
  challan              challans?         @relation(fields: [challanId], references: [id])

  @@index([status])
  @@index([batchId])
  @@index([stageId])
  @@index([performedById])
  @@index([challanId])
}

/// Processing Delivery - Partial deliveries and quality check
model processing_delivery {
  id                  String           @id @default(uuid())
  batchId             String
  stageId             String
  deliveryNumber      String           @unique
  quantityDelivered   Decimal          @db.Decimal(10, 2)
  quantityAccepted    Decimal          @db.Decimal(10, 2)
  quantityRejected    Decimal          @default(0) @db.Decimal(10, 2)
  qualityStatus       String           @default("PENDING_QC")
  qualityNotes        String?
  rejectionReason     String?
  receivedAtWarehouse String?
  nextStageId         String?
  deliveryDate        DateTime
  qcDate              DateTime?
  acceptanceDate      DateTime?
  invoiceNumber       String?
  challanNumber       String?
  challanId           String? // FK to new challans table
  documents           Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  receivedById        String
  batch               processing_batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  receivedBy          users            @relation(fields: [receivedById], references: [id])
  stage               processing_stage @relation(fields: [stageId], references: [id])
  challan             challans?        @relation(fields: [challanId], references: [id])

  @@index([batchId])
  @@index([stageId])
  @@index([qualityStatus])
  @@index([deliveryNumber])
  @@index([challanId])
  @@index([receivedById])
}

/// Generic Lookup Values Table
/// Stores configurable dropdown options for various fields across the system
/// Categories: LACE_TYPE, BUTTON_TYPE, THREAD_TYPE, ZIPPER_TYPE, ELASTIC_TYPE, etc.
model lookup_values {
  id          String   @id @default(uuid())
  category    String
  code        String
  value       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   users?   @relation(fields: [createdById], references: [id])

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
}

/// Junction table: Lace to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which lace items with pricing
model lace_suppliers {
  id            String      @id @default(uuid())
  laceId        String
  supplierId    String
  isPreferred   Boolean     @default(false)
  isActive      Boolean     @default(true)
  notes         String?
  pricePerMeter Decimal?    @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lace          lace_master @relation(fields: [laceId], references: [id], onDelete: Cascade)
  supplier      suppliers   @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([laceId, supplierId])
  @@index([laceId])
  @@index([supplierId])
}

/// Junction table: Button to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which button items with pricing
model button_suppliers {
  id            String        @id @default(uuid())
  buttonId      String
  supplierId    String
  isPreferred   Boolean       @default(false)
  isActive      Boolean       @default(true)
  notes         String?
  pricePerPiece Decimal?      @db.Decimal(10, 2)
  pricePerGross Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  button        button_master @relation(fields: [buttonId], references: [id], onDelete: Cascade)
  supplier      suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([buttonId, supplierId])
  @@index([buttonId])
  @@index([supplierId])
}

/// Junction table: Zipper to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which zipper items with pricing
model zipper_suppliers {
  id            String        @id @default(uuid())
  zipperId      String
  supplierId    String
  isPreferred   Boolean       @default(false)
  isActive      Boolean       @default(true)
  notes         String?
  pricePerPiece Decimal?      @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  supplier      suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  zipper        zipper_master @relation(fields: [zipperId], references: [id], onDelete: Cascade)

  @@unique([zipperId, supplierId])
  @@index([zipperId])
  @@index([supplierId])
}

/// Junction table: Thread to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which thread items with pricing
model thread_suppliers {
  id           String        @id @default(uuid())
  threadId     String
  supplierId   String
  isPreferred  Boolean       @default(false)
  isActive     Boolean       @default(true)
  notes        String?
  pricePerCone Decimal?      @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  supplier     suppliers     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  thread       thread_master @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, supplierId])
  @@index([threadId])
  @@index([supplierId])
}

/// Junction table: Elastic to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which elastic items with pricing
model elastic_suppliers {
  id            String         @id @default(uuid())
  elasticId     String
  supplierId    String
  isPreferred   Boolean        @default(false)
  isActive      Boolean        @default(true)
  notes         String?
  pricePerMeter Decimal?       @db.Decimal(10, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  elastic       elastic_master @relation(fields: [elasticId], references: [id], onDelete: Cascade)
  supplier      suppliers      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([elasticId, supplierId])
  @@index([elasticId])
  @@index([supplierId])
}

/// Junction table: Label to Suppliers (Many-to-Many)
/// Tracks which suppliers can supply which label items with pricing
model label_suppliers {
  id              String       @id @default(uuid())
  labelId         String
  supplierId      String
  isPreferred     Boolean      @default(false)
  isActive        Boolean      @default(true)
  notes           String?
  pricePerPiece   Decimal?     @db.Decimal(10, 2)
  pricePerHundred Decimal?     @db.Decimal(10, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  label           label_master @relation(fields: [labelId], references: [id], onDelete: Cascade)
  supplier        suppliers    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([labelId, supplierId])
  @@index([labelId])
  @@index([supplierId])
}

/// Sample Measurements - Track measurements for FIT/PP/Size Set samples
model sample_measurements {
  id               String        @id @default(uuid())
  sampleId         String
  sizeId           String?
  measurementPoint String
  specValue        Decimal       @db.Decimal(10, 2)
  actualValue      Decimal?      @db.Decimal(10, 2)
  tolerance        Decimal       @db.Decimal(5, 2)
  status           String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sample           samples       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  size             size_options? @relation(fields: [sizeId], references: [id])

  @@index([sampleId])
}

/// Sample Colorways - For PP samples with multiple colorways
model sample_colorways {
  id        String        @id @default(uuid())
  sampleId  String
  colorId   String
  sizeId    String?
  fabricLot String?
  qtySent   Int           @default(1)
  status    String        @default("PENDING")
  color     color_options @relation(fields: [colorId], references: [id])
  sample    samples       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  size      size_options? @relation(fields: [sizeId], references: [id])

  @@index([sampleId])
}

/// Sample Size Set - For Size Set samples with jumping sizes
model sample_size_sets {
  id       String        @id @default(uuid())
  sampleId String
  sizeId   String
  colorId  String
  qty      Int           @default(1)
  status   String        @default("PENDING")
  color    color_options @relation(fields: [colorId], references: [id])
  sample   samples       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  size     size_options  @relation(fields: [sizeId], references: [id])

  @@unique([sampleId, sizeId, colorId])
  @@index([sampleId])
}

/// Cutting Batch - Track cutting batches per work order
model cutting_batches {
  id                String                  @id @default(uuid())
  batchNumber       String
  workOrderId       String
  componentId       String?
  cuttingDate       DateTime
  fabricStockId     String
  actualFabricWidth Decimal                 @db.Decimal(10, 2)
  cadAverageUsed    Decimal                 @db.Decimal(10, 4)
  cadWidthUsed      Decimal                 @db.Decimal(10, 2)
  layersPerLay      Int
  numberOfLays      Int
  fabricConsumed    Decimal                 @db.Decimal(10, 2)
  cuttingTableId    String?
  cuttingOperatorId String?
  status            CuttingBatchStatus      @default(PENDING)
  actualAverage     Decimal?                @db.Decimal(10, 4)
  varianceFromCad   Decimal?                @db.Decimal(10, 4)
  variancePercent   Decimal?                @db.Decimal(5, 2)
  wastageMeters     Decimal?                @db.Decimal(10, 2)
  wastagePercent    Decimal?                @db.Decimal(5, 2)
  remarks           String?
  createdById       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  isActive          Boolean                 @default(true)
  defects           cutting_batch_defects[]
  lays              cutting_lays[]
  skuOutputs        cutting_batch_skus[]
  component         style_components?       @relation(fields: [componentId], references: [id])
  createdBy         users                   @relation("CuttingBatchCreator", fields: [createdById], references: [id])
  cuttingOperator   users?                  @relation("CuttingOperator", fields: [cuttingOperatorId], references: [id])
  fabricStock       fabric_stock            @relation(fields: [fabricStockId], references: [id])
  workOrder         work_orders             @relation(fields: [workOrderId], references: [id])
  transferSlips     transfer_slips[]
  additionalFabrics cutting_batch_fabrics[]

  @@index([workOrderId])
  @@index([componentId])
  @@index([fabricStockId])
  @@index([status])
  @@index([cuttingDate])
  // Performance: composite index for work order cutting queries
  @@index([workOrderId, status])
}

/// Cutting Batch Fabrics - junction table for multi-fabric batches
model cutting_batch_fabrics {
  id             String                @id @default(uuid())
  batchId        String
  fabricStockId  String
  cadAvgUsed     Decimal?              @db.Decimal(10, 4)
  cadWidthUsed   Decimal?              @db.Decimal(10, 2)
  actualWidth    Decimal?              @db.Decimal(10, 2)
  fabricConsumed Decimal               @default(0) @db.Decimal(10, 2)
  createdAt      DateTime              @default(now())
  batch          cutting_batches       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fabricStock    fabric_stock          @relation(fields: [fabricStockId], references: [id])
  lays           cutting_lays[]        @relation("LegacyLayFabric")
  layFabrics     cutting_lay_fabrics[]

  @@unique([batchId, fabricStockId])
  @@map("cutting_batch_fabrics")
}

/// Cutting Batch SKU - SKU-wise output per cutting batch
model cutting_batch_skus {
  id             String          @id @default(uuid())
  cuttingBatchId String
  colorId        String?
  sizeId         String
  orderQty       Int
  extraAllowed   Int             @default(0)
  maxCuttable    Int
  toCut          Int
  cutQty         Int             @default(0)
  rejectedQty    Int             @default(0)
  goodPcs        Int             @default(0)
  color          color_options?  @relation(fields: [colorId], references: [id])
  cuttingBatch   cutting_batches @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)
  size           size_options    @relation(fields: [sizeId], references: [id])

  @@unique([cuttingBatchId, colorId, sizeId])
  @@index([cuttingBatchId])
}

/// Cutting Batch Defects - Track defects during cutting
model cutting_batch_defects {
  id             String          @id @default(uuid())
  cuttingBatchId String
  colorId        String?
  sizeId         String
  defectType     String
  defectQty      Int
  remarks        String?
  cuttingBatch   cutting_batches @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)

  @@index([cuttingBatchId])
}

/// Cutting Lay - Individual cutting event (lay) within a batch
model cutting_lays {
  id                   String   @id @default(uuid())
  cuttingBatchId       String
  layDate              DateTime
  layNumber            Int
  layerLength          Decimal  @db.Decimal(10, 2)
  numberOfLayers       Int      @default(1)
  totalPieces          Int      @default(0)
  remarks              String?
  createdById          String
  cuttingBatchFabricId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  skuOutputs   cutting_lay_skus[]
  layFabrics   cutting_lay_fabrics[]
  cuttingBatch cutting_batches        @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)
  createdBy    users                  @relation("CuttingLayCreator", fields: [createdById], references: [id])
  batchFabric  cutting_batch_fabrics? @relation("LegacyLayFabric", fields: [cuttingBatchFabricId], references: [id])

  @@index([cuttingBatchId])
  @@index([layDate])
}

/// Cutting Lay Fabrics - Per-fabric layer length within a lay
model cutting_lay_fabrics {
  id                   String                @id @default(uuid())
  cuttingLayId         String
  cuttingBatchFabricId String
  layerLength          Decimal               @db.Decimal(10, 2)
  cuttingLay           cutting_lays          @relation(fields: [cuttingLayId], references: [id], onDelete: Cascade)
  batchFabric          cutting_batch_fabrics @relation(fields: [cuttingBatchFabricId], references: [id])

  @@unique([cuttingLayId, cuttingBatchFabricId])
  @@map("cutting_lay_fabrics")
}

/// Cutting Lay SKU - Per-size pieces in a cutting lay
model cutting_lay_skus {
  id           String  @id @default(uuid())
  cuttingLayId String
  colorId      String?
  sizeId       String
  pieces       Int

  cuttingLay cutting_lays   @relation(fields: [cuttingLayId], references: [id], onDelete: Cascade)
  color      color_options? @relation(fields: [colorId], references: [id])
  size       size_options   @relation(fields: [sizeId], references: [id])

  @@unique([cuttingLayId, colorId, sizeId])
  @@index([cuttingLayId])
}

/// Transfer Slip - Movement between production stages
model transfer_slips {
  id               String               @id @default(uuid())
  slipNumber       String
  workOrderId      String
  componentId      String?
  fromStage        String
  toStage          String
  fromDepartment   String
  toDepartment     String
  transferDate     DateTime             @default(now())
  status           TransferSlipStatus   @default(CREATED)
  cuttingBatchId   String?
  stitchingIssueId String?
  finishingIssueId String?
  totalGoodPieces  Int
  issuedToId       String?
  preparedById     String
  receivedById     String?
  receivedDate     DateTime?
  remarks          String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  isActive         Boolean              @default(true)
  receipts         stage_receipts[]
  skuBreakdown     transfer_slip_skus[]
  component        style_components?    @relation(fields: [componentId], references: [id])
  cuttingBatch     cutting_batches?     @relation(fields: [cuttingBatchId], references: [id])
  issuedTo         suppliers?           @relation("TransferIssuedTo", fields: [issuedToId], references: [id])
  preparedBy       users                @relation("TransferPreparedBy", fields: [preparedById], references: [id])
  receivedBy       users?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  workOrder        work_orders          @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@index([fromStage, toStage])
  @@index([status])
}

/// Transfer Slip SKU - SKU breakdown per transfer slip
model transfer_slip_skus {
  id             String         @id @default(uuid())
  transferSlipId String
  colorId        String?
  sizeId         String
  quantity       Int
  color          color_options? @relation(fields: [colorId], references: [id])
  size           size_options?  @relation(fields: [sizeId], references: [id])
  transferSlip   transfer_slips @relation(fields: [transferSlipId], references: [id], onDelete: Cascade)

  @@unique([transferSlipId, colorId, sizeId])
  @@index([transferSlipId])
}

/// Stage Receipt - Receipt verification at each production stage
model stage_receipts {
  id              String               @id @default(uuid())
  workOrderId     String
  stage           String
  transferSlipId  String
  receivedDate    DateTime
  receivedById    String
  hasDeviation    Boolean              @default(false)
  deviationReason String?
  remarks         String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  skuReceipts     stage_receipt_skus[]
  receivedBy      users                @relation(fields: [receivedById], references: [id])
  transferSlip    transfer_slips       @relation(fields: [transferSlipId], references: [id])
  workOrder       work_orders          @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId, stage])
  @@index([transferSlipId])
}

/// Stage Receipt SKU - SKU verification per receipt
model stage_receipt_skus {
  id             String         @id @default(uuid())
  stageReceiptId String
  colorId        String
  sizeId         String
  expectedQty    Int
  receivedQty    Int
  deviation      Int            @default(0)
  color          color_options  @relation(fields: [colorId], references: [id])
  size           size_options   @relation(fields: [sizeId], references: [id])
  stageReceipt   stage_receipts @relation(fields: [stageReceiptId], references: [id], onDelete: Cascade)

  @@unique([stageReceiptId, colorId, sizeId])
  @@index([stageReceiptId])
}

/// Stitching Issue - Issue to stitching manager
model stitching_issues {
  id                     String                       @id @default(uuid())
  issueNumber            String
  workOrderId            String
  issueDate              DateTime
  managerId              String?
  contractorId           String?
  expectedCompletionDate DateTime?
  status                 StitchingIssueStatus         @default(PENDING_RECEIPT)
  remarks                String?
  startDate              DateTime?
  endDate                DateTime?
  createdById            String
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  isActive               Boolean                      @default(true)
  dailyOutputs           stitching_daily_outputs[]
  components             stitching_issue_components[]
  skuBreakdown           stitching_issue_skus[]
  contractor             suppliers?                   @relation("StitchingContractor", fields: [contractorId], references: [id])
  createdBy              users                        @relation("StitchingIssueCreator", fields: [createdById], references: [id])
  manager                users?                       @relation("StitchingManager", fields: [managerId], references: [id])
  workOrder              work_orders                  @relation(fields: [workOrderId], references: [id])

  @@index([workOrderId])
  @@index([managerId])
  @@index([contractorId])
  @@index([status])
  // Performance: composite index for work order queries
  @@index([workOrderId, status])
}

/// Stitching Issue Component - Components assigned to manager
model stitching_issue_components {
  id               String           @id @default(uuid())
  stitchingIssueId String
  componentId      String
  component        style_components @relation(fields: [componentId], references: [id])
  stitchingIssue   stitching_issues @relation(fields: [stitchingIssueId], references: [id], onDelete: Cascade)

  @@unique([stitchingIssueId, componentId])
}

/// Stitching Issue SKU - SKU breakdown issued to manager
model stitching_issue_skus {
  id               String           @id @default(uuid())
  stitchingIssueId String
  colorId          String?
  sizeId           String
  availableQty     Int
  issuedQty        Int
  color            color_options?   @relation(fields: [colorId], references: [id])
  size             size_options     @relation(fields: [sizeId], references: [id])
  stitchingIssue   stitching_issues @relation(fields: [stitchingIssueId], references: [id], onDelete: Cascade)

  @@unique([stitchingIssueId, colorId, sizeId])
  @@index([stitchingIssueId])
}

/// Stitching Daily Output - Daily production tracking
model stitching_daily_outputs {
  id               String                  @id @default(uuid())
  stitchingIssueId String
  componentId      String?
  outputDate       DateTime
  remarks          String?
  createdById      String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  component        style_components?       @relation(fields: [componentId], references: [id])
  createdBy        users                   @relation(fields: [createdById], references: [id])
  stitchingIssue   stitching_issues        @relation(fields: [stitchingIssueId], references: [id], onDelete: Cascade)
  skuOutputs       stitching_output_skus[]

  @@index([stitchingIssueId])
  @@index([outputDate])
}

/// Stitching Output SKU - SKU breakdown per daily output
model stitching_output_skus {
  id            String                  @id @default(uuid())
  dailyOutputId String
  colorId       String
  sizeId        String
  goodQty       Int                     @default(0)
  defectQty     Int                     @default(0)
  color         color_options           @relation(fields: [colorId], references: [id])
  dailyOutput   stitching_daily_outputs @relation(fields: [dailyOutputId], references: [id], onDelete: Cascade)
  size          size_options            @relation(fields: [sizeId], references: [id])

  @@unique([dailyOutputId, colorId, sizeId])
  @@index([dailyOutputId])
}

/// Finishing Issue - Issue to finishing contractor
model finishing_issues {
  id                     String                       @id @default(uuid())
  issueNumber            String
  workOrderId            String
  issueDate              DateTime
  managerId              String?
  contractorId           String?
  expectedCompletionDate DateTime?
  status                 FinishingStatus              @default(PENDING_RECEIPT)
  remarks                String?
  startDate              DateTime?
  endDate                DateTime?
  createdById            String
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  isActive               Boolean                      @default(true)
  cartons                carton_packings[]
  dailyOutputs           finishing_daily_outputs[]
  components             finishing_issue_components[]
  skuBreakdown           finishing_issue_skus[]
  contractor             suppliers?                   @relation("FinishingContractor", fields: [contractorId], references: [id])
  createdBy              users                        @relation("FinishingIssueCreator", fields: [createdById], references: [id])
  manager                users?                       @relation("FinishingManager", fields: [managerId], references: [id])
  workOrder              work_orders                  @relation(fields: [workOrderId], references: [id])
  polybagEntries         polybag_entries[]
  inspections            quality_inspections_mfg[]

  @@index([workOrderId])
  @@index([managerId])
  @@index([contractorId])
  @@index([status])
  // Performance: composite index for work order queries
