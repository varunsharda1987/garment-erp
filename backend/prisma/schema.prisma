  padding         padding_master?          @relation("trim_costing_padding", fields: [paddingId], references: [id])
  otherFastener   other_fastener_master?   @relation("trim_costing_other_fastener", fields: [otherFastenerId], references: [id])
  otherTape       other_tape_master?       @relation("trim_costing_other_tape", fields: [otherTapeId], references: [id])
  otherDecorative other_decorative_master? @relation("trim_costing_other_decorative", fields: [otherDecorativeId], references: [id])
