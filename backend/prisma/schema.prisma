/// Export Template Master - Configurable export templates for CSV/Excel/PDF
model export_templates {
  id           String   @id @default(uuid())
  moduleName   String
  templateName String
  description  String?
  columnConfig Json
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  users        users    @relation(fields: [createdById], references: [id])

  @@unique([moduleName, templateName])
  @@index([moduleName])
  @@index([createdById])
}

/// Greige Master - Raw, unfinished fabric specifications
/// This represents fabric straight from the loom before any processing
model greige_master {
  id                       String                       @id @default(uuid())
  greigeCode               String                       @unique
  greigeName               String
  yarnCount                String?
  construction             String?
  composition              String
  weaveType                String?
  greigeQuality            GreigeQuality?
  weaver                   String?
  greigeWidth              Decimal                      @db.Decimal(10, 2)
  expectedFinishedWidthMin Decimal?                     @db.Decimal(10, 2)
  expectedFinishedWidthMax Decimal?                     @db.Decimal(10, 2)
  averageShrinkagePercent  Decimal?                     @db.Decimal(5, 2)
  gsmRange                 String?
  /// Hand-set planning rate. Fabric Costing uses it only when there is no purchase and no
  /// priced stock lot, and the PO form pre-fills from it. Deliberately NOT auto-updated:
  /// letting receipts write it would make master -> PO price -> GRN -> master self-reinforcing.
  costPerMeter             Decimal?                     @db.Decimal(10, 2)
  /// Latest greige GRN price, maintained automatically on receipt (see grn.service.ts).
  /// Informational: the costing page already reads the live procurement row directly.
  lastPurchaseRate         Decimal?                     @map("last_purchase_rate") @db.Decimal(10, 2)
  lastPurchaseAt           DateTime?                    @map("last_purchase_at")
  moq                      Int?
  leadTimeDays             Int?
  supplierId               String?
  description              String?
  notes                    String?
  isActive                 Boolean                      @default(true)
  createdById              String
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt
  genericGreigeName        String?
  defaultCutableWidth      Decimal?                     @db.Decimal(10, 2)
  finishedFabrics          fabric_master[]
  fabricProcessing         fabric_processing[]          @relation("ProcessingGreige")
  fabricProcurements       fabric_procurement[]         @relation("ProcurementGreige")
  fabricWidthCads          fabric_width_cad[]           @relation("fabric_width_cad_greige")
  createdBy                users                        @relation("greige_master_createdBy", fields: [createdById], references: [id])
  defaultSupplier          suppliers?                   @relation("greige_default_supplier", fields: [supplierId], references: [id])
  suppliers                greige_suppliers[]
  materials                materials[]
  processing_batch         processing_batch[]
  processorRateCards       processor_rate_card[]        @relation("greige_rate_cards")
  styleFabrics             style_fabrics[]              @relation("style_fabrics_selectedGreige")
  greigeStock              greige_stock[]
  orderBomItems            order_bom_items[]            @relation("bom_item_greige")
  costingFabricItems       style_costing_fabric_items[]
  jwoComponents            job_work_order_components[]

  @@index([supplierId])
  @@index([isActive])
}

/// Greige Stock - Raw greige inventory tracking
/// Stores raw/unfinished greige stock with direct link to greige_master
model greige_stock {
  id       String @id @default(uuid()) @db.VarChar(50)
  greigeId String @db.VarChar(50)

  // Quantity tracking
  quantityAvailable Decimal @db.Decimal(10, 2)
  quantityReserved  Decimal @default(0) @db.Decimal(10, 2)
  quantityConsumed  Decimal @default(0) @db.Decimal(10, 2)
  unit              String  @default("meters") @db.VarChar(20)

  // Dimensions
  greigeWidth  Decimal  @db.Decimal(10, 2)
  cutableWidth Decimal? @db.Decimal(10, 2)

  // Cost
  purchaseCost    Decimal? @db.Decimal(10, 2)
  weightedAvgCost Decimal? @db.Decimal(10, 2)

  // Source tracking
  procurementId   String? @db.VarChar(50)
  supplierId      String? @db.VarChar(50) // Original supplier who SOLD the greige (immutable)
  processorId     String? @db.VarChar(50) // Processor currently holding the stock (set on TRANSFER)
  sourceChallanId String? @db.VarChar(50)
  grnItemId       String? @db.VarChar(50) // P2: Link to GRN item for identity-based reversal
  sourceType      String? @db.VarChar(20) // 'GRN', 'TRANSFER', 'ADJUSTMENT', 'MANUAL'

  // Warehouse
  warehouseLocation String? @db.VarChar(100)
  warehouseId       String? @db.VarChar(50)
  rollNumbers       String? @db.Text
  qualityGrade      String  @default("A") @db.VarChar(10)

  // Dates
  receivedDate     DateTime  @db.Date
  lastConsumedDate DateTime? @db.Date
  agingDays        Int       @default(0)

  // Invoice tracking
  invoiceNumber String?   @db.VarChar(50)
  invoiceDate   DateTime?

  // Fold/Than/Bale tracking (lot-level property)
  foldLengthCm           Decimal? @db.Decimal(5, 2) // "L" - fold length in cm
  thanCount              Int? // Number of thans in this lot
  baleCount              Int? // Number of bales in this lot
  nominalQuantity        Decimal? @db.Decimal(10, 2) // Supplier-measured quantity (before fold adjustment)
  calculatedActualMeters Decimal? @db.Decimal(10, 2) // nominalQuantity × foldLengthCm / 100

  // Status
  status    StockStatus    @default(AVAILABLE)
  stockType StockEntryType @default(GENERIC)

  // Audit
  createdById String   @db.VarChar(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  greige             greige_master               @relation(fields: [greigeId], references: [id])
  procurement        fabric_procurement?         @relation("GreigeStockProcurement", fields: [procurementId], references: [id])
  supplier           suppliers?                  @relation("GreigeStockSupplier", fields: [supplierId], references: [id])
  processor          suppliers?                  @relation("GreigeStockProcessor", fields: [processorId], references: [id])
  sourceChallan      challans?                   @relation("GreigeStockSourceChallan", fields: [sourceChallanId], references: [id])
  warehouse          warehouses?                 @relation("GreigeStockWarehouse", fields: [warehouseId], references: [id])
  createdBy          users                       @relation("greige_stock_createdBy", fields: [createdById], references: [id])
  grnItem            grn_items?                  @relation("GreigeStockGrnItem", fields: [grnItemId], references: [id])
  challanItems       challan_items[]
  jobWorkOrders      job_work_orders[]
  jwoComponentsStock job_work_order_components[] @relation("JWOComponentGreigeStock")
  transactions       greige_stock_transaction[]
  stockDetails       greige_stock_details[]

  @@unique([greigeId, procurementId, greigeWidth, qualityGrade, supplierId, processorId, sourceChallanId])
  @@index([greigeId])
  @@index([warehouseId])
  @@index([status])
  @@index([receivedDate])
  @@index([grnItemId])
}

/// Greige Stock Transaction - Audit trail for greige stock adjustments and consumption
model greige_stock_transaction {
  id              String                          @id @default(uuid()) @db.VarChar(50)
  stockId         String                          @db.VarChar(50)
  transactionType SpecializedStockTransactionType
  quantity        Decimal                         @db.Decimal(12, 4)
  balanceAfter    Decimal                         @db.Decimal(12, 4)
  costPerUnit     Decimal?                        @db.Decimal(12, 4)
  totalValue      Decimal?                        @db.Decimal(12, 4)
  referenceType   TransactionReferenceType?
  referenceId     String?                         @db.VarChar(50)
  notes           String?                         @db.Text
  performedById   String                          @db.VarChar(50)
  transactionDate DateTime                        @default(now())
  createdAt       DateTime                        @default(now())

  stock       greige_stock @relation(fields: [stockId], references: [id])
  performedBy users        @relation("greige_stock_transaction_performedBy", fields: [performedById], references: [id])

  @@index([stockId])
  @@index([transactionType])
  @@index([transactionDate])
}

/// Greige Stock Details - Individual than/bale records within a greige stock lot
/// Preserves granular GRN detail data for bale/than-level issuance tracking
model greige_stock_details {
  id              String  @id @default(uuid()) @db.VarChar(50)
  greigeStockId   String  @db.VarChar(50)
  baleNumber      Int? // Which bale (1, 2, 3...) — null for unbaled thans or roll-wise
  sequenceNo      Int // Order within bale or overall (1, 2, 3...)
  meters          Decimal @db.Decimal(10, 3) // Original meters of this than/roll
  metersRemaining Decimal @db.Decimal(10, 3) // Remaining after partial consumption
  status          String  @default("AVAILABLE") @db.VarChar(20) // AVAILABLE | PARTIAL | CONSUMED
  remarks         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  greigeStock  greige_stock           @relation(fields: [greigeStockId], references: [id], onDelete: Cascade)
  issueDetails greige_issue_details[]

  @@index([greigeStockId])
  @@index([status])
}

/// Greige Issue Details - Tracks which specific thans were issued in each JWO dispatch
/// Links issuance to individual than/bale records for full audit trail
model greige_issue_details {
  id                  String   @id @default(uuid()) @db.VarChar(50)
  greigeStockDetailId String   @db.VarChar(50)
  jobWorkOrderId      String?  @db.VarChar(50) // Which JWO this was issued to
  challanId           String?  @db.VarChar(50) // Which challan for the dispatch
  metersIssued        Decimal  @db.Decimal(10, 3)
  issuedAt            DateTime @default(now())
  issuedById          String?  @db.VarChar(50)

  createdAt DateTime @default(now())

  // Relations
  greigeStockDetail greige_stock_details @relation(fields: [greigeStockDetailId], references: [id], onDelete: Cascade)
  jobWorkOrder      job_work_orders?     @relation("GreigeIssueDetailsJWO", fields: [jobWorkOrderId], references: [id])
  challan           challans?            @relation("GreigeIssueDetailsChallan", fields: [challanId], references: [id])
  issuedBy          users?               @relation("greige_issue_details_issuedBy", fields: [issuedById], references: [id])

  @@index([greigeStockDetailId])
  @@index([jobWorkOrderId])
  @@index([challanId])
}

/// Fabric Master - Finished, ready-to-use fabrics
/// This represents fabric AFTER dyeing, printing, or other finishing processes
model fabric_master {
  id                    String                       @id @default(uuid())
  fabricCode            String                       @unique
  fabricName            String
  greigeId              String?
  greigeName            String?
  genericGreigeName     String?
  colorName             String?
  colorCode             String?
  finishType            FabricFinishType?
  printDesign           String?
  actualWidth           Decimal?                     @db.Decimal(10, 2)
  cutableWidth          Decimal?                     @db.Decimal(10, 2)
  finishedConstruction  String?
  actualGSM             Int?
  valueAddition         String?
  valueAdditionCost     Decimal?                     @db.Decimal(10, 2)
  costPerMeter          Decimal?                     @db.Decimal(10, 2)
  moq                   Int?
  leadTimeDays          Int?
  supplierId            String?
  description           String?
  notes                 String?
  imageUrl              String?
  styleReference        String?
  source                String?
  isGeneric             Boolean                      @default(false)
  isActive              Boolean                      @default(true)
  createdById           String
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  colorMasterId         String?
  composition           String?
  yarnCount             String?
  color_master          color_master?                @relation(fields: [colorMasterId], references: [id])
  createdBy             users                        @relation("fabric_master_createdBy", fields: [createdById], references: [id])
  greige                greige_master?               @relation(fields: [greigeId], references: [id])
  defaultSupplier       suppliers?                   @relation("fabric_default_supplier", fields: [supplierId], references: [id])
  fabric_physical_tests fabric_physical_tests[]
  processingResults     fabric_processing[]          @relation("ProcessingResult")
  fabricProcurements    fabric_procurement[]         @relation("ProcurementFabric")
  processedFromGreige   fabric_procurement[]         @relation("ProcessedFabric")
  fabricStock           fabric_stock[]
  suppliers             fabric_suppliers[]
  widthCADs             fabric_width_cad[]
  job_work_orders       job_work_orders[]
  finishedFromJobWork   job_work_orders[]            @relation("JobWorkFinishedFabric")
  lab_dips              lab_dips[]
  materials             materials[]
  order_bom_items       order_bom_items[]
  processing_batch      processing_batch[]
  qualityInspections    quality_inspection[]
  costingFabricItems    style_costing_fabric_items[]
  styleFabrics          style_fabrics[]
  jwoComponents         job_work_order_components[]  @relation("JWOComponentFabric")

  @@index([greigeId])
  @@index([supplierId])
  @@index([isActive])
  @@index([styleReference])
}

/// Fabric Width CAD - CAD consumption by width
///
/// DUAL PURPOSE TABLE:
/// 1. CAD Planning: Stores width options and CAD consumption per garment (cadMeters, cutableWidth, cadWastagePercent)
/// 2. Fabric Costing: Stores preliminary cost breakdown for style quotations (greigeCostPerMeter, transportCostPerMeter, etc.)
///
/// IMPORTANT NOTES:
/// - The costing fields (lines 3605-3617) are STYLE-SPECIFIC and linked via costingStyleId
/// - These costing fields store preliminary calculations used during style quotations
/// - During order costing, ONLY the CAD dimensions (cadMeters, cutableWidth) are extracted
/// - Actual order costs are recalculated from style_costing based on order-specific quantities
/// - This provides an audit trail of preliminary costing assumptions made for each style
///
/// Centralized repository for CAD averages per fabric width
/// This eliminates duplicate CAD entry for same fabric in different styles
model fabric_width_cad {
  id                          String                       @id @default(uuid())
  fabricId                    String?
  cutableWidth                Decimal                      @map("cutableWidth") @db.Decimal(10, 2)
  widthUnit                   String                       @default("inches")
  cadMeters                   Decimal?                     @db.Decimal(10, 4)
  cadYards                    Decimal?                     @db.Decimal(10, 4)
  cadWastagePercent           Decimal                      @default(0) @db.Decimal(5, 2)
  markerEfficiency            Decimal?                     @db.Decimal(5, 2)
  actualCad                   Decimal?                     @db.Decimal(10, 4)
  cadVariancePercent          Decimal?                     @db.Decimal(5, 2)
  isPreferred                 Boolean                      @default(false)
  supplierAvailability        String?
  priceDifferential           Decimal?                     @db.Decimal(10, 2)
  markerPlanFile              String?
  markerLengthMeters          Decimal?                     @db.Decimal(10, 2)
  piecesPerMarker             Int?
  notes                       String?
  createdById                 String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  layerMarginMeters           Decimal?                     @db.Decimal(10, 4)
  greigeId                    String?
  processingPricePerMeter     Decimal?                     @db.Decimal(10, 2)
  componentName               String?
  costInputMode               String?
  costingStyleId              String?
  greigeCostPerMeter          Decimal?                     @db.Decimal(10, 2)
  numberOfColors              Int?
  processorId                 String?
  screenCostPerMeter          Decimal?                     @db.Decimal(10, 2)
  shrinkageCostPerMeter       Decimal?                     @db.Decimal(10, 2)
  shrinkagePercent            Decimal?                     @db.Decimal(5, 2)
  totalCostPerMeter           Decimal?                     @db.Decimal(10, 2)
  transportCostPerMeter       Decimal?                     @db.Decimal(10, 2)
  screenType                  String?
  printDirection              PrintDirection               @default(TWO_WAY)
  isEmbroidery                Boolean                      @default(false)
  patternPartId               String?                      @map("pattern_part_id")
  purpose                     String?
  styleFabricId               String?                      @map("style_fabric_id")
  approvalNotes               String?                      @map("approval_notes")
  approvalStatus              CadApprovalStatus?           @default(PENDING) @map("approval_status")
  approvedAt                  DateTime?                    @map("approved_at")
  approvedBy                  String?                      @map("approved_by")
  // Two-owner split (2026-08-22): approvalStatus/approvedBy/approvedAt above are CAD-GEOMETRY
  // approval ONLY (how much fabric is needed). The three columns below are the Fabric Costing
  // PRICE approval, writable only via the approve/unapprove endpoints. A row is an approved
  // costing option iff costingApprovalStatus is APPROVED/ALTERNATE_APPROVED (which implies
  // totalCostPerMeter is set). {approvalStatus: APPROVED, cost: null} = CAD-approved, not yet
  // costed — a legitimate state. costingApprovedBy is a bare user id (no relation on purpose).
  costingApprovalStatus       CadApprovalStatus?           @map("costing_approval_status")
  costingApprovedAt           DateTime?                    @map("costing_approved_at")
  costingApprovedBy           String?                      @map("costing_approved_by")
  rejectedAt                  DateTime?                    @map("rejected_at")
  rejectedBy                  String?                      @map("rejected_by")
  autoApprovedFrom            String?                      @map("auto_approved_from")
  fabricStockId               String?                      @map("fabric_stock_id")
  isLocked                    Boolean                      @default(false) @map("is_locked")
  lockedAt                    DateTime?                    @map("locked_at")
  lockedReason                String?                      @map("locked_reason")
  planningCadWidth            Decimal?                     @map("planning_cad_width") @db.Decimal(10, 2)
  procurementId               String?                      @map("procurement_id")
  styleCostingId              String?                      @map("style_costing_id")
  supersededById              String?                      @map("superseded_by_id")
  variancePercent             Decimal?                     @map("variance_percent") @db.Decimal(5, 2)
  version                     Int                          @default(1)
  widthVariance               Decimal?                     @map("width_variance") @db.Decimal(10, 2)
  combinedComponents          String?                      @map("combined_components")
  combinedFabricIds           String?                      @map("combined_fabric_ids")
  isCombinedCutting           Boolean                      @default(false) @map("is_combined_cutting")
  orderQuantityPcs            Int?
  cadAverage                  Decimal?                     @db.Decimal(10, 4)
  clonedFromCadId             String?                      @map("cloned_from_cad_id")
  clonedFromOrderId           String?                      @map("cloned_from_order_id")
  greigeRateManualOverride    Decimal?                     @map("greige_rate_manual_override") @db.Decimal(10, 2)
  greigeRateOverrideReason    String?                      @map("greige_rate_override_reason")
  greigeRateSource            GreigeRateSource?            @map("greige_rate_source")
  greigeRateSourceDate        DateTime?                    @map("greige_rate_source_date")
  purposeEnum                 CadPurpose?                  @map("purpose_enum")
  varianceApprovalNotes       String?                      @map("variance_approval_notes")
  varianceApprovalStatus      VarianceApprovalStatus?      @default(NOT_REQUIRED) @map("variance_approval_status")
  varianceApprovedAt          DateTime?                    @map("variance_approved_at")
  varianceApprovedById        String?                      @map("variance_approved_by")
  processingBatchGroupColorId String?                      @map("processing_batch_group_color_id")
  costingRunId                String?                      @map("costing_run_id")
  copiedFromId                String?                      @map("copied_from_id")
  sizeBreakdowns              cad_size_breakdown[]
  embroideryPartCads          embroidery_part_cad[]        @relation("embroidery_part_cad_width")
  stockAllocations            fabric_stock_allocation[]    @relation("allocation_production_cad")
  approver                    users?                       @relation("cad_approver", fields: [approvedBy], references: [id])
  rejector                    users?                       @relation("cad_rejector", fields: [rejectedBy], references: [id])
  clonedFromCad               fabric_width_cad?            @relation("CADCloneHistory", fields: [clonedFromCadId], references: [id])
  clonedCads                  fabric_width_cad[]           @relation("CADCloneHistory")
  clonedFromOrder             orders?                      @relation("cad_cloned_from_order", fields: [clonedFromOrderId], references: [id])
  copiedFrom                  fabric_width_cad?            @relation("CADCopyLineage", fields: [copiedFromId], references: [id])
  copiedTo                    fabric_width_cad[]           @relation("CADCopyLineage")
  costingStyle                styles?                      @relation("fabric_width_cad_costing_style", fields: [costingStyleId], references: [id])
  createdBy                   users?                       @relation("fabric_width_cad_createdBy", fields: [createdById], references: [id])
  fabric                      fabric_master?               @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  fabricStock                 fabric_stock?                @relation("cad_fabric_stock", fields: [fabricStockId], references: [id])
  greige                      greige_master?               @relation("fabric_width_cad_greige", fields: [greigeId], references: [id])
  patternPart                 pattern_part_master?         @relation("cad_pattern_part", fields: [patternPartId], references: [id])
  cadPatternParts             cad_pattern_parts[]          @relation("cad_multi_parts")
  batchGroupColor             color_master?                @relation("fabric_cad_batch_color", fields: [processingBatchGroupColorId], references: [id])
  processor                   suppliers?                   @relation("fabric_width_cad_processor", fields: [processorId], references: [id])
  // MRP-48d: the processor rate card this CAD row was costed against. Fabric Costing already
  // resolves it (FabricCostingPage lookupRate) and dropped it on save, so the card — which pins
  // BOTH processingType and printingType via its unique key — never reached the cost sheet, the
  // BOM, or MRP. Nullable: unset until a rate is looked up.
  rateCardId                  String?
  rateCard                    processor_rate_card?         @relation("fabric_width_cad_rate_card", fields: [rateCardId], references: [id])
  procurement                 fabric_procurement?          @relation("cad_procurement", fields: [procurementId], references: [id])
  styleCosting                style_costing?               @relation("cad_style_costing", fields: [styleCostingId], references: [id])
  styleFabric                 style_fabrics?               @relation("style_fabric_cad_rows", fields: [styleFabricId], references: [id], onDelete: Cascade)
  supersedes                  fabric_width_cad?            @relation("CADVersionHistory", fields: [supersededById], references: [id])
  supersededBy                fabric_width_cad[]           @relation("CADVersionHistory")
  varianceApprover            users?                       @relation("cad_variance_approver", fields: [varianceApprovedById], references: [id])
  orderBomItems               order_bom_items[]            @relation("order_bom_item_cad")
  order_item_costings         order_item_costing[]         @relation("order_costing_selected_cad")
  order_items                 order_items[]                @relation("order_item_selected_cad")
  costingFabricItems          style_costing_fabric_items[]
  styleFabrics                style_fabrics[]
  costingRun                  fabric_costing_run?          @relation(fields: [costingRunId], references: [id])
  // Purchase orders linked to this CAD (for Manual PO traceability)
  purchaseOrders              purchase_orders[]            @relation("PO_CAD")

  @@unique([costingStyleId, componentName, styleFabricId, cutableWidth, purpose, approvalStatus])
  @@index([fabricId])
  @@index([isPreferred])
  @@index([greigeId])
  @@index([processorId])
  @@index([rateCardId])
  @@index([costingStyleId])
  @@index([patternPartId])
  @@index([purpose])
  @@index([approvalStatus])
  @@index([costingApprovalStatus])
  @@index([isLocked])
  @@index([version])
  @@index([supersededById])
  @@index([fabricStockId])
  @@index([procurementId])
  @@index([styleCostingId])
  @@index([createdById])
  @@index([copiedFromId])
  @@index([approvedBy])
  @@index([styleFabricId])
  @@index([purposeEnum])
  @@index([varianceApprovalStatus])
  @@index([varianceApprovedById])
  @@index([greigeRateSource])
  @@index([clonedFromOrderId])
  @@index([clonedFromCadId])
  @@index([costingRunId])
  // Composite indexes for CAD planning performance
  @@index([styleFabricId, cadMeters])
  @@index([greigeId, isPreferred])
}

model fabric_costing_run {
