  @@index([categoryId])
  @@index([name])
  @@index([isActive])
  @@index([materialType])
  @@index([greigeId])
  @@index([fabricId])
  @@index([laceId])
  @@index([buttonId])
  @@index([threadId])
  @@index([zipperId])
  @@index([elasticId])
  @@index([labelId])
  @@index([packagingId])
  @@index([sizeVariantId])
}

