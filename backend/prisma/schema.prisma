/// Atomic code sequence generator — prevents duplicate document numbers.
/// Each row tracks the last-used sequence for a given prefix (e.g., PO2603, ORD202603).
/// Used with SELECT ... FOR UPDATE to guarantee uniqueness under concurrency.
model code_sequences {
  id        String   @id @default(uuid())
  prefix    String   @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

