  buyerCode     String?
  width         Decimal? @db.Decimal(10, 2)
  design        String?
  color         String?
  composition   String?
  pricePerMeter Decimal? @db.Decimal(10, 2)
  image         String?
  supplierId    String?
  description   String?
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
