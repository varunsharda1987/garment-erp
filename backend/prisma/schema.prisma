/// Style Costing Lace Items - Individual lace items in a cost sheet
/// Supports 3 sourcing strategies: STOCK_REUSE | READY_LACE | GREIGE_PROCESSED
model style_costing_lace_items {
  id        String   @id @default(uuid())
  costingId String
  laceId    String // Links to lace_master (finished lace)
  laceName  String
  colorName String?
  width     Decimal? @db.Decimal(10, 2)

  // Consumption
  quantityPerGarment Decimal @db.Decimal(10, 4) // Meters per garment
  wastagePercent     Decimal @db.Decimal(5, 2)
  effectiveQuantity  Decimal @db.Decimal(10, 4) // With wastage

  // Sourcing Strategy
  sourcingStrategy String @default("READY_LACE") // STOCK_REUSE | READY_LACE | GREIGE_PROCESSED

  // Cost breakdown
  greigeCost     Decimal? @db.Decimal(10, 2) // Raw lace cost per meter
  processingCost Decimal? @db.Decimal(10, 2) // Dyeing cost per meter
  readyLaceCost  Decimal? @db.Decimal(10, 2) // Finished lace cost per meter
  stockCost      Decimal? @db.Decimal(10, 2) // Stock WAC per meter

  costPerMeter Decimal @db.Decimal(10, 2) // Final cost per meter
  totalCost    Decimal @db.Decimal(10, 2) // effectiveQuantity × costPerMeter

  // Source references
  greigeLaceId  String? // If GREIGE_PROCESSED: source greige lace
  processorId   String? // If GREIGE_PROCESSED: dyeing processor
  rateCardId    String? // Processor rate card used
  stockLotId    String? // If STOCK_REUSE: stock lot reference
  procurementId String? // Procurement reference

  // Lab dip tracking (required for GREIGE_PROCESSED)
  labDipId     String? // Lab dip reference
  labDipStatus String? // PENDING | APPROVED | NOT_REQUIRED

  // Override
  isManualOverride Boolean @default(false)
  overrideReason   String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  costing    style_costing        @relation(fields: [costingId], references: [id], onDelete: Cascade)
  lace       lace_master          @relation("costing_lace", fields: [laceId], references: [id])
  greigeLace lace_master?         @relation("costing_greige_lace", fields: [greigeLaceId], references: [id])
  processor  suppliers?           @relation("lace_costing_processor", fields: [processorId], references: [id])
  rateCard   processor_rate_card? @relation("lace_costing_rate_card", fields: [rateCardId], references: [id])
  stockLot   lace_stock?          @relation("lace_costing_stock_lot", fields: [stockLotId], references: [id])
  labDip     lace_lab_dip?        @relation(fields: [labDipId], references: [id])

  @@index([costingId])
  @@index([laceId])
  @@index([greigeLaceId])
  @@index([processorId, rateCardId, stockLotId, sourcingStrategy])
  @@index([sourcingStrategy])
  @@index([labDipId])
}

