// CUTTING MODULE
// ============================================

/// Cutting Batch - Track cutting batches per work order
model cutting_batches {
  id          String  @id @default(uuid())
  batchNumber String  @unique // CB-{WO#}-{Component}-{Seq}
  workOrderId String
  componentId String? // style_components.id (null for single-component styles)

  // Cutting Details
  cuttingDate       DateTime
  fabricStockId     String
  actualFabricWidth Decimal  @db.Decimal(10, 2)
  cadAverageUsed    Decimal  @db.Decimal(10, 4) // meters per garment
  cadWidthUsed      Decimal  @db.Decimal(10, 2) // inches
  layersPerLay      Int
  numberOfLays      Int
  fabricConsumed    Decimal  @db.Decimal(10, 2) // meters

  // Equipment & Staff
  cuttingTableId    String?
  cuttingOperatorId String?

  // Status
  status CuttingBatchStatus @default(PENDING)

  // Calculated Fields (stored for performance)
  actualAverage   Decimal? @db.Decimal(10, 4)
  varianceFromCad Decimal? @db.Decimal(10, 4)
  variancePercent Decimal? @db.Decimal(5, 2)
  wastageMeters   Decimal? @db.Decimal(10, 2)
  wastagePercent  Decimal? @db.Decimal(5, 2)

  remarks String? @db.Text

  // Audit
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  workOrder       work_orders             @relation(fields: [workOrderId], references: [id])
  component       style_components?       @relation(fields: [componentId], references: [id])
  fabricStock     fabric_stock            @relation(fields: [fabricStockId], references: [id])
  cuttingOperator users?                  @relation("CuttingOperator", fields: [cuttingOperatorId], references: [id])
  createdBy       users                   @relation("CuttingBatchCreator", fields: [createdById], references: [id])
  skuOutputs      cutting_batch_skus[]
  defects         cutting_batch_defects[]
  transferSlips   transfer_slips[]

  @@index([workOrderId])
  @@index([componentId])
  @@index([fabricStockId])
  @@index([status])
  @@index([cuttingDate])
}

/// Cutting Batch SKU - SKU-wise output per cutting batch
model cutting_batch_skus {
  id             String @id @default(uuid())
  cuttingBatchId String
  colorId        String
  sizeId         String

  orderQty     Int
  extraAllowed Int @default(0)
  maxCuttable  Int
  toCut        Int
  cutQty       Int @default(0)
  rejectedQty  Int @default(0)
  goodPcs      Int @default(0) // cutQty - rejectedQty

  // Relations
  cuttingBatch cutting_batches @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)
  color        color_options   @relation(fields: [colorId], references: [id])
  size         size_options    @relation(fields: [sizeId], references: [id])

  @@unique([cuttingBatchId, colorId, sizeId])
  @@index([cuttingBatchId])
}

/// Cutting Batch Defects - Track defects during cutting
model cutting_batch_defects {
  id             String  @id @default(uuid())
  cuttingBatchId String
  colorId        String
  sizeId         String
  defectType     String // Shade variation, Fabric defect, Cutting error, etc.
  defectQty      Int
  remarks        String? @db.Text

  // Relations
  cuttingBatch cutting_batches @relation(fields: [cuttingBatchId], references: [id], onDelete: Cascade)

  @@index([cuttingBatchId])
}

// ============================================
// TRANSFER SLIP (Common for all stages)
// ============================================

/// Transfer Slip - Movement between production stages
model transfer_slips {
  id          String  @id @default(uuid())
  slipNumber  String  @unique // TS-{WO#}-{Stage}-{Date}-{Seq}
  workOrderId String
  componentId String?

  fromStage      String // CUTTING, STITCHING, FINISHING
  toStage        String // STITCHING, FINISHING, DISPATCH
  fromDepartment String
  toDepartment   String

  transferDate DateTime           @default(now())
  status       TransferSlipStatus @default(CREATED)

  // Source Reference
  cuttingBatchId   String?
  stitchingIssueId String?
  finishingIssueId String?

  totalGoodPieces Int

  // Handover Details
  preparedById String
  receivedById String?
  receivedDate DateTime?

  remarks String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workOrder    work_orders          @relation(fields: [workOrderId], references: [id])
  component    style_components?    @relation(fields: [componentId], references: [id])
  cuttingBatch cutting_batches?     @relation(fields: [cuttingBatchId], references: [id])
  preparedBy   users                @relation("TransferPreparedBy", fields: [preparedById], references: [id])
  receivedBy   users?               @relation("TransferReceivedBy", fields: [receivedById], references: [id])
  skuBreakdown transfer_slip_skus[]
  receipts     stage_receipts[]

  @@index([workOrderId])
  @@index([fromStage, toStage])
  @@index([status])
}

/// Transfer Slip SKU - SKU breakdown per transfer slip
model transfer_slip_skus {
  id             String @id @default(uuid())
  transferSlipId String
  colorId        String
  sizeId         String
  quantity       Int

  // Relations
  transferSlip transfer_slips @relation(fields: [transferSlipId], references: [id], onDelete: Cascade)
  color        color_options  @relation(fields: [colorId], references: [id])
  size         size_options   @relation(fields: [sizeId], references: [id])

  @@unique([transferSlipId, colorId, sizeId])
  @@index([transferSlipId])
}

// ============================================
// STITCHING MODULE
// ============================================

/// Stage Receipt - Receipt verification at each production stage
model stage_receipts {
  id             String @id @default(uuid())
  workOrderId    String
  stage          String // STITCHING, FINISHING
  transferSlipId String

  receivedDate DateTime
  receivedById String

  // Verification
  hasDeviation    Boolean @default(false)
  deviationReason String? @db.Text

  remarks String? @db.Text

  // Audit
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  workOrder    work_orders          @relation(fields: [workOrderId], references: [id])
  transferSlip transfer_slips       @relation(fields: [transferSlipId], references: [id])
  receivedBy   users                @relation(fields: [receivedById], references: [id])
  skuReceipts  stage_receipt_skus[]

  @@index([workOrderId, stage])
  @@index([transferSlipId])
}

/// Stage Receipt SKU - SKU verification per receipt
model stage_receipt_skus {
  id             String @id @default(uuid())
  stageReceiptId String
  colorId        String
  sizeId         String
  expectedQty    Int
  receivedQty    Int
  deviation      Int    @default(0) // receivedQty - expectedQty

