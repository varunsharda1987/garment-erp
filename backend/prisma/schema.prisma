  markupAmount                            Decimal?                        @default(0) @db.Decimal(10, 2)
  subtotal                                Decimal?                        @default(0) @db.Decimal(15, 2)
  totalProductCost                        Decimal?                        @default(0) @db.Decimal(15, 2)
  // ==========================================
  // Closed Cost - Final agreed price with customer (exclusive of tax)
  // User-entered field, independent of calculated costs
