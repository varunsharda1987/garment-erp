  sgstRate             Decimal?        @db.Decimal(5, 2)
  // E-Invoice fields (eInvoiceStatus state machine: null → GENERATED → CANCELLED)
  eInvoiceIrn          String?
  eInvoiceAckNo        String?
  eInvoiceAckDate      DateTime?
  eInvoiceQrCode       String?         @db.Text
  eInvoiceStatus       String?
  eInvoiceCancelledAt  DateTime?
  eInvoiceCancelReason String?
  eInvoiceLastError    String?         @db.Text
  // E-Way Bill fields
  ewayBillNumber       String?
  ewayBillDate         DateTime?
  ewayBillValidTo      DateTime?
  vehicleNumber        String?
  transporterId        String?
  transporterGstin     String?
  // Supply type
  supplyType           SupplyType?
  // Tally push fields
  tallyPushedAt        DateTime?
  tallyVoucherNumber   String?
