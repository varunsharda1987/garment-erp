/// Fabric Stock Transaction - Complete audit trail of all stock movements
/// Records weighted average cost at time of transaction (Business Rule)
model fabric_stock_transaction {
  id               String                          @id @default(uuid())
  stockId          String
  transactionType  SpecializedStockTransactionType
  quantity         Decimal                         @db.Decimal(10, 2)
  unit             String                          @default("meters")
  referenceType    TransactionReferenceType?
  referenceId      String?
  costPerUnit      Decimal                         @db.Decimal(10, 2)
  weightedAvgCost  Decimal                         @db.Decimal(10, 2)
  totalValue       Decimal                         @db.Decimal(10, 2)
  plannedCad       Decimal?                        @db.Decimal(10, 4)
  actualCad        Decimal?                        @db.Decimal(10, 4)
  piecesProduced   Int?
  qualityGradeFrom String?
  qualityGradeTo   String?
  defectType       String?
  balanceAfter     Decimal                         @db.Decimal(10, 2)
  valueAfter       Decimal                         @db.Decimal(10, 2)
  notes            String?
  createdById      String?
  transactionDate  DateTime                        @default(now())
  createdBy        users?                          @relation("fabric_stock_transaction_createdBy", fields: [createdById], references: [id])
  fabricStock      fabric_stock                    @relation(fields: [stockId], references: [id])

  @@index([stockId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([referenceType, referenceId])
}

/// Quality Inspection - Fabric quality grading with defect tracking
/// Business Rule: Defect fabric value = greige cost
model quality_inspection {
  id                  String              @id @default(uuid())
  inspectionType      String
  fabricProcurementId String?
  fabricStockId       String?
  fabricId            String
  width               Decimal             @db.Decimal(10, 2)
  quantityInspected   Decimal             @db.Decimal(10, 2)
  inspectorId         String
  inspectionDate      DateTime            @default(now())
  defectTypes         String?
  defectPoints        Int                 @default(0)
  defectMeters        Decimal             @default(0) @db.Decimal(10, 2)
  defectPercentage    Decimal             @default(0) @db.Decimal(5, 2)
  qualityGrade        String
  gradeReason         String?
  aGradeQuantity      Decimal             @default(0) @db.Decimal(10, 2)
  bGradeQuantity      Decimal             @default(0) @db.Decimal(10, 2)
  defectQuantity      Decimal             @default(0) @db.Decimal(10, 2)
  aGradeValue         Decimal             @default(0) @db.Decimal(10, 2)
  bGradeValue         Decimal             @default(0) @db.Decimal(10, 2)
  defectValue         Decimal             @default(0) @db.Decimal(10, 2)
  totalLoss           Decimal             @default(0) @db.Decimal(10, 2)
  action              String?
  supplierClaimAmount Decimal?            @db.Decimal(10, 2)
  claimStatus         String?
  inspectionPhotos    String?
  inspectionReportUrl String?
  notes               String?
  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdBy           users               @relation("quality_inspection_createdBy", fields: [createdById], references: [id])
  fabricMaster        fabric_master       @relation(fields: [fabricId], references: [id])
  procurement         fabric_procurement? @relation(fields: [fabricProcurementId], references: [id])
