/// Processing Batch - Parent record for job work tracking
model processing_batch {
  id                    String   @id @default(uuid())
  batchNumber           String
  materialType          String // GREIGE | FABRIC | LACE
  greigeId              String?
  fabricId              String?
  totalQuantitySent     Decimal  @db.Decimal(10, 2)
  totalQuantityReceived Decimal  @default(0) @db.Decimal(10, 2)
  quantityInProcess     Decimal  @db.Decimal(10, 2)
  quantityInTransit     Decimal  @default(0) @db.Decimal(10, 2)
  quantityRejected      Decimal  @default(0) @db.Decimal(10, 2)
  overallStatus         String   @default("ACTIVE")
  totalCostIncurred     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  createdById           String
  isActive              Boolean  @default(true)

  // Lace processing support
  laceId                   String? // For lace processing batches
  colorToApply             String? // Target color for lace dyeing
  dyeLotNumber             String? // Assigned dye lot
  shadeNote                String? // Shade description
  finishedLaceId           String? // Created finished lace reference
  expectedShrinkagePercent Decimal? @db.Decimal(5, 2)
  workOrderId              String? // Link to work order

  // Relations
  createdBy           users                             @relation(fields: [createdById], references: [id])
  fabricMaster        fabric_master?                    @relation(fields: [fabricId], references: [id])
  greigeMaster        greige_master?                    @relation(fields: [greigeId], references: [id])
  laceMaster          lace_master?                      @relation("lace_processing_batch", fields: [laceId], references: [id])
  workOrder           work_orders?                      @relation("ProcessingForWorkOrder", fields: [workOrderId], references: [id])
  deliveries          processing_delivery[]
  movements           processing_movement[]
  stages              processing_stage[]
  laceStock           lace_stock[]                      @relation("lace_stock_from_processing")
  serviceRequirements work_order_service_requirements[]

  @@index([batchNumber])
  @@index([overallStatus])
  @@index([greigeId])
  @@index([fabricId])
  @@index([laceId])
  @@index([createdById])
  @@index([workOrderId])
}

/// Processing Stage - Individual processing step in the chain
model processing_stage {
  id                     String                @id @default(uuid())
  batchId                String
  stageNumber            Int
  processorId            String
  processorFacility      String?
  processingType         String
  quantitySent           Decimal               @db.Decimal(10, 2)
  quantityReceived       Decimal               @default(0) @db.Decimal(10, 2)
  quantityInProcess      Decimal               @db.Decimal(10, 2)
  processSpecifications  String?
  expectedOutputSpecs    Json?
  actualOutputSpecs      Json?
  status                 String                @default("PENDING")
  sentDate               DateTime?
  expectedCompletionDate DateTime?
  actualCompletionDate   DateTime?
  processingCost         Decimal               @db.Decimal(10, 2)
  qualityNotes           String?
  reworkReason           String?
  reworkQuantity         Decimal?              @db.Decimal(10, 2)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deliveries             processing_delivery[]
  movements              processing_movement[]
  batch                  processing_batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  processor              suppliers             @relation(fields: [processorId], references: [id])
  // Phase 5b hook (unwired while batches are frozen): a stage IS a send-out — when
  // multi-stage batches go live, each stage gets its own 1:1 Job Work Order
  jobWorkOrderId         String?               @unique
  jobWorkOrder           job_work_orders?      @relation("ProcessingStageJWO", fields: [jobWorkOrderId], references: [id])

  @@index([batchId, stageNumber])
  @@index([processorId, status])
  @@index([status])
}

/// Processing Movement - Transit tracking between locations
model processing_movement {
  id                   String            @id @default(uuid())
  batchId              String
  stageId              String?
  movementType         String
  fromLocation         String
  toLocation           String
  quantity             Decimal           @db.Decimal(10, 2)
  status               String            @default("IN_TRANSIT")
  vehicleNumber        String?
  driverName           String?
  lrNumber             String?
  dispatchDate         DateTime
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  challanNumber        String?
  challanId            String? // FK to new challans table
  documents            Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  performedById        String
  batch                processing_batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  performedBy          users             @relation(fields: [performedById], references: [id])
  stage                processing_stage? @relation(fields: [stageId], references: [id])
  challan              challans?         @relation(fields: [challanId], references: [id])

  @@index([status])
  @@index([batchId])
  @@index([stageId])
  @@index([performedById])
  @@index([challanId])
}

/// Processing Delivery - Partial deliveries and quality check
model processing_delivery {
  id                  String           @id @default(uuid())
  batchId             String
  stageId             String
  deliveryNumber      String           @unique
  quantityDelivered   Decimal          @db.Decimal(10, 2)
  quantityAccepted    Decimal          @db.Decimal(10, 2)
  quantityRejected    Decimal          @default(0) @db.Decimal(10, 2)
  qualityStatus       String           @default("PENDING_QC")
  qualityNotes        String?
  rejectionReason     String?
  receivedAtWarehouse String?
  nextStageId         String?
  deliveryDate        DateTime
  qcDate              DateTime?
  acceptanceDate      DateTime?
  invoiceNumber       String?
  challanNumber       String?
  challanId           String? // FK to new challans table
  documents           Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  receivedById        String
  batch               processing_batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  receivedBy          users            @relation(fields: [receivedById], references: [id])
  stage               processing_stage @relation(fields: [stageId], references: [id])
  challan             challans?        @relation(fields: [challanId], references: [id])

  @@index([batchId])
  @@index([stageId])
  @@index([qualityStatus])
  @@index([deliveryNumber])
  @@index([challanId])
  @@index([receivedById])
}

/// Generic Lookup Values Table
/// Stores configurable dropdown options for various fields across the system
/// Categories: LACE_TYPE, BUTTON_TYPE, THREAD_TYPE, ZIPPER_TYPE, ELASTIC_TYPE, etc.
model lookup_values {
  id          String   @id @default(uuid())
  category    String
  code        String
  value       String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isSystem    Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   users?   @relation(fields: [createdById], references: [id])

  @@unique([category, value])
  @@index([category])
  @@index([isActive])
}

/// System Settings - Generic key-value configuration store
/// Used for configurable defaults across the system (e.g., wastage percentages)
/// Keys use SCREAMING_SNAKE_CASE convention (e.g., FABRIC_DEFAULT_WASTAGE_PERCENT)
model system_settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  dataType    String   @default("NUMBER") // STRING, NUMBER, BOOLEAN
  category    String   @default("DEFAULTS") // DEFAULTS, GENERAL, COSTING, PRODUCTION
  description String?
  isSystem    Boolean  @default(false) // System settings cannot be deleted
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

/// Junction table: Lace to Suppliers (Many-to-Many)
