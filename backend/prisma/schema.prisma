model lace_master {
  id            String   @id @default(uuid())
  laceCode      String   @unique
  laceName      String
  supplierCode  String?
  buyerCode     String?
  width         Decimal? @db.Decimal(10, 2)
  design        String?
  color         String?
  composition   String?
  image         String?
  description   String?
  isActive      Boolean  @default(true)
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  laceType      String?
  pricePerMeter Decimal? @db.Decimal(10, 2)
  supplierId    String?

  // ==========================================
  // Greige Lace Support
  // isGreige=true: Raw lace needing dyeing
  // isGreige=false: Ready-to-use lace (default)
  // ==========================================
  isGreige                 Boolean  @default(false)
  sourceGreigeLaceId       String? // For finished lace: links to source greige
  expectedShrinkagePercent Decimal? @db.Decimal(5, 2) // Shrinkage during dyeing
  costPerMeterGreige       Decimal? @db.Decimal(10, 2) // Greige cost (if isGreige=true)

  // ==========================================
  // Processed Lace Tracking
  // When greige lace is processed, the finished lace
  // records which style it was processed for
