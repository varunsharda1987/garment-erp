# =============================================================================
# POST-COMMIT HOOK: Auto-rebuild after successful commits
# =============================================================================
# Detects what changed and rebuilds/restarts as needed:
#   - Frontend changes → rebuild, then swap into frontend/dist only if it worked
#   - Backend changes  → rebuild backend/dist + restart PM2 backend (only if it worked)
#
# 2026-08-14 — two bugs fixed here after this hook took the web app down silently:
#
#  1. `npm run build | tail -20; BUILD_EXIT=$?` captured TAIL's exit status, not the
#     build's. tail practically always succeeds, so BUILD_EXIT was ALWAYS 0: the hook
#     printed "✅ rebuilt successfully" after a failed build, and restarted the backend
#     onto a stale dist. `set -o pipefail` makes the pipeline report the build's status.
#
#  2. vite empties the output directory before it writes. A build that failed or was
#     interrupted therefore left frontend/dist containing only the copied public/ assets —
#     every page 404s while PM2 still reports the process healthy, so nothing alerts you.
#     The frontend now builds into dist.staging and is swapped in only after index.html is
#     confirmed present, so a bad build leaves the running app untouched.
# =============================================================================

set -o pipefail

# Poll a URL until it answers, or give up. Deploys here are unattended, so each step
# verifies its own result instead of assuming: a process can be "online" in PM2 while
# serving nothing (empty dist), and the API needs ~20s to bind after a restart.
#   wait_for_http <url> <attempts> <label>   — 3s between attempts
wait_for_http() {
  url="$1"; attempts="$2"; label="$3"
  i=0
  while [ $i -lt "$attempts" ]; do
    code=$(curl -s -o /dev/null -w "%{http_code}" --max-time 5 "$url" 2>/dev/null)
    if [ -n "$code" ] && [ "$code" != "000" ]; then
      return 0
    fi
    i=$((i + 1))
    sleep 3
  done
  echo "   ($label did not respond after $((attempts * 3))s)"
  return 1
}

echo ""
echo "═══════════════════════════════════════════════════"
echo "       POST-COMMIT AUTO-REBUILD                    "
echo "═══════════════════════════════════════════════════"

CHANGED_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD)

FRONTEND_CHANGED=false
BACKEND_CHANGED=false
FAILED=false

echo "$CHANGED_FILES" | grep -q "^frontend/" && FRONTEND_CHANGED=true
echo "$CHANGED_FILES" | grep -q "^backend/" && BACKEND_CHANGED=true

# ---------------------------------------------------------------------------
# Frontend — build to a staging dir, swap only on a verified-good result
# ---------------------------------------------------------------------------
if [ "$FRONTEND_CHANGED" = true ]; then
  echo ""
  echo "📦 Frontend changes detected - rebuilding..."
  cd frontend || exit 1
  rm -rf dist.staging
  npm run build -- --outDir dist.staging --emptyOutDir 2>&1 | tail -20
  BUILD_EXIT=$?

  if [ $BUILD_EXIT -eq 0 ] && [ -f dist.staging/index.html ]; then
    # Swap. The window where dist is absent is milliseconds, versus the ~2 minutes
    # the old in-place build left it empty.
    rm -rf dist && mv dist.staging dist
    echo "✅ Frontend rebuilt and swapped in"
    cd ..
    # Confirm the swap actually serves. The whole point of automating the deploy is
    # that nobody is watching it — so it has to check its own result rather than
    # assume. Today's outage was precisely "web app not serving" going unnoticed.
    if ! wait_for_http "http://localhost:3000/" 5 "web app"; then
      FAILED=true
      echo "❌ Frontend swapped but http://localhost:3000/ is NOT serving — check: pm2 logs garment-erp-web"
    else
      echo "✅ Web app responding"
    fi
    cd frontend || exit 1
  else
    rm -rf dist.staging
    FAILED=true
    echo "❌ Frontend build FAILED (exit $BUILD_EXIT) — the running app was left untouched"
    echo "   Run 'cd frontend && npm run build' to see the errors"
  fi
  cd ..
fi

# ---------------------------------------------------------------------------
# Backend — restart ONLY on a genuinely successful build
# ---------------------------------------------------------------------------
if [ "$BACKEND_CHANGED" = true ]; then
  echo ""
  echo "🔧 Backend changes detected - rebuilding..."
  cd backend || exit 1
  npm run build 2>&1 | tail -10
  BUILD_EXIT=$?
  cd ..

  if [ $BUILD_EXIT -eq 0 ]; then
    echo "✅ Backend rebuilt successfully"
    echo "🔄 Restarting backend service (safe sequence)..."
    # NOT `pm2 restart`: it races PM2's Windows kill and orphans the old fork, which then holds
    # port 5000 while the tracked copy crash-loops on EADDRINUSE. The helper does
    # stop -> wait for port -> kill a verified stale fork -> start -> confirm pid matches PM2.
    node "C:/Users/NEW/ops/pm2-safe-restart.js" garment-erp-api:5000
    if [ $? -eq 0 ]; then
      echo "✅ Backend restarted"
      # The helper asserts the port owner matches PM2, but the API still needs ~20s to
      # finish booting (Ollama provider init) before it answers. Confirm it actually does.
      if wait_for_http "http://localhost:5000/health" 15 "API"; then
        echo "✅ API responding"
      else
        FAILED=true
        echo "❌ Backend restarted but /health is NOT responding — check: pm2 logs garment-erp-api"
      fi
    else
      FAILED=true
      echo "⚠️  Safe restart reported a problem - check: pm2 logs garment-erp-api"
    fi
  else
    FAILED=true
    echo "❌ Backend build FAILED (exit $BUILD_EXIT) — NOT restarting; the running API keeps the last good build"
    echo "   Run 'cd backend && npm run build' to see the errors"
  fi
fi

if [ "$FRONTEND_CHANGED" = false ] && [ "$BACKEND_CHANGED" = false ]; then
  echo "ℹ️  No frontend/backend changes - skipping rebuild"
fi

echo ""
if [ "$FAILED" = true ]; then
  echo "⚠️  BUILD DID NOT FULLY SUCCEED — the deployed app is still on the previous build."
  echo "    Your commit is safe; fix the build and commit again (or rebuild manually)."
fi
echo "═══════════════════════════════════════════════════"
echo ""
