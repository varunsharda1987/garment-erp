  fabricStockLot         fabric_stock                      @relation(fields: [fabricStockLotId], references: [id])
  labDip                 lab_dips                          @relation(fields: [labDipId], references: [id])
  mill                   suppliers                         @relation("JobWorkMill", fields: [millId], references: [id])
  style                  styles                            @relation(fields: [styleId], references: [id])
  workOrder              work_orders?                      @relation("JobWorkForWorkOrder", fields: [workOrderId], references: [id])
  outwardChallan         challans?                         @relation("JobWorkOutwardChallan", fields: [outwardChallanId], references: [id])
  inwardChallan          challans?                         @relation("JobWorkInwardChallan", fields: [inwardChallanId], references: [id])
  purchaseOrder          purchase_orders?                  @relation("JobWorkPurchaseOrder", fields: [purchaseOrderId], references: [id])
  greigeStockLot         greige_stock?                     @relation(fields: [greigeStockLotId], references: [id])
  grn                    goods_receiving_notes?            @relation(fields: [grnId], references: [id])
  serviceRequirements    work_order_service_requirements[]

  @@index([labDipId])
  @@index([styleId])
  @@index([millId])
  @@index([status])
  @@index([processType])
  @@index([workOrderId])
  @@index([outwardChallanId])
  @@index([inwardChallanId])
  @@index([finishedFabricId])
  @@index([purchaseOrderId])
  @@index([greigeStockLotId])
  @@index([grnId])
}

